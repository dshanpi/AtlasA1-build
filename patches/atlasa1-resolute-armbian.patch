+ PVRSRV_ERROR sunxiPostPowerState(IMG_HANDLE hSysData,
+-				 PVRSRV_SYS_POWER_STATE eNewPowerState,
+-				 PVRSRV_SYS_POWER_STATE eCurrentPowerState,
+-				 PVRSRV_POWER_FLAGS ePwrFlags)
