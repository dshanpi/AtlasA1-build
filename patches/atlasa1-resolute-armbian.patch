+-#define SMC_BASE_ADDR        0x0a000000
+-#define SMC_DRM_GPU_HW_RST   0xb0
+-
+-#define GPU_GLB_ADDR         0x01880000
+-#define GPU_DRM_CTRL         0x14
+ PVRSRV_ERROR sunxi_secure_config(IMG_HANDLE hSysData)
+ {
+-
+-	void __iomem *ioaddr;
+-
+-	ioaddr = ioremap(SMC_BASE_ADDR + SMC_DRM_GPU_HW_RST, 4);
+-	writel(0x2, ioaddr);
+-	iounmap(ioaddr);
+-
+-	ioaddr = ioremap(GPU_GLB_ADDR + GPU_DRM_CTRL, 4);
+-
+-	writel(0x0, ioaddr);
+-	iounmap(ioaddr);
+-
++	/* Retain donor's non-secure GPU access configuration; no PPU/CCU writes. */
++	void __iomem *smc = ioremap(0x0a0000b0, 4);
++	void __iomem *gpu = ioremap(0x01880014, 4);
++
++	if (!smc || !gpu) {
++		if (smc)
++			iounmap(smc);
++		if (gpu)
++			iounmap(gpu);
++		return PVRSRV_ERROR_OUT_OF_MEMORY;
++	}
++	writel(0x2, smc);
++	writel(0x0, gpu);
++	iounmap(gpu);
++	iounmap(smc);
+ 	return PVRSRV_OK;
+ }
