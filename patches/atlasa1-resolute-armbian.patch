++	size_t copied;
++	u32 flags = CMD_START | cmd->opcode, value, status = 0, dma_status = 0;
++	unsigned int bytes = 0;
++	unsigned long deadline;
++	bool write = data && (data->flags & MMC_DATA_WRITE);
++	bool auto_stop = data && data->stop;
