++		    (cmd->opcode == MMC_SEND_TUNING_BLOCK_HS200 || cmd->opcode == MMC_SEND_EXT_CSD) &&
++		    t736_tuning_idst_invalid(dma_status)) {
++			ret = -EIO;
++			break;
++		}
