++	    mmc->ios.timing != MMC_TIMING_MMC_HS200 ||
++	    mmc->ios.bus_width != MMC_BUS_WIDTH_8 ||
++	    mmc->ios.signal_voltage != MMC_SIGNAL_VOLTAGE_180 ||
++	    !mmc->actual_clock || mmc->actual_clock > hs200_max_hz ||
++	    host->dma_dead || host->ios_error)
