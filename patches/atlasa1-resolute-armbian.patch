++
++	/* EXT_CSD HS_TIMING185 and BUS_WIDTH183 prove actual non-ES HS400. */
++	if (ext[185] != ref->hs_timing || ext[183] != 6)
++		return false;
++	for (i = 0; i < 26; i++)
++		if (ext[t736_hs400_ro_offsets[i]] != ref->bytes[i])
