diff --git a/userpatches/atlasa1-release/config/gpu-v10/20-t736-modesetting-1080p.conf b/userpatches/atlasa1-release/config/gpu-v10/20-t736-modesetting-1080p.conf
new file mode 100644
index 0000000000000000000000000000000000000000..c9827c3198c41384ac1eedbb1dc38978204d6472
--- /dev/null
+++ b/userpatches/atlasa1-release/config/gpu-v10/20-t736-modesetting-1080p.conf
@@ -0,0 +1,30 @@
+# T736 Xorg startup mode for the fixed HDMI desktop configuration.
+# Xorg names the kernel card0-HDMI-A-1 connector as HDMI-1.
+Section "Monitor"
+    Identifier "T736 HDMI 1080p"
+    Modeline "1920x1080" 148.50 1920 2008 2052 2200 1080 1084 1089 1125 +HSync +VSync
+    Option "PreferredMode" "1920x1080"
+    Option "Primary" "true"
+EndSection
+
+Section "Device"
+    Identifier "T736 display engine"
+    Driver "modesetting"
+    Option "kmsdev" "/dev/dri/card0"
+    Option "AccelMethod" "glamor"
+    Option "SWcursor" "true"
+    Option "PageFlip" "false"
+    Option "Monitor-HDMI-1" "T736 HDMI 1080p"
+EndSection
+
+Section "Screen"
+    Identifier "T736 Screen"
+    Device "T736 display engine"
+    Monitor "T736 HDMI 1080p"
+    DefaultDepth 24
+    SubSection "Display"
+        Depth 24
+        Modes "1920x1080"
+        Virtual 1920 1080
+    EndSubSection
+EndSection
diff --git a/userpatches/atlasa1-release/config/gpu-v10/t736-hdmi-session-init.sh b/userpatches/atlasa1-release/config/gpu-v10/t736-hdmi-session-init.sh
new file mode 100755
index 0000000000000000000000000000000000000000..5e0cca92a547d869f0e79b985d5ded6518817c57
--- /dev/null
+++ b/userpatches/atlasa1-release/config/gpu-v10/t736-hdmi-session-init.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+# Apply the board's stable HDMI policy once after an Xorg session starts.
+# Xorg calls the kernel card0-HDMI-A-1 output HDMI-1.
+set -u
+
+i=0
+while [ "$i" -lt 30 ]; do
+    if xrandr --query 2>/dev/null | grep -q '^HDMI-1 connected'; then
+        break
+    fi
+    i=$((i + 1))
+    sleep 1
+done
+
+state=$(xrandr --query 2>/dev/null || true)
+mode=$(printf '%s\n' "$state" | awk '
+    $1 == "HDMI-1" && $2 == "connected" {
+        for (i = 1; i <= NF; i++)
+            if ($i ~ /^[0-9]+x[0-9]+\+/) { sub(/\+.*/, "", $i); print $i; exit }
+    }')
+if [ "$mode" != "1920x1080" ]; then
+    xrandr --output HDMI-1 --mode 1920x1080 --rate 60 >/dev/null 2>&1 || true
+fi
+
+range=$(xrandr --verbose 2>/dev/null | awk '
+    /^HDMI-1 connected/ { seen = 1 }
+    seen && /^[[:space:]]*dynamicrange:/ { print $2; exit }')
+if [ "$range" = "1" ]; then
+    # The T736 HDMI driver accepts SDR (0); HDR range=1 is rejected and
+    # can cause a connector reconfiguration when browsers create GL surfaces.
+    xrandr --output HDMI-1 --set dynamicrange 0 >/dev/null 2>&1 || true
+fi
+exit 0
