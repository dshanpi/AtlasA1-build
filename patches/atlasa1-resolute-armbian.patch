new file mode 100644
index 0000000000000000000000000000000000000000..ef5e477af6144583d9ed5dc52f68d69a2253f47e
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/player/README.md
@@ -0,0 +1,34 @@
+# AtlasA1 播放器
+
+在 AtlasA1 GNOME 桌面安装 arm64 软件包后，从应用菜单选择本地文件，也可以在文件管理器中右键 MP4，选择「打开方式 → AtlasA1 播放器」。命令行支持带空格的路径。
+
+```sh
+sudo apt install ./atlasa1-player_0.1-4_arm64.deb
+atlasa1-player "/home/t736/Videos/测试 1080p60.mp4"
+```
+
+播放器使用 SDL GLES2 和当前桌面会话的音频输出，保留晚到的视频帧。对于最高 3840×2160 的偶数宽高、逐行、8 位 4:2:0 H.264 或 HEVC，它会选择 Cedar 代理解码器。其他格式由发行版 FFmpeg 选择解码器。软件包提供一个可选的「打开方式」入口。
+
+对于音视频时间戳同时起始的本地 MP4、MOV 或 Matroska 文件，Cedar 播放器在首帧进入显示队列后开始消耗音频，最长等待 2.5 秒。这可避免冷启动时声音比画面提前。具有音画起始偏移的文件保留原来的时间安排。
+
+播放 3840×2160 视频时，启动器读取当前桌面的物理输出模式。对于只启用一台 1920×1080 显示器的 T736，播放器首先请求 Cedar 硬件缩放。支持该模式的代理让 OMX 直接输出可见尺寸为 1920×1080 的帧，日志显示 `mode=omx-scale`。旧代理或已保留全尺寸 4K 上下文的代理使用原尺寸解码，客户端再将每个 I420 平面按 2×2 像素求平均，日志显示 `mode=shm-box`。两条路径都将 1080p 帧交给 PowerVR。若进程可以使用 CPU6 和 CPU7，播放器的线程在这两个大核上运行。4K 显示器、多显示器和无法读取显示模式时使用原尺寸帧。1080p 片源走原来的解码及调度路径，日志显示 `mode=source`。
+
+图形和解码服务由板级镜像提供。播放器沿用当前用户的图形会话和视频代理权限。v30 实板测试使用 256 MiB Cedar 专用堆、并行写入输出帧的 direct-slot 后端、匹配的 OMX 配置及 PowerVR 用户态库。v29 默认启动项的堆上限是 128 MiB，全分辨率 4K HEVC 在该配置上没有产生硬件帧。两种内核所用的测试代理都只保留一个解码上下文，同一启动周期切换编码或分辨率可能退回软件解码。
+
+## 构建
+
+在 Linux 构建机上准备 FFmpeg 7.1.5 源码，以及含 Debian arm64 FFmpeg、SDL2 运行库和 SDL2 开发头文件的 sysroot。下面的命令先构建包含刷新和首帧音频同步补丁的 `ffplay-start-sync`，再构建和打包播放器专用的 Cedar 客户端和 FFmpeg 库。
+
+```sh
+private=$(mktemp -d)
+bash tools/build_ffplay_refresh_pair.sh /src/ffmpeg-7.1.5 /src/debian-arm64-sysroot "$private/player"
+sh tools/player/prepare_panel_sources.sh "$private/src"
+python3 "$private/src/build_browser_ffmpeg.py" --source /src/ffmpeg-7.1.5 --work "$private/ffmpeg"
+python3 tools/build_atlasa1_player.py \
+  --ffplay "$private/player/ffplay-start-sync" \
+  --avcodec "$private/ffmpeg/install/opt/t736-browser-ffmpeg/lib/libavcodec.so.61" \
+  --avutil "$private/ffmpeg/install/opt/t736-browser-ffmpeg/lib/libavutil.so.59" \
+  --output /tmp/atlasa1-player_0.1-4_arm64.deb
+```
+
+软件包依赖 Debian 13 的 FFmpeg 7.1 运行库，以及板级已经安装的 PowerVR 和 Cedar 服务。原生客户端核对监听端和共享帧的属主，播放器通过服务接收只读的普通内存帧。安装和卸载可通过系统包管理器完成。
diff --git a/userpatches/atlasa1-release/tools/prepare_atlas_release_sources.py b/userpatches/atlasa1-release/tools/prepare_atlas_release_sources.py
new file mode 100755
index 0000000000000000000000000000000000000000..7e27dc34ec227af6507d09308a693ddfa5ea06b1
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/prepare_atlas_release_sources.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Reconstruct the board-tested Linux, U-Boot or PowerVR module sources."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+REVISIONS = {
+    'linux': ('1cdda838e8475edf89b73ff0cc952005dd0b1fa7', 'media-v30-replay', 'kernel.config'),
+    'u-boot': ('5508406582f6f7120dce0c4b3059819a41788db2', 'media-v28-replay', 'uboot.config'),
+}
+ARCHIVES = {
+    'linux': ('c41bdd52b610c75613effe80c6abf236efce706b3304fe2f023bf912413f9f6e', 1),
+    'u-boot': ('af3cca26c2ea2a352efc05980d991b7310959dc431c427ad3250e832a221abd8', 0),
+}
+
+
+def verify(path, expected):
+    with path.open('rb') as stream:
+        digest = hashlib.sha256()
+        for block in iter(lambda: stream.read(1 << 20), b''):
+            digest.update(block)
+    if digest.hexdigest() != expected:
+        raise ValueError(f'Unexpected source contents: {path}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('component', choices=(*REVISIONS, 'pvr'))
+    source = parser.add_mutually_exclusive_group()
+    source.add_argument('--upstream', type=Path, help='Local Git repository containing the official revision')
+    source.add_argument('--archive', type=Path, help='Previously archived upstream sources, verified by SHA-256')
+    parser.add_argument('--output', type=Path, required=True, help='New source directory')
+    parser.add_argument('--tina', type=Path, help='Tina SDK source root containing bsp/')
+    args = parser.parse_args()
+    if args.component in ('linux', 'pvr') and not args.tina:
+        parser.error('this component requires --tina')
+    patches = Path(__file__).resolve().parents[1] / 'patches'
+    if args.component == 'pvr':
+        if args.archive or args.upstream:
+            parser.error('pvr takes its sources from --tina')
+        rev = '24.2'
+        config = None
+        bundle = patches / 'linux' / 'media-v30-pvr-replay'
+    else:
+        if not (args.archive or args.upstream):
+            parser.error('specify --archive or --upstream')
+        rev, recipe, config = REVISIONS[args.component]
+        bundle = patches / args.component / recipe
+    output = args.output.resolve()
+    if output.exists():
+        parser.error('--output must name a new directory')
+    if args.archive:
+        archive_sha, strip_components = ARCHIVES[args.component]
+        verify(args.archive, archive_sha)
+    inputs = (json.loads((bundle / 'tina-display-inputs.json').read_text())
+              if args.component == 'linux' else [])
+    recorded = json.loads((bundle / 'source-hashes.json').read_text())
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix='.atlas-source-', dir=output.parent) as work:
+        src = Path(work) / 'src'
+        src.mkdir()
+        if args.component == 'pvr':
+            ddk = args.tina / 'bsp/modules/gpu/img-bxm/linux/rogue_km'
+            for item in ddk.iterdir():
+                if item.name.startswith('binary_'):
+                    continue
+                dest = src / item.name
+                if item.is_dir():
+                    shutil.copytree(item, dest, symlinks=True)
+                else:
+                    shutil.copy2(item, dest, follow_symlinks=False)
+        elif args.archive:
+            subprocess.run(['tar', '-xf', str(args.archive), f'--strip-components={strip_components}',
+                            '-C', str(src)], check=True)
+        else:
+            with subprocess.Popen(['git', '-C', str(args.upstream), 'archive', '--format=tar', rev],
+                                  stdout=subprocess.PIPE) as archive:
+                try:
+                    subprocess.run(['tar', '-xf', '-', '-C', str(src)], stdin=archive.stdout, check=True)
+                finally:
+                    archive.stdout.close()
+                if archive.wait():
+                    raise RuntimeError('git archive did not complete')
+        for rel, expected in recorded['upstream_files'].items():
+            verify(src / rel, expected)
+        for item in inputs:
+            dest = src / item['destination']
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(args.tina / item['source'], dest)
+            verify(dest, item['sha256'])
+        subprocess.run(['patch', '--batch', '--forward', '--fuzz=0', '-p1', '-i',
+                        str(bundle / 'board.patch')], cwd=src, check=True)
+        for rel, expected in recorded['board_tree'].items():
+            verify(src / rel, expected)
+        if config:
+            shutil.copyfile(bundle / config, src / '.config.atlasa1')
+        src.rename(output)
+    print(f'Prepared {args.component} {rev} with {len(recorded["board_tree"])} verified board files at {output}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/userpatches/atlasa1-release/tools/prepare_atlasa1_resolute_media.py b/userpatches/atlasa1-release/tools/prepare_atlasa1_resolute_media.py
new file mode 100755
index 0000000000000000000000000000000000000000..8c6f80f939f597c9fc5e1ceb3b69a9bb4757997e
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/prepare_atlasa1_resolute_media.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Stage the native AtlasA1 Cedar service and PowerVR firmware for Ubuntu 26.04."""
+import argparse
+import hashlib
+import json
+from pathlib import Path, PurePosixPath
+import shutil
+import subprocess
+import tarfile
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SERVICE_HASHES = {'cedar-broker': '1910bf0ce66653d27fe67f99d2a1ce8b813dafec3893f981a8d7c662a61f3b04',
+                  'libcedar_backend.so': '2185f2019b4aea60933c34d387d290e808848e420f8899b0b401783293145583'}
+FIRMWARE = {'rgx.fw.36.56.104.183': '43eb5d054ee98bc975274198d2ed440e2f0f50b7ffcd0996a4022949f2c7909f',
+            'rgx.sh.36.56.104.183': '71e1b1da9b4c6b42468e378e8b835306920568088bc6669879db4a108a7747c9'}
+RELEASE = '6.18.63-t736-media-v30'
+
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def verified(path, expected):
+    if digest(path) != expected:
+        raise ValueError(f'Unexpected contents in {path}')
+    return path
+
+
+def prepare(args, root, tmp):
+    browser = Path(__file__).resolve().parent / 'browser'
+    wc = root / 'opt/t736-cedar-wc-v5'
+    service = root / 'opt/t736-cedar-transport-v2'
+    systemd = root / 'etc/systemd/system'
+
+    def install(source, dest, mode=0o644):
+        dest.parent.mkdir(exist_ok=True, parents=True)
+        shutil.copyfile(source, dest)
+        dest.chmod(mode)
+
+    def write(dest, value, mode=0o644):
+        dest.parent.mkdir(exist_ok=True, parents=True)
+        dest.write_text(value)
+        dest.chmod(mode)
+
+    vendor_files = json.loads((ROOT/'config/atlasa1-resolute-vendor-files.json').read_text())
+    sdk_libs = vendor_files['cedar_sdk_libraries']
+    expected_libs = set(sdk_libs) | set(vendor_files['cedar_rebuilt_libraries'])
+    with tarfile.open(args.wc_archive, 'r:gz') as tar:
+        for item in tar:
+            rel = PurePosixPath(item.name)
+            if item.isfile() and rel.parts[:2] == ('t736-cedar-wc-v5', 'lib'):
+                if '..' in rel.parts or rel.suffix != '.so':
+                    raise ValueError(f'Unexpected runtime file {rel}')
+                dest = wc.joinpath(*rel.parts[1:])
+                dest.parent.mkdir(exist_ok=True, parents=True)
+                with tar.extractfile(item) as source, dest.open('xb') as stream:
+                    shutil.copyfileobj(source, stream)
+                dest.chmod(0o644)
+    if {p.relative_to(wc/'lib').as_posix() for p in (wc/'lib').rglob('*.so')} != expected_libs:
+        raise ValueError('Cedar library set differs from the board runtime')
+    for name, sha in sdk_libs.items():
+        verified(wc/'lib'/name, sha)
+    for name, symbol in (('libcdc_base.so', b'/dev/dma_heap/t736-ve'),
+                         ('libMemAdapter.so', b'T736_WC: first validated WC ordering barrier'),
+                         ('gstreamer-1.0/libgstomx.so', b'T736_OMX_DIAG')):
+        contents = (wc/'lib'/name).read_bytes()
+        if symbol not in contents:
+            raise ValueError(f'Missing board-specific code in {name}')
+    for library in vendor_files['cedar_rebuilt_libraries']:
+        header = subprocess.check_output(['readelf', '-h', wc/'lib'/library], text=True)
+        if 'AArch64' not in header:
+            raise ValueError(f'Unexpected architecture for {library}')
+    if b't736_broker_4k_buffers' not in args.omx_vdec.read_bytes():
+        raise ValueError('The OMX decoder was not built with the 4K broker buffer patch')
+    install(args.omx_vdec, wc/'lib/libOmxVdec.so')
+    for name, sha in SERVICE_HASHES.items():
+        source = verified(args.service_build/name, sha)
+        if name == 'cedar-broker':
+            install(source, service/'bin'/name, 0o755)
+        else:
+            install(source, root/'opt/t736-cedar-browser-backend-v5'/name)
+    shm = browser/'shm_v2'
+    # PrivateTmp is writable by the broker; the client's socket directory is root-owned.
+    script = (shm/'cedar-service').read_text().replace(
+        'GST_REGISTRY_1_0=/run/t736-cedar/registry.bin', 'GST_REGISTRY_1_0=/tmp/t736-cedar-registry.bin')
+    write(service/'bin/cedar-service', script, 0o755)
+    install(browser/'gstomx.conf', service/'config/gstomx.conf')
+    config = (browser/'cedarc.conf').read_text().rstrip() + '\nt736_broker_4k_buffers = 1\nenable_scaledown_while_4k = 0\n'
+    write(service/'config/cedarc.conf', config)
+    write(root/'etc/cedarc.conf', '# Service-specific configuration is bind-mounted by t736-cedar.service.\n')
+    install(shm/'70-t736-cedar.rules', root/'etc/udev/rules.d/70-t736-cedar.rules')
+    unit = (shm/'t736-cedar-experiment.service').read_text().replace(
+        'Description=T736 isolated Cedar ordinary-RAM transport experiment',
+        'Description=AtlasA1 Cedar hardware video decoder').replace('CPUAffinity=6 7', 'CPUAffinity=4 5 6 7')
+    write(systemd/'t736-cedar.service', unit.split('# Deliberately no Install section')[0].rstrip()+'\n')
+    socket = (shm/'t736-cedar.socket').read_text().replace('t736-cedar-experiment.service', 't736-cedar.service')
+    write(systemd/'t736-cedar.socket', socket)
+    enabled = systemd/'sockets.target.wants'
+    enabled.mkdir(exist_ok=True)
+    (enabled/'t736-cedar.socket').symlink_to('../t736-cedar.socket')
+    vermagic = subprocess.check_output(['modinfo', '-F', 'vermagic', args.pvr_module], text=True).split()
+    if vermagic[:1] != [RELEASE]:
+        raise ValueError('PowerVR module kernel ABI mismatch')
+    install(args.pvr_module, root/'usr/lib/modules'/RELEASE/'extra/pvrsrvkm.ko')
+    write(root/'etc/modules-load.d/atlasa1-pvr.conf', 'pvrsrvkm\n')
+    fields = [subprocess.check_output(['dpkg-deb', '-f', args.gpu_deb, f], text=True).strip()
+              for f in ('Package','Version','Architecture')]
+    if fields != ['t736-img-userspace-candidate', '24.2.6603887-2', 'arm64']:
+        raise ValueError('Unexpected GPU package identity')
+    subprocess.run(['dpkg-deb', '-x', args.gpu_deb, tmp/'gpu'], check=True)
+    for rel, expected in vendor_files['gpu_sdk_files'].items():
+        path = tmp/'gpu'/rel
+        if isinstance(expected, str):
+            verified(path, expected)
+        elif not path.is_symlink() or str(path.readlink()) != expected['symlink']:
+            raise ValueError(f'Unexpected GPU library symlink {rel}')
+    for name, sha in FIRMWARE.items():
+        source = verified(tmp/'gpu/opt/t736-img-ddk-24.2-x11/firmware'/name, sha)
+        install(source, root/'usr/lib/firmware'/name)
+    receipts = {str(p.relative_to(root)):digest(p) for p in sorted(root.rglob('*')) if p.is_file()}
+    write(root/'usr/share/doc/atlasa1-board/media-sha256.json', json.dumps(receipts, indent=2)+'\n')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('wc-archive', 'service-build', 'omx-vdec', 'pvr-module', 'gpu-deb', 'output'):
+        parser.add_argument('--'+name, required=True, type=Path)
+    args = parser.parse_args()
+    if args.output.exists():
+        parser.error('--output requires a new directory')
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(dir=args.output.parent, prefix='.media-') as temporary:
+        tmp = Path(temporary)
+        stage = tmp/'overlay'
+        prepare(args, stage, tmp)
+        stage.rename(args.output)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/userpatches/atlasa1-release/tools/prepare_atlasa1_sdl_sysroot.sh b/userpatches/atlasa1-release/tools/prepare_atlasa1_sdl_sysroot.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b1635a854590247bd6095c5834bc383f70480726
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/prepare_atlasa1_sdl_sysroot.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Minimal ARM64 SDL2 development sysroot for the private FFplay build.
+set -euo pipefail
+[[ $# == 1 ]] || { echo "Usage: $0 NEW_SYSROOT" >&2; exit 2; }
+root=$(realpath -m "$1")
+work=$(mktemp -d)
+trap 'rm -rf -- "$work"' EXIT
+version=2.32.4+dfsg-1
+origin=https://deb.debian.org/debian/pool/main/libs/libsdl2
+cd "$work"
+for pkg in libsdl2-2.0-0 libsdl2-dev; do
+    curl --fail --location --retry 3 --output "$pkg.deb" "$origin/${pkg}_${version}_arm64.deb"
+done
+sha256sum --check <<'SUMS'
+6312ccbc29645ac5cc9dde9f9ed8bd5c85a0233690c270c83c963b49f8cd49d5  libsdl2-2.0-0.deb
+7def114ccf8fcbb67a2a326e7090ec0aa50074269e4e2108a23cf3328a3abc47  libsdl2-dev.deb
+SUMS
+mkdir -- "$root"
+dpkg-deb -x libsdl2-2.0-0.deb "$root"
+dpkg-deb -x libsdl2-dev.deb "$root"
+export PKG_CONFIG_SYSROOT_DIR="$root"
+export PKG_CONFIG_LIBDIR="$root/usr/lib/aarch64-linux-gnu/pkgconfig"
+[[ $(pkg-config --modversion sdl2) == 2.32.4 ]]
+pkg-config --cflags --libs sdl2 > sdl.flags
+read -r -a flags < sdl.flags
+printf '#include <SDL.h>\nint main(void) { return SDL_Init(0); }\n' > abi.c
+aarch64-linux-gnu-gcc -I"$root/usr/include/aarch64-linux-gnu" -o abi-test abi.c "${flags[@]}" -Wl,--allow-shlib-undefined
+readelf -d abi-test | grep -F 'Shared library: [libSDL2-2.0.so.0]'
diff --git a/userpatches/atlasa1-release/tools/prepare_t736_resolute_rootfs.sh b/userpatches/atlasa1-release/tools/prepare_t736_resolute_rootfs.sh
new file mode 100755
index 0000000000000000000000000000000000000000..3abf008990637e8eb4ec48f51ab13f6892511fbe
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/prepare_t736_resolute_rootfs.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+# Finish the official Armbian Resolute ARM64 rootfs for AtlasA1 image assembly.
+# Usage: sudo bash prepare_t736_resolute_rootfs.sh ROOTFS.tar.zst NEW_ROOT BSP_OUTPUT_DEBS
+set -euo pipefail
+
+if (( EUID != 0 || $# != 3 )); then
+    echo "Usage: sudo bash $0 ROOTFS.tar.zst NEW_ROOT BSP_OUTPUT_DEBS" >&2
+    exit 2
+fi
+if [[ ${T736_PRIVATE_MOUNT_NAMESPACE:-} != yes ]]; then
+    exec unshare --mount --propagation private env T736_PRIVATE_MOUNT_NAMESPACE=yes bash "$0" "$@"
+fi
+archive=$(realpath -e "$1")
+root=$(realpath -m "$2")
+debs=$(realpath -e "$3")
+shopt -s nullglob
+bsp=("$debs"/armbian-bsp-cli-t736-mainline-current_*_arm64__*.deb)
+base=("$debs"/extra/resolute-utils/base-files_*resolute_arm64__*.deb)
+[[ ${#bsp[@]} == 1 && ${#base[@]} == 1 ]] || { echo "Expected one BSP and one Resolute base-files package" >&2; exit 1; }
+mkdir -- "$root"
+tar --xattrs --acls --numeric-owner -I zstd -xf "$archive" -C "$root"
+grep -q '^VERSION_CODENAME=resolute$' "$root/usr/lib/os-release"
+[[ $(chroot "$root" dpkg --print-architecture) == arm64 ]]
+mount -t proc proc "$root/proc"
+mount --rbind /dev "$root/dev"
+mount -t sysfs -o ro sysfs "$root/sys"
+mount -t tmpfs tmpfs "$root/run"
+scratch=$(mktemp -d "$root/tmp/atlas-bsp-XXXXXXXX")
+mkdir -p "$scratch/saved"
+preserve() {
+    if [[ -e "$root/$1" || -L "$root/$1" ]]; then
+        mv -- "$root/$1" "$scratch/saved/${1##*/}"
+    fi
+}
+restore() {
+    rm -f -- "$root/$1"
+    if [[ -e "$scratch/saved/${1##*/}" || -L "$scratch/saved/${1##*/}" ]]; then
+        mv -- "$scratch/saved/${1##*/}" "$root/$1"
+    fi
+}
+preserve etc/resolv.conf
+preserve usr/sbin/policy-rc.d
+cleanup() {
+    restore etc/resolv.conf
+    restore usr/sbin/policy-rc.d
+    rm -rf -- "$scratch"
+}
+trap cleanup EXIT
+cp -L /etc/resolv.conf "$root/etc/resolv.conf"
+printf '#!/bin/sh\nexit 101\n' > "$root/usr/sbin/policy-rc.d"
+chmod 0755 "$root/usr/sbin/policy-rc.d" "$scratch"
+cp "${bsp[0]}" "$scratch/bsp.deb"
+cp "${base[0]}" "$scratch/base.deb"
+inside=${scratch#"$root"}
+run() { chroot "$root" /usr/bin/env DEBIAN_FRONTEND=noninteractive LC_ALL=C "$@"; }
+run apt-get -o Acquire::Retries=3 -o Acquire::Languages=none \
+    -o Acquire::IndexTargets::deb::Contents-deb::DefaultEnabled=false \
+    -o Acquire::IndexTargets::deb::Contents-deb-legacy::DefaultEnabled=false update
+# The rootfs repository may already contain a newer Armbian base-files build.
+# Install the package made from this checkout, as the framework's image stage does.
+run apt-get -o Acquire::Retries=3 -y --allow-downgrades --no-install-recommends install "$inside/base.deb"
+printf '%s\n' 'gdm3 shared/default-x-display-manager select lightdm' 'lightdm shared/default-x-display-manager select lightdm' |
+    run debconf-set-selections
+run apt-get -o Acquire::Retries=3 -y --no-install-recommends install \
+    "$inside/bsp.deb" armbian-config openssh-server network-manager netplan.io systemd-resolved \
+    gdm3 gnome-session gnome-shell gnome-control-center nautilus \
+    lightdm lightdm-gtk-greeter xfce4-session xfce4-panel xfwm4 xfdesktop4 thunar \
+    xserver-xorg-core xserver-xorg-video-fbdev xserver-xorg-input-libinput x11-xserver-utils \
+    firefox ffmpeg gstreamer1.0-tools gstreamer1.0-plugins-good gstreamer1.0-plugins-bad pipewire-audio fonts-noto-cjk
+[[ -x "$root/usr/lib/firefox/firefox" || -x "$root/opt/firefox/firefox" ]]
+test -x "$root/usr/sbin/lightdm"
+printf '/usr/sbin/lightdm\n' > "$root/etc/X11/default-display-manager"
+install -d "$root/etc/lightdm/lightdm.conf.d"
+printf '[Seat:*]\nuser-session=xfce\ngreeter-session=lightdm-gtk-greeter\n' > "$root/etc/lightdm/lightdm.conf.d/50-atlasa1-session.conf"
+run systemctl --no-reload enable --force lightdm.service NetworkManager.service systemd-resolved.service serial-getty@ttyS0.service armbian-firstrun.service ssl-cert.service
+run systemctl --no-reload set-default graphical.target
+# The board uses a fixed fourth partition and a vendor GPT copy at LBA 40960.
+run systemctl --no-reload mask armbian-resize-filesystem.service
+install -d -m 0755 "$root/etc/netplan"
+printf 'network:\n  version: 2\n  renderer: NetworkManager\n' > "$root/etc/netplan/90-atlasa1-desktop.yaml"
+chmod 0600 "$root/etc/netplan/90-atlasa1-desktop.yaml"
+run netplan generate
+printf 'atlasa1\n' > "$root/etc/hostname"
+printf '127.0.0.1 localhost\n127.0.1.1 atlasa1\n::1 localhost ip6-localhost ip6-loopback\n' > "$root/etc/hosts"
+run apt-get check
+audit=$(run dpkg --audit)
+[[ -z "$audit" ]] || { echo "$audit" >&2; exit 1; }
+test -f "$root/usr/share/wayland-sessions/gnome.desktop"
+test -f "$root/usr/share/xsessions/xfce.desktop"
+test -f "$root/etc/armbian-release"
+run apt-get clean
+find "$root/var/lib/apt/lists" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
+find "$root/etc/ssh" -maxdepth 1 -type f -name 'ssh_host_*' -delete
+rm -f -- "$root/etc/ssl/certs/ssl-cert-snakeoil.pem" "$root/etc/ssl/private/ssl-cert-snakeoil.key"
+: > "$root/etc/machine-id"
+ln -sfn /etc/machine-id "$root/var/lib/dbus/machine-id"
+rm -f -- "$root/var/lib/systemd/random-seed"
+run dpkg-query -W -f='${binary:Package}\t${Version}\n' base-files armbian-config \
+    armbian-bsp-cli-t736-mainline-current gnome-shell gdm3 xfce4-session ffmpeg
+trap - EXIT
+cleanup
+ln -sfn /run/systemd/resolve/stub-resolv.conf "$root/etc/resolv.conf"
+# The upstream cache leaves service startup blocked until its image stage.
+for service_tool in /sbin/initctl /sbin/start-stop-daemon; do
+    if [[ $(run dpkg-divert --listpackage "$service_tool") == LOCAL ]]; then
+        rm -f -- "$root$service_tool"
+        run dpkg-divert --quiet --local --rename --remove "$service_tool"
+    fi
+done
+rm -f -- "$root/usr/sbin/policy-rc.d"
+run start-stop-daemon --version
