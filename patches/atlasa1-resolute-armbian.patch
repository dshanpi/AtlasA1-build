diff --git a/userpatches/atlasa1-release/patches/t736-armbian-open-source.patch b/userpatches/atlasa1-release/patches/t736-armbian-open-source.patch
new file mode 100644
index 0000000000000000000000000000000000000000..2c2b2dca6dec0e237b88352781758ef687f4dc60
--- /dev/null
+++ b/userpatches/atlasa1-release/patches/t736-armbian-open-source.patch
@@ -0,0 +1,5301 @@
+# T736 open-source Armbian integration patch.
+# Apply at the root of the pinned Armbian build checkout with: git apply <file>
+# Licensed GPU/codec/DDR binaries are intentionally excluded.
+
+diff --git a/userpatches/config/boards/t736-mainline.conf b/userpatches/config/boards/t736-mainline.conf
+new file mode 100644
+index 0000000..ed1b200
+--- /dev/null
++++ b/userpatches/config/boards/t736-mainline.conf
+@@ -0,0 +1,19 @@
++# AtlasA1 / T736 open SBC board definition for Armbian.
++# This file is also emitted by tools/export_t736_armbian_patch.py.
++BOARD_NAME="AtlasA1 / T736"
++BOARD_VENDOR="T736 open SBC"
++BOARDFAMILY="t736-mainline"
++KERNEL_TARGET="current"
++BOOTCONFIG="t736_bringup_defconfig"
++SERIALCON="ttyS0"
++BOOT_FDT_FILE="allwinner/t736-mainline-bringup.dtb"
++HAS_VIDEO_OUTPUT="yes"
++
++function post_family_tweaks__t736_display_idle() {
++    [[ "${BUILD_DESKTOP:-no}" == yes ]] || return 0
++    local files="${USERPATCHES_PATH}/config/t736-display"
++    install -D -m 0644 "${files}/30-t736-x11-blank.conf" "${SDCARD}/etc/X11/xorg.conf.d/30-t736-x11-blank.conf"
++    if [[ -d "${SDCARD}/usr/share/gdm/dconf" ]]; then
++        install -m 0644 "${files}/95-t736-greeter" "${SDCARD}/usr/share/gdm/dconf/95-t736-greeter"
++    fi
++}
+diff --git a/userpatches/config/sources/families/t736-mainline.conf b/userpatches/config/sources/families/t736-mainline.conf
+new file mode 100644
+index 0000000..269aedd
+--- /dev/null
++++ b/userpatches/config/sources/families/t736-mainline.conf
+@@ -0,0 +1,41 @@
++# SPDX-License-Identifier: GPL-2.0-only
++# Independent board family. Do not include sun60iw2 vendor families.
++ARCH="arm64"
++BOOTBRANCH="tag:v2026.10"
++BOOTSOURCE="https://github.com/u-boot/u-boot.git"
++BOOTPATCHDIR="u-boot-t736-mainline"
++UBOOT_TARGET_MAP=";;u-boot.bin"
++ATF_COMPILE="no"
++KERNELSOURCE="https://github.com/gregkh/linux.git"
++KERNELBRANCH="tag:v6.18.63"
++KERNEL_MAJOR_MINOR="6.18"
++KERNELPATCHDIR="t736-mainline-6.18"
++LINUXCONFIG="linux-t736-mainline-current"
++KERNEL_IMAGE_TYPE="Image"
++KERNEL_EXTRA_DRIVERS="no"
++SERIALCON="ttyS0"
