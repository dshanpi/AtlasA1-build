++static int t736_update_clock(struct t736_host *host)
++{
++	u32 value;
++	int ret;
++
++	writel(CMD_START | BIT(21) | BIT(13), host->regs + COMMAND);
++	ret = readl_poll_timeout(host->regs + COMMAND, value,
++				!(value & CMD_START), 10, 1000000);
++	writel(~0U, host->regs + IRQSTATUS);
++	return ret;
++}
