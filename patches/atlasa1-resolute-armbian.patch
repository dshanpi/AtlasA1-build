index 0000000000000000000000000000000000000000..24cf46eb78f20235790e270bfeadca741821b3f9
--- /dev/null
+++ b/userpatches/atlasa1-release/config/gnome-wayland/50-atlasa1-wayland.conf
@@ -0,0 +1,10 @@
+[Service]
+Environment=LD_LIBRARY_PATH=/opt/atlasa1-img-wayland/runtime-gles
+Environment=LIBGL_DRIVERS_PATH=/opt/atlasa1-img-wayland/lib/dri
+Environment=COGL_DRIVER=gles2
+Environment=GDK_BACKEND=wayland
+Environment=GSK_RENDERER=gl
+Environment=GDK_DISABLE=gl-api,vulkan
+# sunxi-drm vblank queries can block. Submit without the KMS deadline timer.
+Environment=MUTTER_DEBUG_KMS_SCHEDULING_PRIORITY=normal
+ExecStartPre=/usr/bin/dbus-update-activation-environment --systemd LD_LIBRARY_PATH LIBGL_DRIVERS_PATH COGL_DRIVER GDK_BACKEND GSK_RENDERER GDK_DISABLE
diff --git a/userpatches/atlasa1-release/config/gnome-wayland/60-atlasa1-greeter-display.conf b/userpatches/atlasa1-release/config/gnome-wayland/60-atlasa1-greeter-display.conf
new file mode 100644
index 0000000000000000000000000000000000000000..7180c906933f115e6fdc5289f33adcb1bf9c952b
--- /dev/null
+++ b/userpatches/atlasa1-release/config/gnome-wayland/60-atlasa1-greeter-display.conf
@@ -0,0 +1,4 @@
+[Service]
+# The greeter does not start the desktop XDG autostart target on GNOME 50.
+# Type=notify means Mutter is ready before the helper queries DisplayConfig.
+ExecStartPost=-/usr/local/libexec/atlasa1-display-default
diff --git a/userpatches/atlasa1-release/config/gnome-wayland/61-atlasa1-gnome.rules b/userpatches/atlasa1-release/config/gnome-wayland/61-atlasa1-gnome.rules
