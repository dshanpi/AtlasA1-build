+#!/usr/bin/env python3
+"""Compare aligned O_DIRECT reads with GNU dd; never open the SSD for writing."""
+import argparse
+import fcntl
+import json
+import mmap
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import struct
+import subprocess
