+SUBSYSTEM=="misc", KERNEL=="cedar_dev", OWNER="t736-cedar", GROUP="t736-cedar", MODE="0600"
+SUBSYSTEM=="dma_heap", KERNEL=="t736-ve", OWNER="t736-cedar", GROUP="t736-cedar", MODE="0600"
