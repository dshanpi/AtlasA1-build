++static int t736_probe(struct platform_device *pdev)
++{
++	struct mmc_host *mmc;
++	struct t736_host *host;
++	struct pinctrl *pinctrl;
++	u32 value, sys24, peri800;
++	int ret, i;
++
++	if (hs_max_hz != 25000000 && hs_max_hz != 50000000)
++		return -EINVAL;
++	if (hs200_max_hz != 100000000 && hs200_max_hz != 200000000)
++		return -EINVAL;
++	if (hs400_max_hz != 100000000 && hs400_max_hz != 200000000)
++		return -EINVAL;
++	if (enable_hs400 && (!enable_hs200 || hs200_max_hz != 200000000))
++		return -EINVAL;
++	/* Claim the PC pins before touching the storage controller. */
++	pinctrl = devm_pinctrl_get_select_default(&pdev->dev);
++	if (IS_ERR(pinctrl))
++		return dev_err_probe(&pdev->dev, PTR_ERR(pinctrl),
++				     "eMMC pinctrl unavailable\n");
++
++	mmc = mmc_alloc_host(sizeof(*host), &pdev->dev);
++	if (!mmc)
++		return -ENOMEM;
++	host = mmc_priv(mmc);
++	host->mmc = mmc;
++	spin_lock_init(&host->timing_lock);
++	INIT_WORK(&host->work, t736_worker);
++	/* Keep descriptor and data DMA addresses below 4 GiB even on 8 GiB RAM. */
++	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
++	if (ret)
++		goto free_host;
++	host->buffer = dma_alloc_noncoherent(&pdev->dev, MAX_REQUEST_BYTES,
++					    &host->buffer_dma, DMA_BIDIRECTIONAL, GFP_KERNEL);
++	if (!host->buffer) {
++		ret = -ENOMEM;
++		goto free_host;
++	}
++	host->desc = dma_alloc_coherent(&pdev->dev,
++				       sizeof(*host->desc) * T736_DMA_DESCS,
++				       &host->desc_dma, GFP_KERNEL);
++	if (!host->desc) {
++		ret = -ENOMEM;
++		goto free_buffer;
++	}
++	/* Ordered workqueues are unbound and serialize requests, including one
++	 * submitted synchronously by mmc_request_done() before this work returns.
++	 * The reclaim rescuer keeps root-filesystem I/O available under pressure.
++	 */
++	host->workqueue = alloc_ordered_workqueue("t736-mmc-dma", WQ_MEM_RECLAIM);
++	if (!host->workqueue) {
++		ret = -ENOMEM;
++		goto free_desc;
++	}
++	host->regs = devm_platform_ioremap_resource(pdev, 0);
++	host->clock = devm_platform_ioremap_resource(pdev, 1);
++	host->gate = devm_platform_ioremap_resource(pdev, 2);
++	if (IS_ERR(host->regs) || IS_ERR(host->clock) || IS_ERR(host->gate)) {
++		ret = -ENODEV;
++		goto destroy_workqueue;
++	}
++	ret = t736_check_dma_bus(pdev);
++	if (ret)
++		goto destroy_workqueue;
++	ret = t736_read_clock_parents(pdev, host);
++	if (ret)
++		goto destroy_workqueue;
++	ret = t736_validate_clock_parents(host, true, &sys24, &peri800);
++	if (ret)
++		goto destroy_workqueue;
++	/* Power rails, pad drive and pulls remain configured by board firmware. */
++	writel(BIT(31), host->clock);
++	writel(readl(host->gate) & ~BIT(16), host->gate);
++	udelay(10);
++	writel(readl(host->gate) | BIT(16) | BIT(0), host->gate);
++	writel(7, host->regs + CTRL);
++	ret = readl_poll_timeout(host->regs + CTRL, value, !(value & 7), 10, 100000);
++	if (ret)
++		goto destroy_workqueue;
++	for (i = 0; i < ARRAY_SIZE(timing_offsets); i++)
++		host->legacy_timing[i] = readl(host->regs + timing_offsets[i]);
++	host->legacy_threshold = readl(host->regs + CARD_THRESHOLD);
++	/* v5p6x uses word-addressed DLBA and descriptor pointers. */
++	value = readl(host->regs + SMCV) & 0xffffff;
++	if (value < 0x50600 || value >= 0x50700) {
++		dev_err(&pdev->dev, "SMHC version %06x is not audited v5p6x\n", value);
++		ret = -ENODEV;
++		goto destroy_workqueue;
++	}
++	writel(0, host->regs + CTRL);
++	ret = t736_dma_stop(host);
++	if (ret)
++		goto destroy_workqueue;
++	dev_info(&pdev->dev, "SMHC %06x: IDMA descriptors=%pad data=%pad (shift2, mask32)\n",
++		 value, &host->desc_dma, &host->buffer_dma);
++	writel(0, host->regs + IRQMASK);
++	writel(~0U, host->regs + IRQSTATUS);
++	writel(~0U, host->regs + TIMEOUT);
++	writel(0, host->regs + CARDRESET);
++	udelay(10);
++	writel(1, host->regs + CARDRESET);
++	usleep_range(1000, 2000);
++	mmc->ops = &t736_ops;
++	mmc->f_min = 400000;
++	mmc->f_max = enable_hs200 ? hs200_max_hz : hs_max_hz;
++	mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
++	mmc->caps = MMC_CAP_NONREMOVABLE | MMC_CAP_4_BIT_DATA | MMC_CAP_8_BIT_DATA | MMC_CAP_MMC_HIGHSPEED;
++	mmc->caps2 = MMC_CAP2_NO_SD | MMC_CAP2_NO_SDIO | MMC_CAP2_AVOID_3_3V;
++	if (enable_hs200)
++		mmc->caps2 |= MMC_CAP2_HS200_1_8V_SDR;
++	if (enable_hs400)
++		mmc->caps2 |= MMC_CAP2_HS400_1_8V;
++	mmc->max_blk_size = 512;
++	mmc->max_blk_count = MAX_REQUEST_BYTES / 512;
++	mmc->max_req_size = MAX_REQUEST_BYTES;
++	mmc->max_seg_size = MAX_REQUEST_BYTES;
++	mmc->max_segs = MAX_REQUEST_BYTES / 512;
++	platform_set_drvdata(pdev, mmc);
++	ret = mmc_add_host(mmc);
++	if (!ret) {
++		if (collect_timing) {
++			host->timing_debugfs = debugfs_create_dir("t736_mmc_timing", NULL);
++			debugfs_create_file("stats", 0444, host->timing_debugfs,
++					    host, &t736_diag_fops);
++		}
++		dev_info(&pdev->dev,
++			 "HS400 draft: v23 IDMA, HS cap=%u, HS200=%u cap=%u, HS400=%u cap=%u, fixed1.8V; no ES/CQE\n",
++			 hs_max_hz, enable_hs200, hs200_max_hz, enable_hs400, hs400_max_hz);
++		return 0;
++	}
++destroy_workqueue:
++	destroy_workqueue(host->workqueue);
++free_desc:
++	if (!host->dma_dead)
++		dma_free_coherent(&pdev->dev, sizeof(*host->desc) * T736_DMA_DESCS,
++				  host->desc, host->desc_dma);
++free_buffer:
++	if (!host->dma_dead)
++		dma_free_noncoherent(&pdev->dev, MAX_REQUEST_BYTES, host->buffer,
++				     host->buffer_dma, DMA_BIDIRECTIONAL);
++free_host:
++	mmc_free_host(mmc);
++	return ret;
++}
++
++static void t736_remove(struct platform_device *pdev)
++{
++	struct mmc_host *mmc = platform_get_drvdata(pdev);
++	struct t736_host *host = mmc_priv(mmc);
++
++	debugfs_remove_recursive(host->timing_debugfs);
++	mmc_remove_host(mmc);
++	cancel_work_sync(&host->work);
++	destroy_workqueue(host->workqueue);
++	if (!host->dma_dead && !t736_dma_stop(host)) {
++		dma_free_coherent(&pdev->dev, sizeof(*host->desc) * T736_DMA_DESCS,
++				  host->desc, host->desc_dma);
++		dma_free_noncoherent(&pdev->dev, MAX_REQUEST_BYTES, host->buffer,
++				     host->buffer_dma, DMA_BIDIRECTIONAL);
++	}
++	mmc_free_host(mmc);
++}
++
++static const struct of_device_id t736_match[] = {
++	{ .compatible = "allwinner,t736-smhc3-pio" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, t736_match);
++
++static struct platform_driver t736_driver = {
++	.probe = t736_probe,
++	.remove = t736_remove,
++	.driver = { .name = "t736-smhc3-pio", .of_match_table = t736_match },
++};
++module_platform_driver(t736_driver);
++MODULE_DESCRIPTION("T736 SMHC3 v26: cacheable noncoherent payload, coherent descriptors, HS400 timings");
++MODULE_LICENSE("GPL");
+diff --git a/drivers/mmc/host/t736_mmc_timing_stats_draft.h b/drivers/mmc/host/t736_mmc_timing_stats_draft.h
+new file mode 100644
+index 0000000000000000000000000000000000000000..08b3507d4891c19cb30a86ac1d905ac61e54b481
+--- /dev/null
++++ b/drivers/mmc/host/t736_mmc_timing_stats_draft.h
+@@ -0,0 +1,126 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++/* Bounded aggregate diagnostics. Caller supplies u64/u32/bool types. */
++#ifndef T736_MMC_TIMING_STATS_DRAFT_H
++#define T736_MMC_TIMING_STATS_DRAFT_H
++
++#define T736_DIAG_CPU_COUNT 8
++#define T736_DIAG_CPU_BUCKETS (T736_DIAG_CPU_COUNT + 1)
++#define T736_DIAG_MAX_EVENTS 32
++
++enum t736_diag_segment {
++	T736_DIAG_DISPATCH,
++	T736_DIAG_SERVICE,
++	T736_DIAG_DMA_START,
++	T736_DIAG_PRE_RESET,
++	T736_DIAG_WRITE_COPY,
++	T736_DIAG_COMMAND_WAIT,
++	T736_DIAG_BUSY_WAIT,
++	T736_DIAG_POST_RESET,
++	T736_DIAG_READ_COPY,
++	T736_DIAG_COMPLETION,
++	T736_DIAG_WORKER_TOTAL,
++	T736_DIAG_SEGMENTS
++};
++
++struct t736_diag_mark { u64 ns; u32 cpu; };
++struct t736_diag_event {
++	u64 ns;
++	u32 segment, cpu_start, cpu_end;
++};
++struct t736_diag_sample {
++	struct t736_diag_event events[T736_DIAG_MAX_EVENTS];
++	u32 nr_events, overflow;
++	u64 requested_bytes, completed_bytes, poll_iterations, poll_sleeps;
++	bool write, success;
++};
++struct t736_diag_cpu_stats {
++	u64 starts, ends, same_endpoints, same_endpoint_ns;
++};
++struct t736_diag_segment_stats {
++	u64 calls, total_ns, max_ns, different_endpoints, different_endpoint_ns;
++	struct t736_diag_cpu_stats cpu[T736_DIAG_CPU_BUCKETS];
++};
++struct t736_diag_direction_stats {
++	u64 requests, successes, failures, requested_bytes, completed_bytes;
++	u64 size_bins[4], poll_iterations, poll_sleeps;
++	struct t736_diag_segment_stats segments[T736_DIAG_SEGMENTS];
++};
++struct t736_diag_stats {
++	u64 complete_samples, incomplete_samples, dropped_events;
++	struct t736_diag_direction_stats direction[2];
++};
++
++static inline void t736_diag_append(struct t736_diag_sample *s,
++				   enum t736_diag_segment segment,
++				   struct t736_diag_mark start,
++				   struct t736_diag_mark end)
++{
++	struct t736_diag_event *e;
++
++	if (s->nr_events >= T736_DIAG_MAX_EVENTS || end.ns < start.ns ||
++	    (unsigned int)segment >= T736_DIAG_SEGMENTS) {
++		s->overflow++;
++		return;
++	}
++	e = &s->events[s->nr_events++];
++	e->ns = end.ns - start.ns;
++	e->segment = segment;
++	e->cpu_start = start.cpu;
++	e->cpu_end = end.cpu;
++}
++
++static inline unsigned int t736_diag_cpu_bucket(unsigned int cpu)
++{
++	return cpu < T736_DIAG_CPU_COUNT ? cpu : T736_DIAG_CPU_COUNT;
++}
++
++/* Only complete samples enter totals. An overflow is visible and drops the
++ * entire request, so partial segment totals cannot masquerade as a sample.
++ */
++static inline void t736_diag_merge(struct t736_diag_stats *stats,
++				  const struct t736_diag_sample *s)
++{
++	struct t736_diag_direction_stats *d;
++	unsigned int i, bin;
++
++	if (s->overflow) {
++		stats->incomplete_samples++;
++		stats->dropped_events += s->overflow;
++		return;
++	}
++	stats->complete_samples++;
++	d = &stats->direction[s->write ? 1 : 0];
++	d->requests++;
++	d->successes += s->success;
++	d->failures += !s->success;
++	d->requested_bytes += s->requested_bytes;
++	d->completed_bytes += s->completed_bytes;
++	bin = s->requested_bytes <= 4096 ? 0 :
++	      s->requested_bytes <= 16384 ? 1 :
++	      s->requested_bytes <= 65536 ? 2 : 3;
++	d->size_bins[bin]++;
++	d->poll_iterations += s->poll_iterations;
++	d->poll_sleeps += s->poll_sleeps;
++	for (i = 0; i < s->nr_events; i++) {
++		const struct t736_diag_event *e = &s->events[i];
++		struct t736_diag_segment_stats *g = &d->segments[e->segment];
++		unsigned int a = t736_diag_cpu_bucket(e->cpu_start);
++		unsigned int b = t736_diag_cpu_bucket(e->cpu_end);
++
++		g->calls++;
++		g->total_ns += e->ns;
++		if (e->ns > g->max_ns)
++			g->max_ns = e->ns;
++		g->cpu[a].starts++;
++		g->cpu[b].ends++;
++		/* Compare real CPU IDs, not the shared out-of-range bucket. */
++		if (e->cpu_start == e->cpu_end) {
++			g->cpu[a].same_endpoints++;
++			g->cpu[a].same_endpoint_ns += e->ns;
++		} else {
++			g->different_endpoints++;
++			g->different_endpoint_ns += e->ns;
++		}
++	}
++}
++#endif
+diff --git a/drivers/mmc/host/t736_mmc_tuning_draft.h b/drivers/mmc/host/t736_mmc_tuning_draft.h
+new file mode 100644
+index 0000000000000000000000000000000000000000..ba59f291b42be286e8ce4b65e45d0dc868dd042d
+--- /dev/null
++++ b/drivers/mmc/host/t736_mmc_tuning_draft.h
+@@ -0,0 +1,53 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++#ifndef T736_MMC_TUNING_DRAFT_H
++#define T736_MMC_TUNING_DRAFT_H
++
++#define T736_TUNING_TAPS 64
++/* Match the actual T736 Tina tuning policy, with explicit failure reporting. */
++#define T736_TUNING_MIN_WINDOW 12
++#define T736_TUNING_TRIALS 20
++
++struct t736_tuning_window {
++	unsigned int first, count, tap;
++};
++
++/* SAMP_DL is a physical delay chain. There is no evidence that tap63 wraps
++ * continuously to tap0; do not join the two end windows into a false eye.
++ */
++static inline int t736_tuning_select(u64 passing, struct t736_tuning_window *w)
++{
++	unsigned int first = 0, count = 0, i;
++
++	w->first = w->count = w->tap = 0;
++	for (i = 0; i <= T736_TUNING_TAPS; i++) {
++		if (i < T736_TUNING_TAPS && (passing & (1ULL << i))) {
++			if (!count)
++				first = i;
++			count++;
++		} else {
++			if (count > w->count) {
++				w->first = first;
++				w->count = count;
++			}
++			count = 0;
++		}
++	}
++	if (w->count < T736_TUNING_MIN_WINDOW)
++		return -EIO;
++	w->tap = w->first + (w->count - 1) / 2;
++	return 0;
++}
++
++/* Actual board sdc_tm4_sm3_freq0=2020ffff/freq1=ffff3128. These are
++ * initialization seeds only; a seed never substitutes for CMD21 validation.
++ */
++static inline unsigned int t736_hs200_seed(u32 card_hz)
++{
++	if (card_hz <= 25000000)
++		return 0;
++	if (card_hz <= 100000000)
++		return 32;
++	return card_hz <= 150000000 ? 40 : 49;
++}
++
++#endif
+diff --git a/drivers/mmc/host/t736_mmc_tuning_error_draft.h b/drivers/mmc/host/t736_mmc_tuning_error_draft.h
+new file mode 100644
+index 0000000000000000000000000000000000000000..cdbd850a107f100c48332683790ed0a4258c519e
+--- /dev/null
++++ b/drivers/mmc/host/t736_mmc_tuning_error_draft.h
+@@ -0,0 +1,48 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++/* CMD21-only recovery classification; normal data error handling is unchanged. */
++#ifndef T736_MMC_TUNING_ERROR_DRAFT_H
++#define T736_MMC_TUNING_ERROR_DRAFT_H
++
++/* A733 SMHC3 11.3.9.28: IDST[5] is Card Error Summary, the OR of
++ * RINT EBE/RTO/RCRC/SBE/DRTO/DCRC/RE. It is not a DMA engine failure.
++ */
++#define T736_TUNING_CARD_ERRORS (BIT(15) | BIT(13) | BIT(9) | BIT(8) | \
++				 BIT(7) | BIT(6) | BIT(1))
++#define T736_TUNING_IDST_ALLOWED (BIT(8) | BIT(5) | BIT(1))
++
++static inline bool t736_tuning_idst_invalid(u32 idst)
++{
++	return idst & ~T736_TUNING_IDST_ALLOWED;
++}
++
++static inline bool t736_tuning_error_recoverable(int error, u32 irq, u32 idst)
++{
++	u32 card_errors = irq & T736_TUNING_CARD_ERRORS;
++
++	/* Descriptor unavailable, unexpected TX, reserved/fatal-bus bits and
++	 * every unknown IDST bit fail closed. No new interrupt bits are enabled.
++	 */
++	if (t736_tuning_idst_invalid(idst))
++		return false;
++	/* FIFO/illegal-command/starvation/write-busy errors are not bad taps. */
++	if ((irq & T736_IRQ_ERRORS) & ~T736_TUNING_CARD_ERRORS)
++		return false;
++	/* A summary without its matching raw card error is not explained. */
++	if ((idst & BIT(5)) && !card_errors)
++		return false;
++	if (error == -EILSEQ)
++		return card_errors != 0;
++	if (error == -ETIMEDOUT)
++		return true; /* Includes a software timeout with no latched RINT. */
++	/* mmc_send_tuning returns EIO for a complete but mismatched pattern.
++	 * Require both controller completions and RX completion before treating
