+++ b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_broker.c
@@ -0,0 +1,343 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded experimental Cedar broker. One hardware lease and one retained
+ * codec/size context. The v27 kernel quarantines imported DMA until reboot;
+ * keeping the pipelines alive avoids repeated allocation on every tab/video.
+ */
+#define _GNU_SOURCE
+#include "cedar_protocol.h"
+#include "cedar_backend.h"
+#include "cedar_shm.h"
+#include <errno.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+/* Older installed backends provide only cedar_pull and its owned frame. */
+#pragma weak cedar_pull_into
+
+struct retained {
+    cedar_decoder *decoder;
+    unsigned codec, width, height;
+    uint32_t lease;
+    int owner, failed;
+};
+#define CONTEXT_COUNT 1U
+static struct retained contexts[CONTEXT_COUNT];
+static pthread_mutex_t hardware_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t peers_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t next_lease;
+static unsigned peers;
+static uid_t allowed_uid;
+static int poisoned;
+static unsigned long long submitted, delivered;
+
+static int backend_result(int result)
+{
+    if (result == CEDAR_BACKPRESSURE) return -EAGAIN;
+    if (result == CEDAR_ERROR) return -EIO;
+    return result;
+}
+
+static int io_all(int fd, void *buf, size_t size, int writing)
+{
+    unsigned char *p = buf;
+    while (size) {
+        ssize_t n = writing ? send(fd, p, size, MSG_NOSIGNAL) : recv(fd, p, size, 0);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return n ? -errno : -EPIPE;
+        p += n; size -= (size_t)n;
+    }
+    return 0;
+}
+
+static struct retained *lookup(uint32_t lease, int owner)
+{
+    for (unsigned i = 0; i < CONTEXT_COUNT; ++i)
+        if (lease && contexts[i].lease == lease && contexts[i].owner == owner)
+            return &contexts[i];
+    return NULL;
+}
+
+static int open_context(int owner, const struct t736_open *args, uint32_t *lease)
+{
+    if (poisoned) return -EIO;
+    if ((args->codec != T736_CODEC_H264 && args->codec != T736_CODEC_HEVC) ||
+        !args->width || !args->height || args->width > T736_MAX_WIDTH ||
+        args->height > T736_MAX_HEIGHT || ((args->width | args->height) & 1) || args->reserved)
+        return -EINVAL;
+    struct retained *slot = NULL;
+    for (unsigned i = 0; i < CONTEXT_COUNT; ++i) {
+        if (contexts[i].lease) return -EBUSY;
+        if (contexts[i].decoder && contexts[i].codec == args->codec &&
+            contexts[i].width == args->width && contexts[i].height == args->height)
+            slot = &contexts[i];
+    }
+    if (!slot) {
+        for (unsigned i = 0; i < CONTEXT_COUNT; ++i)
+            if (!contexts[i].decoder && !contexts[i].failed) { slot = &contexts[i]; break; }
+        if (!slot) return -ENOSPC;
+        char error[512] = {0};
+        slot->decoder = cedar_open(args->codec, args->width, args->height, error, sizeof(error));
+        if (!slot->decoder) {
+            slot->failed = 1;
+            fprintf(stderr, "CEDAR_BROKER: init failed: %s\n", error);
+            return -EIO;
+        }
+        slot->codec = args->codec; slot->width = args->width; slot->height = args->height;
+    } else {
+        if (slot->failed) return -EIO;
+        int ret = backend_result(cedar_resume(slot->decoder));
+        if (ret < 0) { slot->failed = 1; return ret; }
+    }
+    if (++next_lease > INT_MAX) { poisoned = 1; return -EOVERFLOW; }
+    slot->lease = next_lease; slot->owner = owner; *lease = next_lease;
+    fprintf(stderr, "CEDAR_BROKER: open session=%u codec=%u %ux%u\n",
+            *lease, args->codec, args->width, args->height);
+    return 0;
+}
+
+static int64_t us_to_ns(int64_t value)
+{
+    if (value == INT64_MIN) return INT64_MIN;
+    return value * 1000;
+}
+
+static int valid_time(int64_t value)
+{
+    return value == INT64_MIN || (value >= 0 && value <= INT64_MAX / 1000);
+}
+
+static int execute(int fd, struct t736_message *message, unsigned char *body,
+                   struct t736_picture *picture, cedar_frame *frame, uint8_t *pixels)
+{
+    unsigned length = message->length;
+    message->length = 0;
+    if (message->operation == T736_OPEN) {
+        if (length != sizeof(struct t736_open) || message->session) return -EINVAL;
+        return open_context(fd, (const struct t736_open *)body, &message->session);
+    }
+    struct retained *slot = lookup(message->session, fd);
+    if (!slot) return message->operation == T736_CLOSE && !length ? 0 : -ESTALE;
+    if (message->operation == T736_CLOSE) {
+        if (length) return -EINVAL;
+        fprintf(stderr, "CEDAR_BROKER: close session=%u submitted=%llu delivered=%llu\n",
+                slot->lease, submitted, delivered);
+        int ret = backend_result(cedar_idle(slot->decoder));
+        if (ret < 0) { slot->failed = 1; poisoned = 1; }
+        slot->lease = 0; slot->owner = -1;
+        return ret;
+    }
+    if (poisoned || slot->failed) return -EIO;
+    int result;
+    switch (message->operation) {
+    case T736_PUSH: {
+        if (length <= sizeof(struct t736_packet) || length > T736_MAX_PACKET + sizeof(struct t736_packet))
+            return -EINVAL;
+        struct t736_packet *packet = (struct t736_packet *)body;
+        if (!valid_time(packet->pts_us) || !valid_time(packet->dts_us)) return -EINVAL;
+        result = cedar_push(slot->decoder, body + sizeof(*packet), length - sizeof(*packet),
+                            us_to_ns(packet->pts_us), us_to_ns(packet->dts_us));
+        if (!result) submitted++;
+        break;
+    }
+    case T736_PULL: {
+        if (length != sizeof(struct t736_pull)) return -EINVAL;
+        struct t736_pull *args = (struct t736_pull *)body;
+        if (args->capacity > T736_MAX_FRAME || args->timeout_ms > 1000) return -EINVAL;
+        if (args->capacity < slot->width * slot->height * 3U / 2U) return -ENOSPC;
+        if (cedar_pull_into)
+            result = cedar_pull_into(slot->decoder, pixels, args->capacity, frame, args->timeout_ms);
+        else
+            result = cedar_pull(slot->decoder, frame, args->timeout_ms);
+        if (result == 1) {
+            if ((cedar_pull_into ? frame->data != NULL : frame->data == NULL) ||
+                !frame->width || !frame->height ||
+                frame->width > T736_MAX_WIDTH || frame->height > T736_MAX_HEIGHT ||
+                ((frame->width | frame->height) & 1) ||
+                frame->size != (size_t)frame->width * frame->height * 3 / 2 ||
+                frame->size > args->capacity) {
+                cedar_frame_free(frame); slot->failed = 1; return -EOVERFLOW;
+            }
+            *picture = (struct t736_picture){ .width = frame->width, .height = frame->height,
+                .bytes = (uint32_t)frame->size, .color_range = frame->color_range,
+                .colorspace = frame->color_matrix == 1 ? 1 :
+                              frame->color_matrix == 2 ? 6 :
+                              frame->color_matrix == 3 ? 9 : 0,
+                .pts_us = frame->pts_ns == INT64_MIN ? INT64_MIN : frame->pts_ns / 1000 };
+            message->length = sizeof(*picture);
+            delivered++;
+            if (delivered == 1 || delivered % 300 == 0)
+                fprintf(stderr, "CEDAR_BROKER: hardware frames=%llu session=%u visible=%ux%u\n",
+                        delivered, slot->lease, picture->width, picture->height);
+        }
+        break;
+    }
+    case T736_DRAIN:
+        if (length) return -EINVAL;
+        result = cedar_eos(slot->decoder);
+        break;
+    case T736_FLUSH:
+        if (length) return -EINVAL;
+        result = cedar_flush(slot->decoder);
+        break;
+    default: return -ENOSYS;
+    }
+    result = backend_result(result);
+    if (result < 0 && result != -EAGAIN && result != -EINVAL) {
+        slot->failed = 1;
+        poisoned = 1;
+        fprintf(stderr, "CEDAR_BROKER: failed session=%u op=%u rc=%d detail=%s\n",
+                slot->lease, message->operation, result, cedar_error(slot->decoder));
+    }
+    return result;
+}
+
+static int setup_peer(int fd, struct t736_shm *shm)
+{
+    struct t736_message request;
+    struct { struct t736_message message; struct t736_setup setup; } response = {0};
+    struct ucred peer;
+    socklen_t size = sizeof(peer);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &size) ||
+        size != sizeof(peer) || peer.uid != allowed_uid || peer.pid <= 0) return -EACCES;
+    int received = t736_receive_descriptor(fd, &request, sizeof(request), NULL);
+    if (received < 0) return received;
+    if (request.magic != T736_MAGIC || request.version != T736_PROTOCOL_VERSION ||
+        request.operation != T736_SETUP || request.length || request.sequence != 1 ||
+        request.session || request.status || request.reserved) return -EPROTO;
+    int error = t736_shm_create(shm, &response.setup);
+    if (error) return error;
+    response.message = request;
+    response.message.length = sizeof(response.setup);
+    ssize_t sent = t736_send_descriptor(fd, shm->fd, &response, sizeof(response));
+    if (sent <= 0) return sent ? -errno : -EPIPE;
+    if ((size_t)sent < sizeof(response))
+        return io_all(fd, (uint8_t *)&response + sent, sizeof(response) - (size_t)sent, 1);
+    return 0;
+}
+
+static void *serve(void *opaque)
+{
+    int fd = (int)(intptr_t)opaque;
+    struct t736_shm shm = { .fd = -1 };
+    unsigned char *body = NULL;
+    uint32_t sequence = 1;
+    struct timeval timeout = { .tv_sec = 15 };
+    if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))) goto finish;
+    if (setup_peer(fd, &shm) < 0) goto finish;
+    body = malloc(T736_MAX_BODY);
+    if (!body) goto finish;
+    for (;;) {
+        struct pollfd pollfd = { .fd = fd, .events = POLLIN };
+        int ready;
+        do { ready = poll(&pollfd, 1, -1); } while (ready < 0 && errno == EINTR);
+        if (ready <= 0 || !(pollfd.revents & POLLIN)) break;
+        struct t736_message message;
+        if (io_all(fd, &message, sizeof(message), 0) < 0) break;
+        if (message.magic != T736_MAGIC || message.version != T736_PROTOCOL_VERSION ||
+            message.length > T736_MAX_BODY || message.reserved || message.status ||
+            sequence == UINT32_MAX || message.sequence != sequence + 1 ||
+            message.operation < T736_OPEN || message.operation > T736_CLOSE)
+            break;
+        sequence = message.sequence;
+        if (message.length && io_all(fd, body, message.length, 0) < 0) break;
+        cedar_frame frame = {0};
+        struct t736_picture picture = {0};
+        pthread_mutex_lock(&hardware_lock);
+        message.status = execute(fd, &message, body, &picture, &frame, shm.data);
+        pthread_mutex_unlock(&hardware_lock);
+        if (message.status == 1 && message.operation == T736_PULL) {
+            /* This connection has one request at a time. The client consumes
+             * the previous slot under its mutex before sending this request.
+             * Every peer gets a distinct memfd, never a recycled live slot. */
+            if (frame.data)
+                memcpy(shm.data, frame.data, frame.size);
+            __atomic_thread_fence(__ATOMIC_RELEASE);
+        }
+        cedar_frame_free(&frame);
+        int result = io_all(fd, &message, sizeof(message), 1);
+        if (!result && message.length) result = io_all(fd, &picture, sizeof(picture), 1);
+        if (result < 0) break;
+    }
+finish:
+    free(body);
+    t736_shm_destroy(&shm);
+    pthread_mutex_lock(&hardware_lock);
+    for (unsigned i = 0; i < CONTEXT_COUNT; ++i)
+        if (contexts[i].lease && contexts[i].owner == fd) {
+            if (cedar_idle(contexts[i].decoder) < 0) {
+                contexts[i].failed = 1; poisoned = 1;
+            }
+            contexts[i].lease = 0; contexts[i].owner = -1;
+            fprintf(stderr, "CEDAR_BROKER: peer left; context retained\n");
+        }
+    pthread_mutex_unlock(&hardware_lock);
+    close(fd);
+    pthread_mutex_lock(&peers_lock); peers--; pthread_mutex_unlock(&peers_lock);
+    return NULL;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2) { fprintf(stderr, "Usage: cedar-broker ALLOWED_NUMERIC_UID\n"); return 2; }
+    char *end;
+    unsigned long uid = strtoul(argv[1], &end, 10);
+    if (!argv[1][0] || *end || uid == 0 || uid > UINT_MAX) return 2;
+    allowed_uid = (uid_t)uid;
+    signal(SIGPIPE, SIG_IGN);
+    umask(0007);
+    int server = -1;
+    const char *listen_fds = getenv("LISTEN_FDS");
+    const char *listen_pid = getenv("LISTEN_PID");
+    if (listen_fds && !strcmp(listen_fds, "1") && listen_pid &&
+        strtoul(listen_pid, &end, 10) == (unsigned long)getpid() && !*end) {
+        /* systemd created the endpoint as root before dropping the service
+         * UID.  The client can therefore authenticate the path without
+         * trusting a writable RuntimeDirectory. */
+        server = 3;
+        int flags = fcntl(server, F_GETFD);
+        if (flags < 0 || fcntl(server, F_SETFD, flags | FD_CLOEXEC) < 0) {
+            perror("cedar-broker inherited socket"); return 1;
+        }
+    } else {
+        server = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        struct sockaddr_un address = { .sun_family = AF_UNIX };
+        strcpy(address.sun_path, T736_SOCKET_PATH);
+        /* Never replace an existing service socket or arbitrary path. */
+        if (server < 0 || bind(server, (struct sockaddr *)&address, sizeof(address)) || listen(server, 8)) {
+            perror("cedar-broker socket"); return 1;
+        }
+    }
+    fprintf(stderr, "CEDAR_BROKER: ready uid=%lu protocol=%u readonly-memfd max=4K8bit retained_contexts=1 output=%s\n",
+            uid, T736_PROTOCOL_VERSION, cedar_pull_into ? "direct-slot" : "owned-frame");
+    for (;;) {
+        int fd = accept4(server, NULL, NULL, SOCK_CLOEXEC);
+        if (fd < 0) { if (errno == EINTR) continue; perror("accept"); break; }
+        struct ucred peer;
+        socklen_t size = sizeof(peer);
+        if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &size) || peer.uid != allowed_uid) {
+            close(fd); continue;
+        }
+        pthread_mutex_lock(&peers_lock);
+        if (peers >= 8) { pthread_mutex_unlock(&peers_lock); close(fd); continue; }
+        peers++;
+        pthread_mutex_unlock(&peers_lock);
+        pthread_t thread;
+        int error = pthread_create(&thread, NULL, serve, (void *)(intptr_t)fd);
+        if (error) {
+            close(fd);
+            pthread_mutex_lock(&peers_lock); peers--; pthread_mutex_unlock(&peers_lock);
+        } else pthread_detach(thread);
+    }
+    return 1;
+}
diff --git a/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_client.c b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_client.c
new file mode 100644
index 0000000000000000000000000000000000000000..47e10b78635d498c2234152b06fbb7f9b75046cf
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_client.c
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: MIT */
+#define _GNU_SOURCE
+#include "cedar_protocol.h"
+#include "cedar_shm.h"
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <pthread.h>
+#include <pwd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static int connection = -1;
+static uint32_t serial_number;
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static int trace;
+static unsigned trace_push, trace_pull;
+static const uint8_t *shared_pixels;
+static pid_t connected_pid;
+static uint32_t active_session, active_width, active_height;
+
+static void disconnect_client(void)
+{
+    if (shared_pixels && connected_pid == getpid())
+        munmap((void *)shared_pixels, T736_MAX_FRAME);
+    shared_pixels = NULL;
+    if (connection >= 0) close(connection);
+    connection = -1;
+    active_session = active_width = active_height = 0;
+}
+
+static int current_process(void)
+{
+    /* DONTFORK removes the mapping in a fork child. Check before taking a
+     * possibly inherited locked pthread mutex; never reconnect in sandbox. */
+    return !connected_pid || connected_pid == getpid();
+}
+
+static int transfer(void *buf, size_t size, int sending)
+{
+    unsigned char *p = buf;
+    while (size) {
+        ssize_t n = sending ? send(connection, p, size, MSG_NOSIGNAL)
+                            : recv(connection, p, size, 0);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) {
+            int result = n ? -errno : -EPIPE;
+            disconnect_client();
+            return result;
+        }
+        p += n;
+        size -= (size_t)n;
+    }
+    return 0;
+}
+
+static int setup_connection(int fd, uid_t listener_uid, uid_t memory_uid)
+{
+    struct ucred peer;
+    socklen_t length = sizeof(peer);
+    struct t736_message request = { T736_MAGIC, T736_PROTOCOL_VERSION, T736_SETUP,
+        0, 1, 0, 0, 0 };
+    struct { struct t736_message message; struct t736_setup setup; } response;
+    int descriptor = -1, error;
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &length) ||
+        length != sizeof(peer) || !t736_uid_matches(peer.uid, listener_uid) ||
+        peer.pid <= 0) {
+        close(fd); return -EACCES;
+    }
+    connection = fd;
+    connected_pid = getpid();
+    error = transfer(&request, sizeof(request), 1);
+    if (!error) error = t736_receive_descriptor(fd, &response, sizeof(response), &descriptor);
+    if (!error && (response.message.magic != T736_MAGIC ||
+        response.message.version != T736_PROTOCOL_VERSION ||
+        response.message.operation != T736_SETUP || response.message.length != sizeof(response.setup) ||
+        response.message.sequence != 1 || response.message.session ||
+        response.message.status || response.message.reserved)) error = -EPROTO;
+    if (!error) error = t736_shm_map_receiver(descriptor, &response.setup, memory_uid, &shared_pixels);
+    if (descriptor >= 0) close(descriptor);
+    if (error) { disconnect_client(); return error; }
+    serial_number = 1;
+    return 0;
+}
+
+static int is_native_player(void)
+{
+    static const char player[] = "/opt/atlasa1-player/bin/ffplay";
+    char path[sizeof(player)];
+    struct stat executable;
+    if (!getuid() || getuid() != geteuid())
+        return 0;
+    ssize_t length = readlink("/proc/self/exe", path, sizeof(path));
+    return length == (ssize_t)sizeof(player)-1 && !memcmp(path, player, sizeof(player)-1) &&
+           !stat("/proc/self/exe", &executable) && S_ISREG(executable.st_mode) &&
+           executable.st_uid == 0 && !(executable.st_mode & (S_IWGRP | S_IWOTH));
+}
+
+/* glibc invokes init-array functions with the original process arguments.
+ * Firefox's forkserver must be disabled by the isolated launcher, so RDD has
+ * its own exec and constructor. Browser/content/utility processes never connect.
+ */
+__attribute__((constructor)) static void preconnect(int argc, char **argv,
+                                                    char **envp)
+{
+    (void)envp;
+    const char *enabled = getenv("T736_CEDAR_ENABLE");
+    const char *test = getenv("T736_CEDAR_TEST_CLIENT");
+    const char *native = getenv("T736_CEDAR_NATIVE_PLAYER");
+    const char *trace_env = getenv("T736_CEDAR_TRACE");
+    trace = trace_env && !strcmp(trace_env, "1");
+    int rdd = argc > 1 && !strcmp(argv[argc - 1], "rdd");
+    if (!enabled || strcmp(enabled, "1")) return;
+    if (native && !strcmp(native, "1")) {
+        if (!is_native_player()) return;
+    } else if (!rdd && (!test || strcmp(test, "1"))) {
+        return;
+    }
+    struct sockaddr_un address = { .sun_family = AF_UNIX };
+    struct timeval deadline = { .tv_sec = 15 };
+    struct passwd account, *resolved = NULL;
+    char account_buffer[16384];
+    if (getpwnam_r("t736-cedar", &account, account_buffer, sizeof(account_buffer), &resolved) ||
+        !resolved || account.pw_uid == 0 || account.pw_uid == getuid()) return;
+    struct stat directory, endpoint;
+    /* The endpoint is created by a root-owned systemd socket unit.  Requiring
+     * root ownership and a non-writable 0755 directory prevents a service-UID
+     * process from replacing the endpoint before SO_PEERCRED is checked. */
+    if (lstat("/run/t736-cedar", &directory) || !S_ISDIR(directory.st_mode) ||
+        !t736_uid_matches(directory.st_uid, 0) ||
+        (directory.st_mode & 0777) != 0755 ||
+        lstat(T736_SOCKET_PATH, &endpoint) || !S_ISSOCK(endpoint.st_mode) ||
+        !t736_uid_matches(endpoint.st_uid, 0) ||
+        (endpoint.st_mode & 0777) != 0660) return;
+    strcpy(address.sun_path, T736_SOCKET_PATH);
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return;
+    if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &deadline, sizeof(deadline)) ||
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &deadline, sizeof(deadline)) ||
+        connect(fd, (struct sockaddr *)&address, sizeof(address))) {
+        close(fd);
+        return;
+    }
+    /* systemd owns the listener. The service running as t736-cedar
+     * creates and seals the frame memfd after it accepts this connection. */
+    if (setup_connection(fd, 0, account.pw_uid)) return;
+    fprintf(stderr, "T736_CEDAR_CLIENT: preconnected protocol=2 readonly-memfd pid=%ld rdd=%d\n",
+            (long)getpid(), rdd);
+}
+
+__attribute__((destructor)) static void client_exit(void)
+{
+    disconnect_client();
+}
+
+int t736_client_available(void)
+{
+    if (!current_process()) return 0;
+    pthread_mutex_lock(&lock);
+    int available = connection >= 0 && shared_pixels;
+    pthread_mutex_unlock(&lock);
+    return available;
+}
+
+static int request(unsigned op, int session, const void *prefix, size_t prefix_n,
+                   const void *data, size_t data_n, struct t736_message *reply)
+{
+    if (connection < 0 || !shared_pixels) return -ENOTCONN;
+    if (prefix_n + data_n > T736_MAX_BODY) return -E2BIG;
+    if (serial_number == UINT32_MAX) { disconnect_client(); return -EOVERFLOW; }
+    struct t736_message message = { T736_MAGIC, T736_PROTOCOL_VERSION, op,
+        (uint32_t)(prefix_n + data_n), ++serial_number, (uint32_t)session, 0, 0 };
+    int error = transfer(&message, sizeof(message), 1);
+    if (!error && prefix_n) error = transfer((void *)prefix, prefix_n, 1);
+    if (!error && data_n) error = transfer((void *)data, data_n, 1);
+    if (!error) error = transfer(reply, sizeof(*reply), 0);
+    if (error) return error;
+    if (reply->magic != T736_MAGIC || reply->version != T736_PROTOCOL_VERSION ||
+        reply->operation != op || reply->sequence != message.sequence ||
+        reply->reserved || reply->length > sizeof(struct t736_picture) ||
+        reply->status < -4095 ||
+        (op != T736_OPEN && reply->session != message.session)) {
+        disconnect_client();
+        return -EPROTO;
+    }
+    return 0;
+}
+
+static int simple(unsigned op, int session, const void *prefix, size_t prefix_n,
+                  const void *data, size_t data_n)
+{
+    struct t736_message reply;
+    if (!current_process()) return -ENOTCONN;
+    pthread_mutex_lock(&lock);
+    int error = request(op, session, prefix, prefix_n, data, data_n, &reply);
+    if (!error && (reply.length || reply.status > 0 ||
+        (op == T736_OPEN && (reply.status ? reply.session != 0 :
+                            (!reply.session || reply.session > INT_MAX))))) {
+        disconnect_client(); error = -EPROTO;
+    }
+    if (!error) error = reply.status;
+    if (!error && op == T736_OPEN) {
+        const struct t736_open *args = prefix;
+        active_session = reply.session; active_width = args->width; active_height = args->height;
+        error = (int)reply.session;
+    }
+    if (!error && op == T736_CLOSE && (uint32_t)session == active_session)
+        active_session = active_width = active_height = 0;
+    pthread_mutex_unlock(&lock);
+    return error;
+}
+
+int t736_client_open(int codec, unsigned width, unsigned height)
+{
+    if ((codec != T736_CODEC_H264 && codec != T736_CODEC_HEVC) ||
+        !width || !height || width > T736_MAX_WIDTH || height > T736_MAX_HEIGHT ||
+        ((width | height) & 1)) return -EINVAL;
+    struct t736_open args = { (uint32_t)codec, width, height, 0 };
+    return simple(T736_OPEN, 0, &args, sizeof(args), NULL, 0);
+}
+
+int t736_client_push(int session, const uint8_t *data, size_t size,
+                     int64_t pts_us, int64_t dts_us)
+{
+    if (session <= 0 || !data || !size || size > T736_MAX_PACKET) return -EINVAL;
+    struct t736_packet args = { pts_us, dts_us };
+    int ret = simple(T736_PUSH, session, &args, sizeof(args), data, size);
+    if (!ret && trace && ++trace_push <= 24)
+        fprintf(stderr, "CEDAR_TRACE push=%u session=%d bytes=%zu pts=%" PRId64 " dts=%" PRId64 "\n",
+                trace_push, session, size, pts_us, dts_us);
+    return ret;
+}
+
+int t736_client_pull(int session, uint8_t *dst, size_t capacity,
+                     struct t736_frame *frame, unsigned timeout_ms)
+{
+    if (session <= 0 || !dst || !frame || capacity > T736_MAX_FRAME || timeout_ms > 1000)
+        return -EINVAL;
+    if (!current_process()) return -ENOTCONN;
+    struct t736_pull args = { (uint32_t)capacity, timeout_ms };
+    struct t736_message reply;
+    struct t736_picture picture;
+    pthread_mutex_lock(&lock);
+    int error = request(T736_PULL, session, &args, sizeof(args), NULL, 0, &reply);
+    if (error) goto done;
+    if (reply.status != 1) {
+        if (reply.length || reply.status > 2) goto malformed;
+        error = reply.status;
+        goto done;
+    }
+    if (reply.length != sizeof(picture)) goto malformed;
+    error = transfer(&picture, sizeof(picture), 0);
+    if (error) goto done;
+    if (!picture.width || !picture.height || picture.width > T736_MAX_WIDTH ||
+        picture.height > T736_MAX_HEIGHT || ((picture.width | picture.height) & 1) ||
+        picture.bytes != picture.width * picture.height * 3 / 2 ||
+        picture.bytes > capacity || picture.bytes > T736_MAX_FRAME ||
+        (uint32_t)session != active_session || picture.width != active_width ||
+        picture.height != active_height || picture.color_range > 2 ||
+        (picture.colorspace != 0 && picture.colorspace != 1 && picture.colorspace != 6 && picture.colorspace != 9) ||
+        picture.reserved) goto malformed;
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    memcpy(dst, shared_pixels, picture.bytes);
+    {
+        frame->width = picture.width; frame->height = picture.height;
+        frame->bytes_written = picture.bytes; frame->pts_us = picture.pts_us;
+        frame->color_range = picture.color_range; frame->colorspace = picture.colorspace;
+        if (trace && ++trace_pull <= 24)
+            fprintf(stderr, "CEDAR_TRACE pull=%u session=%d pts=%" PRId64 " %ux%u\n",
+                    trace_pull, session, frame->pts_us, frame->width, frame->height);
+        error = 1;
+    }
+    goto done;
+malformed:
+    disconnect_client(); error = -EPROTO;
+done:
+    pthread_mutex_unlock(&lock);
+    return error;
+}
+
+int t736_client_drain(int session) { return simple(T736_DRAIN, session, NULL, 0, NULL, 0); }
+int t736_client_flush(int session) { return simple(T736_FLUSH, session, NULL, 0, NULL, 0); }
+int t736_client_close(int session)
+{
+    if (session <= 0) return 0;
+    return simple(T736_CLOSE, session, NULL, 0, NULL, 0);
+}
