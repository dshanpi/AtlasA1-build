++		}
++	}
++	seq_printf(seq, "cpu_bucket_%u=other;dispatch_crosses_submitter_and_worker_context;worker_segment_different_means_at_least_one_migration;same_does_not_exclude_migration\n", T736_DIAG_CPU_COUNT);
++	return 0;
++}
