++static int t736_hs400_abort_read(struct mmc_host *mmc)
++{
++	struct mmc_command cmd = {
++		.opcode = MMC_STOP_TRANSMISSION,
++		.flags = MMC_RSP_R1 | MMC_CMD_AC,
++		.busy_timeout = 150,
++	};
