+++ b/userpatches/atlasa1-release/tools/verify_atlasa1_resolute.sh
@@ -0,0 +1,56 @@
+#!/bin/bash
+# Run the release checks against a mounted Ubuntu image on AArch64 or with binfmt.
+set -euo pipefail
+if [[ ${1:-} != --private-mounts ]]; then
+    exec unshare --mount --propagation private bash "$0" --private-mounts "$@"
+fi
+shift
+root=$(realpath -e "${1:?mounted rootfs required}")
+[[ $(id -u) == 0 && "$root" != / ]]
+for path in dev proc sys run tmp; do
+    [[ -d "$root/$path" && ! -L "$root/$path" ]]
+done
+if ! mountpoint -q "$root/dev"; then
+    mount --rbind /dev "$root/dev"
+    mount --make-rslave "$root/dev"
+fi
+mountpoint -q "$root/proc" || mount -t proc proc "$root/proc"
+mountpoint -q "$root/sys" || mount -t sysfs -o ro sysfs "$root/sys"
+for path in run tmp; do
+    mountpoint -q "$root/$path" || mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs "$root/$path"
+done
+release=6.18.63-t736-media-v30
+player=/opt/atlasa1-player/bin/ffplay
+libs=/opt/atlasa1-player/lib
+target() { chroot "$root" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C HOME=/tmp "$@"; }
+grep -E '^(ID|VERSION_ID|VERSION_CODENAME)=' "$root/usr/lib/os-release"
+grep -E '^(BOARD|BOARD_NAME|VERSION)=' "$root/etc/armbian-release"
+[[ $(target dpkg --print-architecture) == arm64 && ! -s "$root/etc/machine-id" ]]
+[[ -z $(find "$root/etc/ssh" -maxdepth 1 -name 'ssh_host_*_key' -print -quit) ]]
+[[ -z $(target dpkg --audit) ]]
+target dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package} ${Version}\n' \
+    "linux-image-$release" t736-img-userspace-candidate atlasa1-player \
+    armbian-bsp-cli-t736-mainline-current xfce4-session lightdm gnome-shell gdm3 firefox ffmpeg
+target ffmpeg -version | sed -n '1p'
+target gnome-shell --version
+firefox_version=$(target dpkg-query -W -f='${Version}' firefox)
+[[ "$firefox_version" != *snap* ]]
+[[ -e "$root/usr/lib/firefox/firefox" || -e "$root/opt/firefox/firefox" ]]
+[[ -r "$root/usr/share/xsessions/xfce.desktop" && -r "$root/usr/share/wayland-sessions/gnome.desktop" ]]
+[[ -r "$root/usr/share/xsessions/atlasa1-xfce.desktop" ]]
+grep -qx 'user-session=atlasa1-xfce' "$root/etc/lightdm/lightdm.conf.d/90-atlasa1-x11.conf"
+[[ $(basename "$(readlink "$root/etc/systemd/system/display-manager.service")") == lightdm.service ]]
+target systemctl is-enabled t736-cedar.socket
+target systemctl is-enabled serial-getty@ttyS0.service
+target modinfo -k "$release" -F vermagic pvrsrvkm | grep -F "$release "
+[[ -s "$root/boot/initrd.img-6.18.63-t736-armbian" ]]
+for name in vmlinuz initrd.img; do
+    [[ $(target readlink -f "/boot/$name-6.18.63-t736-armbian") == "/boot/$name-$release" ]]
+done
+lsinitramfs "$root/boot/initrd.img-6.18.63-t736-armbian" | grep -x init
+relocations=$(target env LD_LIBRARY_PATH="$libs" ldd -r "$player" 2>&1)
+if grep -Ei 'not found|undefined symbol' <<<"$relocations"; then exit 1; fi
+target env LD_LIBRARY_PATH="$libs" "$player" -hide_banner -h full 2>&1 | grep -F -- '-wait_video_start'
+target gst-inspect-1.0 --version
+bash "$(dirname "$0")/verify_atlasa1_resolute_media.sh" "$root"
+echo "AtlasA1 Ubuntu userspace checks passed"
diff --git a/userpatches/atlasa1-release/tools/verify_atlasa1_resolute_media.sh b/userpatches/atlasa1-release/tools/verify_atlasa1_resolute_media.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a8b8d2d9e91a85c553dc61cc8a957ad6e9087115
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/verify_atlasa1_resolute_media.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Run against a configured ARM64 rootfs, natively or using host binfmt/QEMU.
+set -euo pipefail
+root=$(realpath -e "${1:?expected configured rootfs directory}")
+test -f "$root/usr/share/doc/atlasa1-board/media-sha256.json"
+scratch=$(mktemp -d "$root/tmp/atlas-media-check.XXXXXXXX")
+trap 'rm -rf -- "$scratch"' EXIT
+for codec in h264 hevc; do
+    encoder=libx264
+    settings=(-threads 1)
+    if [[ $codec == hevc ]]; then encoder=libx265; settings=(-x265-params pools=none:frame-threads=1:log-level=error); fi
+    ffmpeg -nostdin -loglevel error -f lavfi -i color=c=blue:s=64x64:r=1 \
+        -frames:v 1 -c:v "$encoder" "${settings[@]}" -f "$codec" "$scratch/$codec.stream"
+done
+chroot "$root" /bin/sh -s -- "${scratch#"$root"}" <<'EOS'
+set -eu
+export LC_ALL=C
+test "$(dpkg --print-architecture)" = arm64
+test "$(id -u t736)" -ne 0
+id -Gn t736 | tr ' ' '\n' | grep -qx t736
+id t736-cedar
+test -L /etc/systemd/system/sockets.target.wants/t736-cedar.socket
+test "$(stat -c %U:%a /opt/atlasa1-player/bin/ffplay)" = root:755
+test "$(modinfo -k 6.18.63-t736-media-v30 -F vermagic pvrsrvkm | cut -d' ' -f1)" = 6.18.63-t736-media-v30
+scratch=$1
+export LD_LIBRARY_PATH=/opt/t736-cedar-browser-backend-v5:/opt/t736-cedar-wc-v5/lib
+export GST_PLUGIN_PATH_1_0=/opt/t736-cedar-wc-v5/lib/gstreamer-1.0
+export GST_OMX_CONFIG_DIR=/opt/t736-cedar-transport-v2/config
+export GST_REGISTRY_1_0="$scratch/registry.bin" GST_REGISTRY_FORK=no
+for file in /opt/t736-cedar-transport-v2/bin/cedar-broker "$GST_PLUGIN_PATH_1_0/libgstomx.so" \
+            /opt/t736-cedar-wc-v5/lib/libOmxCore.so /opt/t736-cedar-wc-v5/lib/libOmxVdec.so; do
+    ldd -r "$file" > "$scratch/ldd"
+    if grep -E 'not found|undefined symbol' "$scratch/ldd"; then exit 1; fi
+done
+for factory in h264parse h265parse capsfilter appsrc appsink omxh264dec omxhevcvideodec; do
+    gst-inspect-1.0 "$factory" > "$scratch/$factory"
+    if [ "$factory" = omxh264dec ] || [ "$factory" = omxhevcvideodec ]; then
+        grep -F "$GST_PLUGIN_PATH_1_0/libgstomx.so" "$scratch/$factory"
+    fi
+    printf 'Found %s\n' "$factory"
+done
+for format in h264 hevc; do
+    codec=$format
+    if [ "$format" = hevc ]; then codec=h265; fi
+    gst-launch-1.0 -q filesrc location="$scratch/$format.stream" ! "$codec"parse ! \
+        "video/x-$codec,stream-format=byte-stream,alignment=au,parsed=true" ! filesink location="$scratch/$format.parsed"
+    test -s "$scratch/$format.parsed"
+    printf 'Parsed %s byte-stream, %s bytes\n' "$format" "$(wc -c < "$scratch/$format.parsed")"
+done
+LD_LIBRARY_PATH=/opt/atlasa1-player/lib /opt/atlasa1-player/bin/ffplay -hide_banner -decoders > "$scratch/decoders"
+grep -w h264_cedar "$scratch/decoders"
+grep -w hevc_cedar "$scratch/decoders"
+. /opt/t736-img-ddk-24.2-x11/session.env
+LD_BIND_NOW=1 /usr/lib/xorg/Xorg -version
+ldd -r /usr/lib/xorg/Xorg > "$scratch/xorg"
+if grep -E 'not found|undefined symbol' "$scratch/xorg"; then exit 1; fi
+EOS
