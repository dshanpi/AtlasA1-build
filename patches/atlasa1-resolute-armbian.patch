+dram_tpr3 = 0x110000
+dram_tpr6 = 0x402a
+dram_tpr10 = 0x721f0000
+dram_tpr11 = 0x0
+dram_tpr12 = 0x0
+dram_tpr13 = 0x6063
+dram_tpr14 = 0x0
