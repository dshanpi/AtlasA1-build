+    "precision highp float; varying vec2 uv; uniform sampler2D yp,up,vp;"
+    "vec4 weights(float k){vec3 t=step(vec3(1.,2.,3.),vec3(k));return vec4(1.-t.x,t.x-t.y,t.y-t.z,t.z);}"
+    "void main(){vec4 yw=weights(fract(uv.x*480.)*4.);vec4 cw=weights(fract(uv.x*240.)*4.);"
+    "float y=1.16438356*(dot(texture2D(yp,uv),yw)-16./255.);"
+    "float u=dot(texture2D(up,uv),cw)-128./255.;float v=dot(texture2D(vp,uv),cw)-128./255.;"
