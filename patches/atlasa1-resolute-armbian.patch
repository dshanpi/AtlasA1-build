++	void __iomem *smc = ioremap(0x0a0000b0, 4);
++	void __iomem *gpu = ioremap(0x01880014, 4);
++
++	if (!smc || !gpu) {
++		if (smc)
++			iounmap(smc);
++		if (gpu)
++			iounmap(gpu);
++		return PVRSRV_ERROR_OUT_OF_MEMORY;
++	}
++	writel(0x2, smc);
++	writel(0x0, gpu);
++	iounmap(gpu);
++	iounmap(smc);
+ 	return PVRSRV_OK;
+ }
