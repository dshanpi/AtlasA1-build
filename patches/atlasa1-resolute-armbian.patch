+-	}
+-
+-	for (i = 0; i < sunxi_data->ui32OPPTableSize; i++) {
+-		DIPrintf(psEntry, "opp%d is %luHz---%lumV\n",
+-				  i, sunxi_data->asOPPTable[i].ui32Freq,
+-				  sunxi_data->asOPPTable[i].ui32Volt / 1000);
+-	}
+-
+-	return 0;
+-}
