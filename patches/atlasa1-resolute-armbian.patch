++	{ .compatible = "allwinner,t736-usb1-phy" }, { }
++};
++static struct platform_driver t736_phy_driver = {
++	.probe = t736_phy_probe,
++	.driver = { .name = "t736-usb1-phy", .of_match_table = t736_phy_match },
++};
