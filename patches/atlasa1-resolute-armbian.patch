+++ b/userpatches/atlasa1-release/config/clean-build/system-defaults.json
@@ -0,0 +1,5 @@
+{
+  "locale": "en_US.UTF-8",
+  "timezone": "America/New_York",
+  "note": "Defaults of the reference GNOME image; explicitly pinned instead of inherited from the build host."
+}
diff --git a/userpatches/atlasa1-release/config/gnome-wayland/50-atlasa1-wayland.conf b/userpatches/atlasa1-release/config/gnome-wayland/50-atlasa1-wayland.conf
