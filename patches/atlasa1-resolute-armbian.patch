@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# Assemble only newly compiled components and a newly bootstrapped package tree.
+set -euo pipefail
+[[ $EUID == 0 && $# == 4 ]] || { echo 'Usage (root): RECIPE COMPONENT_BUILD ROOTFS OUTPUT' >&2; exit 2; }
+recipe=$(realpath -e "$1")
+build=$(realpath -e "$2")
+root=$(realpath -e "$3")
+out=$(realpath -m "$4")
+tools="$recipe/tools"
+release=6.18.63-t736-gnome-v47
+mkdir -- "$out"
+bash "$tools/configure_atlasa1_resolute.sh" "$root" \
+    "$build/kernel/linux-image-${release}_6.18.63-47_arm64.deb" \
+    "$build/kernel/pvr-out/target_aarch64/kbuild/pvrsrvkm.ko" "$build/media" \
+    "$build/vendor/t736-img-userspace-candidate_24.2.6603887-2_arm64.deb" \
+    "$build/player/atlasa1-player_0.1-6~resolute1_arm64.deb" \
+    "$build/firefox/atlasa1-firefox-cedar_8.0.1-1.resolute1_arm64.deb"
+bash "$tools/configure_atlasa1_gnome_release.sh" "$root" \
+    "$build/wayland/atlasa1-img-wayland_24.2.6603887-3_arm64.deb"
+# Never ship the transient, build-only localhost APT repository.
+rm -f "$root/etc/apt/sources.list"
+install -d "$root/etc/apt/sources.list.d"
+cat > "$root/etc/apt/sources.list.d/ubuntu.sources" <<'EOF'
+Types: deb
+URIs: https://ports.ubuntu.com/ubuntu-ports
+Suites: resolute resolute-updates resolute-security resolute-backports
+Components: main restricted universe multiverse
+Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
+EOF
+test -s "$root/usr/share/keyrings/armbian-archive-keyring.gpg"
+cat > "$root/etc/apt/sources.list.d/armbian.sources" <<'EOF'
+Types: deb
+URIs: https://apt.armbian.com
+Suites: resolute
+Components: resolute-utils resolute-desktop
+Signed-By: /usr/share/keyrings/armbian-archive-keyring.gpg
+EOF
+if grep -R -E '127\.0\.0\.1:18765|/work/|/repo/' "$root/etc/apt/sources.list.d"; then
+    echo 'Build-only APT source leaked into rootfs' >&2; exit 1
+fi
+chroot "$root" dpkg-query -W -f='${binary:Package}\t${Version}\n' | LC_ALL=C sort > "$out/installed-packages.tsv"
+LC_ALL=C sort "$recipe/config/clean-build/packages-arm64.tsv" > "$out/expected-packages.tsv"
+diff -u "$out/expected-packages.tsv" "$out/installed-packages.tsv" > "$out/package-comparison.diff" || {
+    cat "$out/package-comparison.diff" >&2; echo 'Package versions differ from the locked board' >&2; exit 1;
+}
+bash "$tools/verify_atlasa1_resolute.sh" "$root" "$release" --require-firefox-cedar
+image="$out/Armbian_26.11_AtlasA1_Ubuntu-26.04_GNOME_clean_arm64.img"
+python3 "$tools/pack_atlasa1_resolute.py" --rootfs "$root" --boot "$build/boot/payload" --output "$image"
+xz -T4 -6 --keep "$image"
+xz -t "$image.xz"
+cd "$out"
+sha256sum "$(basename "$image")" "$(basename "$image").xz" > SHA256SUMS
+printf 'CLEAN_IMAGE_ASSEMBLY_PASSED\n'
diff --git a/userpatches/atlasa1-release/tools/atlasa1_native_image.py b/userpatches/atlasa1-release/tools/atlasa1_native_image.py
new file mode 100755
index 0000000000000000000000000000000000000000..37fbb7380f2a57c5cb134afbe844661c25ea0ddc
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/atlasa1_native_image.py
@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""Create and verify the AtlasA1 eMMC layout inside Armbian image files."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import struct
+import subprocess
+import tempfile
+import uuid
+import zlib
+
+SECTOR = 512
+SECTORS = 16777216
+ROOT_ID = 'a0085546-4166-744a-a353-fca9272b8e48'
+LAYOUT = [('boot-resource', 73728, 65536), ('env', 139264, 32768),
+          ('boot', 172032, 196608), ('rootfs', 368640, 15239680),
+          ('private', 15608320, 32768), ('UDISK', 15641088, SECTORS-15641088-34)]
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def command(*args):
+    return subprocess.check_output([str(a) for a in args], text=True).strip()
+
+
+def tables():
+    entries = bytearray()
+    for i, (name, start, size) in enumerate(LAYOUT):
+        entries.extend(struct.pack('<16s16sQQQ72s',
+            uuid.UUID('ebd0a0a2-b9e5-4433-87c0-68b6b72699c7').bytes_le,
+            uuid.UUID(f'a0085546-4166-744a-a353-fca9272b8e{0x45+i:02x}').bytes_le,
+            start, start+size-1, 1 << 63, name.encode('utf-16-le')))
+    def header(current, backup, table):
+        data = bytearray(struct.pack('<8sIIIIQQQQ16sQIII', b'EFI PART', 0x10000, 92, 0, 0,
+            current, backup, 73728, SECTORS-34, uuid.UUID('ab6f3888-569a-4926-9668-80941dcb40bc').bytes_le,
+            table, len(LAYOUT), 128, zlib.crc32(entries)))
+        struct.pack_into('<I', data, 16, zlib.crc32(data))
+        return data+bytes(SECTOR-len(data))
+    mbr = bytearray(SECTOR)
+    struct.pack_into('<B3sB3sII', mbr, 446, 0, b'\0\2\0', 0xee, b'\xff\xff\xff', 1, SECTORS-1)
+    mbr[510:] = b'\x55\xaa'
+    array = entries+bytes(-len(entries) % SECTOR)
+    return bytes(mbr)+header(1, SECTORS-1, 2)+array, array+header(SECTORS-1, 1, SECTORS-3)
+
+
+def image_file(path):
+    path = Path(path).absolute()
+    mode = path.lstat().st_mode
+    if not stat.S_ISREG(mode) or path.stat().st_size != SECTORS*SECTOR:
+        raise ValueError('Expected a regular 8 GiB image file')
+    return path
+
+
+def verify_table(path):
+    primary, backup = tables()
+    with Path(path).open('rb') as stream:
+        for offset, expected in [(0, primary), (40960*SECTOR, primary),
+                                 (SECTORS*SECTOR-len(backup), backup)]:
+            stream.seek(offset)
+            if stream.read(len(expected)) != expected:
+                raise ValueError(f'AtlasA1 GPT differs at offset {offset}')
+    parsed = json.loads(command('sfdisk', '--json', path))['partitiontable']['partitions']
+    if [(p['name'], p['start'], p['size']) for p in parsed] != LAYOUT:
+        raise ValueError('Partition map differs')
+    if parsed[3]['uuid'].lower() != ROOT_ID:
+        raise ValueError('Root PARTUUID differs')
+    command('sfdisk', '--verify', path)
+
+
+def partition(path):
+    image = image_file(path)
+    primary, backup = tables()
+    with image.open('r+b') as stream:
+        for offset, data in [(0, primary), (40960*SECTOR, primary),
+                             (SECTORS*SECTOR-len(backup), backup)]:
+            stream.seek(offset)
+            stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+    verify_table(image)
+
+
+def parse_package(data):
+    if struct.unpack_from('<IIII', data) != (0x36333754, 0x314c5053, 1, 3):
+        raise ValueError('Unexpected boot package')
+    header = bytearray(data[:512]); expected = struct.unpack_from('<I', header, 16)[0]
+    struct.pack_into('<I', header, 16, 0)
+    if zlib.crc32(header) != expected:
+        raise ValueError('Boot header CRC differs')
+    components = []
+    for i, address in enumerate((0x47000000, 0x48000000, 0x52000000)):
+        lba, load, length, crc = struct.unpack_from('<IIII', data, 32+16*i)
+        offset = (lba-24576)*512
+        if load != address or offset < 512 or length <= 0 or offset+length > len(data):
+            raise ValueError('Invalid boot component')
+        blob = data[offset:offset+length]
+        if zlib.crc32(blob) != crc:
+            raise ValueError('Boot payload CRC differs')
+        components.append(hashlib.sha256(blob).hexdigest())
+    return components
+
+
+def write_boot(device, bundle):
+    device = Path(device)
+    if not device.name.startswith('loop') or not stat.S_ISBLK(device.lstat().st_mode):
+        raise ValueError('Only an Armbian loop device is accepted')
+    row = json.loads(command('losetup', '--json', '--output', 'NAME,BACK-FILE,OFFSET,SIZELIMIT', device))['loopdevices'][0]
+    image = image_file(row['back-file'])
+    if int(row['offset']) != 0 or int(row['sizelimit']) not in (0, SECTORS*SECTOR):
+        raise ValueError('Loop does not span the whole image')
+    verify_table(image)
+    record = json.loads((bundle/'atlasa1-boot.json').read_text())
+    spl = bundle/'atlasa1-spl.bin'; package = bundle/'atlasa1-package.bin'
+    if sha(spl) != record['spl_sha256'] or sha(package) != record['boot_package_sha256']:
+        raise ValueError('Boot package checksum differs')
+    components = parse_package(package.read_bytes())
+    if components != [item['sha256'] for item in record['components']]:
+        raise ValueError('Boot components differ from the manifest')
+    if components[-1] != sha(bundle/'u-boot.bin') or record['root_partuuid'] != ROOT_ID:
+        raise ValueError('U-Boot does not match this image')
+    if spl.stat().st_size > (24576-16)*512 or package.stat().st_size > (32800-24576)*512:
+        raise ValueError('Boot data exceeds reserved sectors')
+    with device.open('r+b', buffering=0) as stream:
+        for lba, source in [(16, spl), (24576, package)]:
+            data = source.read_bytes();stream.seek(lba*512);stream.write(data)
+        os.fsync(stream.fileno())
+        for lba, source in [(16, spl), (24576, package)]:
+            data = source.read_bytes();stream.seek(lba*512)
+            if stream.read(len(data)) != data:
+                raise ValueError('Boot write readback differs')
+    verify_table(image)
+
+
+def boot_files(root):
+    releases = [p.name for p in (root/'usr/lib/modules').iterdir() if p.is_dir() and p.name.endswith('-current-atlasa1')]
+    if len(releases) != 1:
+        raise ValueError('Expected one AtlasA1 kernel')
+    release = releases[0]
+    image = root/'boot'/('vmlinuz-'+release)
+    initrd = root/'boot'/('initrd.img-'+release)
+    dtb = root/'usr/lib'/('linux-image-'+release)/'allwinner/t736-pcie-v32.dtb'
+    for path in (image, initrd, dtb):
+        if not path.is_file() or path.stat().st_size == 0:
+            raise ValueError('Missing boot file: '+str(path))
+    manifests = list((root/'usr/lib').glob('linux-u-boot-*/atlasa1-boot.json'))
+    if len(manifests) != 1:
+        raise ValueError('Expected one installed AtlasA1 boot package')
+    bundle = manifests[0].parent
+    manifest = json.loads(manifests[0].read_text())
+    payloads = {}
+    for filename, lba, key in [('atlasa1-spl.bin', 16, 'spl_sha256'),
+                               ('atlasa1-package.bin', 24576, 'boot_package_sha256')]:
+        path = bundle/filename
+        if sha(path) != manifest[key]:
+            raise ValueError('Installed boot package checksum differs')
+        payloads[filename] = {'lba': lba, 'bytes': path.stat().st_size, 'sha256': manifest[key]}
+    import gzip
+    data = image.read_bytes()
+    if data[56:60] != b'ARM\x64':
+        raise ValueError('Expected an uncompressed ARM64 Image')
+    compressed = image.with_name(image.name+'.atlasa1.gz')
+    packed = gzip.compress(data, compresslevel=6, mtime=0)
+    if len(data) > 10 * len(packed) or gzip.decompress(packed) != data:
+        raise ValueError('Image exceeds the U-Boot decompression bound or gzip verification failed')
+    compressed.write_bytes(packed)
+    aliases = {'vmlinuz-6.18.63-t736-armbian': compressed.name,
+               'initrd.img-6.18.63-t736-armbian': initrd.name}
+    for name, target in aliases.items():
+        link = root/'boot'/name
+        if link.is_symlink():link.unlink()
+        elif link.exists():raise ValueError('Boot alias is a regular file')
+        link.symlink_to(target)
+    destination = root/'boot/dtb/allwinner/t736-mainline-bringup.dtb'
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_bytes(dtb.read_bytes())
+    output = root/'usr/share/atlasa1/image-boot-files.json'
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps({'kernel_release':release, 'payloads':payloads, 'files':{
+        str(path.relative_to(root)):sha(path) for path in (compressed, initrd, destination)}},indent=2)+'\n')
+
+
+def verify(image):
+    image = image_file(image);verify_table(image)
+    loop = command('losetup', '--find', '--show', '--read-only', '--offset', 368640*512,
+                   '--sizelimit', LAYOUT[3][2]*512, image)
+    try:
+        subprocess.run(['e2fsck', '-fn', loop], check=True)
+        with tempfile.TemporaryDirectory(prefix='atlasa1-readback-') as folder:
+            folder = Path(folder);record_file = folder/'boot.json'
+            command('debugfs', '-R', f'dump /usr/share/atlasa1/image-boot-files.json {record_file}', loop)
+            record = json.loads(record_file.read_text())
+            with image.open('rb') as stream:
+                for name, payload in record['payloads'].items():
+                    stream.seek(payload['lba']*SECTOR)
+                    data = stream.read(payload['bytes'])
+                    if hashlib.sha256(data).hexdigest() != payload['sha256']:
+                        raise ValueError('Final boot payload readback differs: '+name)
+                    if name == 'atlasa1-package.bin':
+                        parse_package(data)
+            for i, (name, expected) in enumerate(record['files'].items()):
+                target = folder/str(i)
+                command('debugfs', '-R', f'dump /{name} {target}', loop)
+                if sha(target) != expected:raise ValueError('Boot file readback differs: '+name)
+    finally:
+        subprocess.run(['losetup', '-d', loop], check=True)
+    result = {'image':image.name, 'bytes':image.stat().st_size, 'sha256':sha(image),
+              'gpt':'passed', 'e2fsck':'passed', 'boot_files':record,
+              'build_framework':'official Armbian compile.sh', 'hardware_boot':'not tested'}
+    image.with_suffix('.atlasa1.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result))
+
+
+if __name__ == '__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    commands=parser.add_subparsers(dest='action',required=True)
+    for name in ('partition','verify'):
+        command_parser=commands.add_parser(name);command_parser.add_argument('--image',type=Path,required=True)
+    command_parser=commands.add_parser('boot');command_parser.add_argument('--device',type=Path,required=True);command_parser.add_argument('--bundle',type=Path,required=True)
+    command_parser=commands.add_parser('boot-files');command_parser.add_argument('--root',type=Path,required=True)
+    args=parser.parse_args()
+    if args.action=='partition':partition(args.image)
+    elif args.action=='boot':write_boot(args.device,args.bundle)
+    elif args.action=='boot-files':boot_files(args.root.resolve(strict=True))
+    else:verify(args.image)
diff --git a/userpatches/atlasa1-release/tools/browser/build_browser_ffmpeg.py b/userpatches/atlasa1-release/tools/browser/build_browser_ffmpeg.py
new file mode 100755
index 0000000000000000000000000000000000000000..b7319e52b51e9c18d4c0ceae90b2d2fa111f409b
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/browser/build_browser_ffmpeg.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Build isolated ARM64 FFmpeg 7.1.5 libraries with Cedar client codecs."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tarfile
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True, help='Extracted official FFmpeg n7.1.5 source')
+    parser.add_argument('--work', type=Path, required=True, help='New isolated build directory')
+    parser.add_argument('--jobs', type=int, default=8)
+    parser.add_argument('--prepare-only', action='store_true',
+                        help='Prepare the patched FFmpeg tree for a different target runtime')
+    parser.add_argument('--resume', action='store_true', help='Rebuild the same isolated work directory after wrapper changes')
+    parser.add_argument('--bundle-name', default='t736-browser-ffmpeg-v1', help='Separate artifact name for an incremental candidate')
+    args = parser.parse_args()
+    if args.prepare_only and args.resume:
+        parser.error('--prepare-only needs a new work directory')
+    if not re.fullmatch(r't736-browser-ffmpeg-v[0-9]+', args.bundle_name):
+        parser.error('bundle-name must have the form t736-browser-ffmpeg-vN')
+    source, work = args.source.resolve(), args.work.resolve()
+    if source == work or source in work.parents or work in source.parents:
+        parser.error('source and work must be separate directory trees')
+    if (source/'RELEASE').read_text(encoding='utf-8').strip() != '7.1.5':
+        parser.error('only the reviewed FFmpeg 7.1.5 source is supported')
+    if work.exists() and not args.resume:
+        parser.error('work must be new unless --resume is specified')
+    patched, build, install = work/'src', work/'build', work/'install'
+    if args.resume:
+        if not (build/'config.h').is_file() or not (patched/'libavcodec/ffmpeg_cedar.c').is_file():
+            parser.error('--resume requires a previous build from this builder')
+        if (patched/'RELEASE').read_text(encoding='utf-8').strip() != '7.1.5':
+            parser.error('unexpected version in existing work directory')
+    else:
+        work.mkdir(parents=True)
+        shutil.copytree(source, patched)
+        build.mkdir()
+    here = Path(__file__).resolve().parent
+    for name in ('ffmpeg_cedar.c','cedar_client.h'):
+        shutil.copy2(here/name, patched/'libavcodec'/name)
+    makefile = patched/'libavcodec/Makefile'
+    if not args.resume:
+        makefile.write_text(makefile.read_text(encoding='utf-8') +
+            '\nOBJS-$(CONFIG_H264_CEDAR_DECODER) += ffmpeg_cedar.o\nOBJS-$(CONFIG_HEVC_CEDAR_DECODER) += ffmpeg_cedar.o\n', encoding='utf-8')
+    # Debian's shared libavfilter uses libavcodec's versioned ELBG functions.
+    # Upstream normally adds this object via an enabled filter or encoder.
+    make_text = makefile.read_text(encoding='utf-8')
+    if 'OBJS += elbg.o\n' not in make_text:
+        makefile.write_text(make_text + '\nOBJS += elbg.o\n', encoding='utf-8')
+    allcodecs = patched/'libavcodec/allcodecs.c'
+    text = allcodecs.read_text(encoding='utf-8')
+    for codec in ('h264','hevc'):
+        anchor = f'extern const FFCodec ff_{codec}_decoder;'
+        if text.count(anchor) != 1:
+            raise ValueError('Unexpected allcodecs layout')
+        cedar = f'extern const FFCodec ff_{codec}_cedar_decoder;'
+        if cedar not in text:
+            text = text.replace(anchor, cedar+'\n'+anchor)
+    allcodecs.write_text(text, encoding='utf-8')
+    if args.prepare_only:
+        return
+    command = [str(patched/'configure'), '--prefix=/opt/t736-browser-ffmpeg',
+               '--arch=aarch64', '--target-os=linux', '--enable-cross-compile',
+               '--cross-prefix=aarch64-linux-gnu-', '--enable-shared', '--disable-static',
+               '--enable-pic', '--disable-doc', '--disable-programs', '--disable-autodetect',
+               '--disable-network', '--disable-encoders', '--disable-muxers', '--disable-devices',
+               '--disable-filters', '--disable-avdevice', '--disable-avfilter', '--disable-postproc',
+               '--extra-ldflags=-ldl', '--enable-decoder=h264_cedar,hevc_cedar,h264,hevc',
+               '--enable-bsf=h264_mp4toannexb,hevc_mp4toannexb']
+    if not args.resume:
+        with (work/'configure.log').open('w', encoding='utf-8') as log:
+            subprocess.run(command, cwd=build, stdout=log, stderr=subprocess.STDOUT, check=True)
+    codecs = build/'libavcodec/codec_list.c'
+    text = codecs.read_text(encoding='utf-8')
+    for codec in ('h264','hevc'):
+        line = f'    &ff_{codec}_cedar_decoder,\n'
+        if text.count(line) != 1:
+            raise ValueError('New decoder was not enabled')
+        text = text.replace(line, '')
+    text = text.replace('{\n', '{\n    &ff_h264_cedar_decoder,\n    &ff_hevc_cedar_decoder,\n', 1)
+    codecs.write_text(text, encoding='utf-8')
+    with (work/'build.log').open('w', encoding='utf-8') as log:
+        subprocess.run(['make','-j'+str(args.jobs)], cwd=build, stdout=log, stderr=subprocess.STDOUT, check=True)
+    with (work/'install.log').open('w', encoding='utf-8') as log:
+        subprocess.run(['make','install','DESTDIR='+str(install)], cwd=build, stdout=log, stderr=subprocess.STDOUT, check=True)
+    bundle = work/args.bundle_name
+    (bundle/'lib').mkdir(parents=True, exist_ok=True)
+    for path in (install/'opt/t736-browser-ffmpeg/lib').glob('*.so*'):
+        destination = bundle/'lib'/path.name
+        if destination.is_symlink():
+            destination.unlink()
+        shutil.copy2(path, destination, follow_symlinks=False)
+    libraries = {}
+    for path in sorted((bundle/'lib').glob('*.so.*.*.*')):
+        dynamic = subprocess.check_output(['aarch64-linux-gnu-readelf','-d',str(path)], text=True)
+        libraries[path.name] = {'bytes':path.stat().st_size,'sha256':sha(path),
+                               'needed':re.findall(r'\(NEEDED\).*\[(.*?)\]',dynamic),
+                               'soname':re.findall(r'\(SONAME\).*\[(.*?)\]',dynamic)}
+    record = {'schema':1,'status':'COMPILED_TESTS_AND_BOARD_PENDING',
+              'upstream':'FFmpeg official n7.1.5 tag',
+              'source_archive_sha256':'e3963a50831c985933e1a625ed566ec4c7adb5c012c34fa9f84438e1d61bdacc',
+              'source_archive_url':'https://codeload.github.com/FFmpeg/FFmpeg/tar.gz/refs/tags/n7.1.5',
+              'configure':command, 'source_sha256':sha(patched/'libavcodec/ffmpeg_cedar.c'),
+              'client_header_sha256':sha(patched/'libavcodec/cedar_client.h'),
+              'codec_list_sha256':sha(codecs), 'libraries':libraries,
+              'selection':'Cedar wrappers lead av_codec_iterate and avcodec_find_decoder; native names h264/hevc remain available for fallback.',
+              'software_codecs':'All available in-tree decoders/parsers retained; external codec libraries not auto-detected or linked. Native h264/hevc and audio fallback retained.',
+              'sandbox':'No sandbox disabling. Hardware API resolved only from an already-preloaded, already-connected client.',
+              'limits':['Only even <=3840x2160 8-bit hardware frames accepted.',
+                        'Bounded replay fallback only before a hardware frame is delivered; post-delivery hardware errors remain explicit.',
+                        'No assertion of hardware use based on Firefox software-frame backend labels.',
+                        'No system library installation or target execution by this builder.']}
+    (bundle/'manifest.json').write_text(json.dumps(record,indent=2)+'\n',encoding='utf-8')
+    archive=work/(args.bundle_name+'.tar.gz')
+    with tarfile.open(archive,'w:gz') as tar:
+        tar.add(bundle,arcname=bundle.name)
+    result={'archive':str(archive),'bytes':archive.stat().st_size,'sha256':sha(archive),
+            'manifest_sha256':sha(bundle/'manifest.json'),'libraries':libraries}
+    (work/'build-result.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
+    print(json.dumps(result))
+
+
+if __name__ == '__main__':
+    main()
