++			break;
++		}
++		if (time_after(jiffies, deadline)) {
++			ret = -ETIMEDOUT;
++			break;
++		}
++		if (host->active_sample)
++			host->active_sample->poll_sleeps++;
++		usleep_range(50, 100);
++	}
