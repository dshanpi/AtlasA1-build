@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Collect board I/O enumeration without changing radio, link or power state."""
+import json
+import os
+from pathlib import Path
+
+
+def read(path):
+    try:
+        return path.read_text().strip()
+    except (FileNotFoundError, PermissionError, OSError):
+        return None
+
+
+def driver(device):
+    link = device / 'driver'
+    return link.resolve().name if link.is_symlink() else None
+
+
+def fields(device, names):
+    return {name: read(device / name) for name in names}
+
+
+def main():
+    if b'allwinner,t736' not in Path('/proc/device-tree/compatible').read_bytes().split(b'\x00'):
+        raise SystemExit('Expected an AtlasA1 / T736 device')
+    mmc = {}
+    for entry in sorted(Path('/sys/class/mmc_host').glob('mmc*')):
+        mmc[entry.name] = dict(host_driver=driver(entry/'device'),
+                               cards=[dict(type=read(card/'type'), name=read(card/'name'))
+                                      for card in entry.glob('mmc*:*')])
+    sdio = {f.name: dict(driver=driver(f), **fields(f, ('vendor', 'device', 'class', 'modalias')))
+            for f in sorted(Path('/sys/bus/sdio/devices').glob('*'))}
+    wifi = {n.name: dict(phy=(n/'phy80211').resolve().name, driver=driver(n/'device'),
+                         state=read(n/'operstate')) for n in sorted(Path('/sys/class/net').glob('*'))
+            if (n/'phy80211').is_symlink()}
+    bluetooth = {b.name: dict(driver=driver(b/'device'), transport=b.resolve().parent.name)
+                 for b in sorted(Path('/sys/class/bluetooth').glob('hci*'))}
+    rfkill = [fields(i, ('name', 'type', 'soft', 'hard')) for i in sorted(Path('/sys/class/rfkill').glob('rfkill*'))]
+    pci = {p.name: dict(driver=driver(p), **fields(p, ('vendor', 'device', 'class',
+               'current_link_speed', 'current_link_width', 'max_link_speed', 'max_link_width')))
+           for p in sorted(Path('/sys/bus/pci/devices').glob('*'))}
+    controllers = {p.name: driver(p) for p in Path('/sys/bus/platform/devices').glob('*')
+                   if 'pcie' in p.name.lower() or 'combo-phy' in p.name.lower()}
+    print(json.dumps(dict(kernel=os.uname().release, mmc_hosts=mmc, sdio=sdio, wireless_interfaces=wifi,
+                          bluetooth_controllers=bluetooth, rfkill=rfkill,
+                          pci_host_devices=controllers, pci_functions=pci,
+                          nvme_namespaces=sorted(x.name for x in Path('/sys/block').glob('nvme*n*'))), indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/userpatches/atlasa1-release/tools/validation/atlasa1_resolute_live.py b/userpatches/atlasa1-release/tools/validation/atlasa1_resolute_live.py
new file mode 100755
index 0000000000000000000000000000000000000000..a72f6682d8741945fdf4ca760fb5fc94bb56dc38
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/validation/atlasa1_resolute_live.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Check an installed AtlasA1 image against its disk image manifest."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def run(*argv, check=True):
+    return subprocess.run(argv, capture_output=True, text=True, timeout=30, check=check,
+                          env=dict(os.environ, LC_ALL='C')).stdout.strip()
+
+
+def digest(path):
+    with path.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+
+def emmc_readback(manifest):
+    records = {}
+    with open('/dev/mmcblk0', 'rb', buffering=0) as disk:
+        for item in manifest['components']:
+            disk.seek(512 * item['sector'])
+            buf = disk.read(item['bytes'])
+            checksum = hashlib.sha256(buf).hexdigest()
+            records[str(item['sector'])] = checksum == item['sha256'] and len(buf) == item['bytes']
+        disk.seek(512 * 16)
+        header = disk.read(32)
+        length = int.from_bytes(header[16:20], 'little')
+        if header[4:12] != b'eGON.BT0' or not 0 < length <= 512 * 1024:
+            records['spl'] = False
+        else:
+            disk.seek(512 * 16)
+            records['spl'] = hashlib.sha256(disk.read(length)).hexdigest() == manifest['spl_sha256']
+    return records
+
+
+def filesystem_test():
+    payload = os.urandom(4 * 1024 * 1024)
+    with tempfile.NamedTemporaryFile(dir='/var/tmp') as f:
+        f.write(payload)
+        f.flush()
+        os.fsync(f.fileno())
+        if hasattr(os, 'posix_fadvise'):
+            os.posix_fadvise(f.fileno(), 0, len(payload), os.POSIX_FADV_DONTNEED)
+        f.seek(0)
+        return f.read() == payload
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('manifest', type=Path)
+    args = parser.parse_args()
+    manifest = json.loads(args.manifest.read_text())
+    if os.geteuid() or b'allwinner,t736' not in Path('/proc/device-tree/compatible').read_bytes().split(b'\x00'):
+        parser.error('expected root on the AtlasA1 board')
+    root = run('findmnt', '-n', '-o', 'SOURCE', '/')
+    if root != '/dev/mmcblk0p4':
+        parser.error('expected the fourth eMMC partition as root')
+    partuuid = run('blkid', '-s', 'PARTUUID', '-o', 'value', root)
+    if partuuid.lower() != manifest['root_partuuid']:
+        parser.error('root PARTUUID does not match the supplied manifest')
+    kernel = os.uname().release
+    images = [name.removeprefix('boot/vmlinuz-').removesuffix('.atlasa1.gz') for name in manifest['boot_files']
+              if name.startswith('boot/vmlinuz-')]
+    if len(images) != 1:
+        parser.error('expected one versioned Linux image in the manifest')
+    boots = {name: digest(Path('/')/name) == checksum
+             for name, checksum in manifest['boot_files'].items()}
+    storage = emmc_readback(manifest)
+    display_manager = Path('/etc/systemd/system/display-manager.service').resolve().name
+    if display_manager not in ('gdm.service', 'lightdm.service'):
+        parser.error('unsupported display manager')
+    units = {unit: run('systemctl', 'is-active', unit, check=False) for unit in
+             ('serial-getty@ttyS0.service', display_manager, 'NetworkManager.service',
+              'systemd-udevd.service', 't736-cedar.socket', 'ssh.service')}
+    hdmi = {}
+    for connector in Path('/sys/class/drm').glob('card*-HDMI-*'):
+        hdmi[connector.name] = {n: (connector/n).read_text().strip()
+                                for n in ('status', 'enabled') if (connector/n).is_file()}
+    modes = []
+    for state in Path('/sys/kernel/debug/dri').glob('[0-9]*/state'):
+        for crtc in re.split(r'(?m)^crtc\[', state.read_text())[1:]:
+            if re.search(r'(?m)^\s*active=1$', crtc):
+                modes.extend(re.findall(r'(?m)^\s*mode:\s*([^\n]+)', crtc))
+    os_release = Path('/usr/lib/os-release').read_text()
+    hosts = list(Path('/etc/ssh').glob('ssh_host_*_key'))
+    failed = run('systemctl', '--failed', '--plain', '--no-legend', '--no-pager')
+    record = dict(kernel=kernel, root_device=root, root_partuuid=partuuid,
+                  rootfs_uuid=run('blkid', '-s', 'UUID', '-o', 'value', root),
+                  kernel_command_line=Path('/proc/cmdline').read_text().strip(),
+                  release_files=boots, emmc_boot_components=storage, services=units,
+                  failed_units=failed.splitlines(), hdmi=hdmi, active_drm_modes=modes,
+                  desktop_sessions=run('loginctl', 'list-sessions', '--no-legend').splitlines(),
+                  alsa_cards=Path('/proc/asound/cards').read_text().strip()
+                  if Path('/proc/asound/cards').exists() else '',
+                  display_manager=display_manager, package_audit=run('dpkg', '--audit'))
+    record['checks'] = dict(ubuntu_resolute='VERSION_CODENAME=resolute' in os_release,
+                            released_kernel=kernel == images[0],
+                            boot_files=all(boots.values()), raw_boot_stages=all(storage.values()),
+                            rootfs_uuid=record['rootfs_uuid'] == manifest['rootfs_uuid'],
+                            emmc_file_fsync_readback=filesystem_test(),
+                            initialized_identity=len(Path('/etc/machine-id').read_text().strip()) == 32,
+                            generated_ssh_host_keys=bool(hosts),
+                            display_manager=units[display_manager] == 'active',
+                            hdmi_connector_enabled=any(s.get('status') == 'connected' and
+                                                       s.get('enabled') == 'enabled' for s in hdmi.values()),
+                            cedar_socket=units['t736-cedar.socket'] == 'active',
+                            powervr_render_node=any(p.joinpath('device/driver/module').resolve().name == 'pvrsrvkm'
+                                                    for p in Path('/sys/class/drm').glob('renderD*')),
+                            package_db_clean=not record['package_audit'])
+    print(json.dumps(record, indent=2))
+    return 0 if all(record['checks'].values()) else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/userpatches/atlasa1-release/tools/validation/atlasa1_sdl_gles_smoke.c b/userpatches/atlasa1-release/tools/validation/atlasa1_sdl_gles_smoke.c
new file mode 100644
index 0000000000000000000000000000000000000000..cfa10fc131790e72f90d894bd38f6b6b0a3891b5
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/validation/atlasa1_sdl_gles_smoke.c
@@ -0,0 +1,78 @@
+#include <SDL.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef unsigned GLenum;
+typedef unsigned char GLubyte;
+
+int main(void)
+{
+    static const unsigned char colors[][4] = {
+        {255, 0, 0, 255}, {0, 255, 0, 255}, {0, 0, 255, 255}, {255, 255, 0, 255}
+    };
+    if (getenv("DISPLAY") || getenv("WAYLAND_DISPLAY")) {
+        fprintf(stderr, "Unset DISPLAY and WAYLAND_DISPLAY for this offscreen test\n");
+        return 2;
+    }
+    if (SDL_setenv("SDL_VIDEODRIVER", "offscreen", 1) != 0 || SDL_Init(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "SDL init: %s\n", SDL_GetError());
+        return 1;
+    }
+    int result = 1;
+    SDL_Window *window = NULL;
+    SDL_GLContext context = NULL;
+    const char *driver = SDL_GetCurrentVideoDriver();
+    printf("SDL_VIDEODRIVER=%s\n", driver ? driver : "(none)");
+    if (!driver || strcmp(driver, "offscreen")) goto out;
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
+    SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
+    window = SDL_CreateWindow("AtlasA1 offscreen QA", 0, 0, 32, 32, SDL_WINDOW_OPENGL | SDL_WINDOW_HIDDEN);
+    if (!window) { fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError()); goto out; }
+    context = SDL_GL_CreateContext(window);
+    if (!context) { fprintf(stderr, "SDL_GL_CreateContext: %s\n", SDL_GetError()); goto out; }
+#define GL_PROC(ret, name, args) ret (*name) args = SDL_GL_GetProcAddress(#name); \
+    if (!name) { fprintf(stderr, "Missing " #name "\n"); goto out; }
+    GL_PROC(const GLubyte *, glGetString, (GLenum))
+    GL_PROC(void, glClearColor, (float,float,float,float))
+    GL_PROC(void, glClear, (GLenum))
+    GL_PROC(void, glFinish, (void))
+    GL_PROC(void, glReadPixels, (int,int,int,int,GLenum,GLenum,void *))
+    GL_PROC(GLenum, glGetError, (void))
+    const char *vendor = (const char *)glGetString(0x1f00);
+    const char *renderer = (const char *)glGetString(0x1f01);
+    const char *version = (const char *)glGetString(0x1f02);
+    if (!vendor || !renderer || !version) { fputs("Missing GLES identity\n",stderr); goto out; }
+    printf("GL_VENDOR=%s\nGL_RENDERER=%s\nGL_VERSION=%s\n",vendor,renderer,version);
+    if (!strstr(version, "OpenGL ES")) { fputs("Unexpected GL context\n",stderr); goto out; }
+    for (size_t i=0; i<sizeof(colors)/sizeof(colors[0]); i++) {
+        unsigned char pixel[4] = {0};
+        const unsigned char *c = colors[i];
+        glClearColor(c[0]/255.0f,c[1]/255.0f,c[2]/255.0f,1.0f);
+        glClear(0x4000);
+        glFinish();
+        glReadPixels(16,16,1,1,0x1908,0x1401,pixel);
+        GLenum error = glGetError();
+        printf("color%zu=%u,%u,%u,%u gl_error=0x%x\n",i,pixel[0],pixel[1],pixel[2],pixel[3],error);
+        if (error || memcmp(pixel,c,3)) { fputs("Pixel readback mismatch\n",stderr); goto out; }
+        SDL_GL_SwapWindow(window);
+    }
+    if (!(strstr(vendor, "Imagination") || strstr(renderer,"PowerVR") || strstr(renderer,"BXM")) ||
+        strstr(renderer, "llvmpipe") || strstr(renderer, "softpipe")) {
+        fputs("RGB readback passed; renderer is not IMG PowerVR\n",stderr);
+        result = 3;
+        goto out;
+    }
+    puts("PASS PowerVR offscreen GLES color readback");
+    result = 0;
+out:
+    if (context) SDL_GL_DeleteContext(context);
+    if (window) SDL_DestroyWindow(window);
+    SDL_Quit();
+    return result;
+}
