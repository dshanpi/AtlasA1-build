++		goto fail;
++	for (trial = 0; trial < 16; trial++) {
++		if (time_after(jiffies, deadline)) {
++			ret = -ETIMEDOUT;
++			goto fail;
++		}
++		ret = mmc_send_tuning(mmc, opcode, NULL);
++		if (ret)
++			goto fail;
++	}
