++      G_SIGNAL_RUN_LAST | G_SIGNAL_ACTION,
++      G_CALLBACK (gst_omx_video_dec_t736_set_idle), NULL, NULL,
++      g_cclosure_marshal_generic, G_TYPE_BOOLEAN, 1, G_TYPE_BOOLEAN);
