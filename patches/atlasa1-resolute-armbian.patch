index 0000000000000000000000000000000000000000..672917e5a05b0e9349b85e395ccc49b245d83ffd
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/extract_atlasa1_fes_loader.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Extract the board-tested RAM-only FES loader from matching T736 Tina firmware."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import tempfile
+
+from pack_armbian_raw_v6 import make_loader
+from pack_boot_validation import read_package
+
+
+EXPECTED = {
+    "fes1.fex": (225728, "ab8618a40c51e381d2904dfb12ced567f3b2016bbb50e805980a463402a97994"),
+    "u-boot.fex": (1245184, "cdeb0be64b063a089797e9c385f0c6a20f70548e5540de3453308c53a4b546fd"),
+    "config.fex": (5120, "c6ca514a4f8088f0ba0ac20b6909433ef882d1a54bc55cc7c72fc0b87fb95d82"),
+    "board.fex": (1024, "ab1d5b1e29bc04511d1fc6942ae365f3202d5795fa06e3699acfae987fafb245"),
+}
+LOADER_SHA = "565436e6d6f4370d05788afa3397a7e2368b5d5d2cef9a6490700b9b944cee08"
+
+
+def main():
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument("firmware", type=Path, help="Matching T736 LPDDR4x Tina recovery firmware (IMAGEWTY)")
+    cli.add_argument("output", type=Path, help="New RAM-loader image file")
+    args = cli.parse_args()
+    header, entries = read_package(args.firmware)
+    payloads = {}
+    with args.firmware.open("rb") as source:
+        for name, (length, expected) in EXPECTED.items():
+            if name not in entries or entries[name][2] != length:
+                cli.error(f"wrong loader component {name}")
+            source.seek(entries[name][1])
+            data = source.read(length)
+            if hashlib.sha256(data).hexdigest() != expected:
+                cli.error(f"unexpected contents for {name}")
+            payloads[name] = data
+    with tempfile.TemporaryDirectory(dir=args.output.parent) as work:
+        staged = Path(work)/"loader.img"
+        manifest = make_loader(header, entries, payloads, staged)
+        if manifest["sha256"] != LOADER_SHA:
+            cli.error("container differs from the verified board loader")
+        os.link(staged, args.output)
+    print(f"{LOADER_SHA}  {args.output}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/userpatches/atlasa1-release/tools/pack_armbian_raw_v6.py b/userpatches/atlasa1-release/tools/pack_armbian_raw_v6.py
new file mode 100755
index 0000000000000000000000000000000000000000..d408306eca0dcc18dc61f5b4feeb3162a3a31b91
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/pack_armbian_raw_v6.py
@@ -0,0 +1,185 @@
+#!/usr/bin/env python3
+"""Reproduce a legacy T736 debug image with the rejected Tina boot chain.
+
+This is NOT the independent-boot Armbian packer. The raw contains vendor
+Boot0 and U-Boot 2018 in addition to the separately supplied RAM-only loader.
+Use only to reproduce an explicitly selected historical recovery/debug build.
+
+Run on the build host. The separate Tina FES container is RAM-only and its
+components are unmodified. OpenixCLI compensates the vendor's 40960-sector
+offset with wrapping FES addresses. Never compensate it a second time.
+"""
+import argparse
+import gzip
+import hashlib
+import json
+import struct
+import subprocess
+import uuid
+import zlib
+from pathlib import Path
+
+from pack_boot_validation import align, read_package
+
+SECTOR = 512
+SECTORS = 16777216  # 8 GiB deployment image; relocate backup GPT after boot.
+LAYOUT = [('boot-resource', 73728, 65536), ('env', 139264, 32768),
+          ('boot', 172032, 196608), ('rootfs', 368640, 15239680),
+          ('private', 15608320, 32768), ('UDISK', 15641088, SECTORS - 15641088 - 34)]
+EXPECTED = {
+    'boot0_sdcard.fex': '0e2397669df804256505c786d7a9db6b40720203dd3e6b1ea33955486efa98c8',
+    'boot_package.fex': 'b6dbcfb96ebac121218d30afe1d028aaad8a1a471063f05c5c1c8aaade419df3',
+    'u-boot.fex': 'cdeb0be64b063a089797e9c385f0c6a20f70548e5540de3453308c53a4b546fd',
+}
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def file_digest(path):
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        while b := f.read(8 << 20):
+            h.update(b)
+    return h.hexdigest()
+
+
+def gpt():
+    entries = bytearray()
+    for index, (name, start, size) in enumerate(LAYOUT):
+        entries.extend(struct.pack('<16s16sQQQ72s',
+            uuid.UUID('ebd0a0a2-b9e5-4433-87c0-68b6b72699c7').bytes_le,
+            uuid.UUID(f'a0085546-4166-744a-a353-fca9272b8e{0x45+index:02x}').bytes_le,
+            start, start + size - 1, 1 << 63, name.encode('utf-16-le')))
+    crc = zlib.crc32(entries)
+    def header(current, backup, table):
+        h = bytearray(struct.pack('<8sIIIIQQQQ16sQIII', b'EFI PART', 0x10000,
+            92, 0, 0, current, backup, 73728, SECTORS - 34,
+            uuid.UUID('ab6f3888-569a-4926-9668-80941dcb40bc').bytes_le,
+            table, len(LAYOUT), 128, crc))
+        struct.pack_into('<I', h, 16, zlib.crc32(h))
+        return h + bytes(SECTOR - len(h))
+    mbr = bytearray(SECTOR)
+    struct.pack_into('<B3sB3sII', mbr, 446, 0, b'\0\2\0', 0xee,
+                     b'\xff\xff\xff', 1, SECTORS - 1)
+    mbr[510:] = b'\x55\xaa'
+    table = entries + bytes(align(len(entries), SECTOR) - len(entries))
+    return bytes(mbr) + header(1, SECTORS - 1, 2) + table, table + header(SECTORS - 1, 1, SECTORS - 3)
+
+
+def make_loader(header, entries, payloads, out):
+    content = {n: payloads[n] for n in ['fes1.fex', 'u-boot.fex', 'config.fex', 'board.fex']}
+    blob = bytearray((len(content) + 1) * 1024)
+    blob[:1024] = header
+    struct.pack_into('<I', blob, 60, len(content))
+    for i, (name, b) in enumerate(content.items()):
+        offset = align(len(blob), 1024)
+        blob.extend(bytes(offset - len(blob)))
+        entry = bytearray(1024)
+        entry[:292] = entries[name][0][:292]
+        stored = align(len(b), 16)
+        struct.pack_into('<IIIII', entry, 292, stored, 0, len(b), 0, offset)
+        blob[(i+1)*1024:(i+2)*1024] = entry
+        blob.extend(b + bytes(stored-len(b)))
+    blob.extend(bytes(align(len(blob), 1024)-len(blob)))
+    struct.pack_into('<I', blob, 24, len(blob))
+    if out.exists():
+        assert out.read_bytes() == blob, 'Existing loader differs from original Tina components'
+    else:
+        out.write_bytes(blob)
+    return {'sha256': digest(blob), 'bytes': len(blob), 'partitions': 0,
+            'ram_only': True, 'sdmmc_logical_offset_sectors': 40960,
+            'files': {n: {'bytes': len(b), 'sha256': digest(b)} for n, b in content.items()},
+            'change': 'Container extraction only; all Tina components remain byte-for-byte unchanged.'}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--root', type=Path, required=True)
+    ap.add_argument('--revision', type=int, choices=[6, 7, 8, 9, 10, 11], default=6)
+    ap.add_argument('--legacy-debug-image', action='store_true',
+                    help='Acknowledge persistent Tina Boot0/U-Boot; never a final release')
+    args = ap.parse_args()
+    if not args.legacy_debug_image:
+        ap.error('This packer embeds Tina Boot0/U-Boot in the raw image and does '
+                 'not meet the independent-boot requirement. Historical debug '
+                 'reproduction requires --legacy-debug-image.')
+    root = args.root.resolve()
+    assert root == Path('/home/ubuntu/t736-mainline')
+    output = root / 'output'
+    raw = output / f't736-armbian-v{args.revision}.raw.img'
+    loader = output / 't736-tina-fes-loader.img'
+    assert not raw.exists()
+    ref = output / 'validated-armbian-v2-reference.img'
+    h, entries = read_package(ref)
+    payloads = {}
+    with ref.open('rb') as f:
+        for name in list(EXPECTED) + ['fes1.fex', 'config.fex', 'board.fex']:
+            _, offset, size = entries[name]
+            f.seek(offset)
+            payloads[name] = f.read(size)
+    for name, expected in EXPECTED.items():
+        assert digest(payloads[name]) == expected, name
+    rootfs = output / f'rootfs-armbian-raw-v{args.revision}.ext4'
+    assert rootfs.stat().st_size == LAYOUT[3][2] * SECTOR
+    subprocess.run(['e2fsck', '-fn', str(rootfs)], check=True)
+    primary, backup = gpt()
+    regions = [('primary-gpt', 0, primary),
+        ('vendor-boot0-user-copy', 16, payloads['boot0_sdcard.fex']),
+        ('vendor-boot-package', 24576, payloads['boot_package.fex']),
+        ('vendor-boot-package-backup', 32800, payloads['boot_package.fex']),
+        ('vendor-gpt-mirror', 40960, primary),
+        ('boot-resource', 73728, (output / 'raw-v6-boot-resource.fex').read_bytes()),
+        ('env', 139264, gzip.decompress((output / 't736-current-env.gz').read_bytes())),
+        ('boot', 172032, (output / 'boot-uboot-probe-v3.img').read_bytes()),
+        ('backup-gpt', SECTORS - 3, backup)]
+    assert len(regions[5][2]) <= LAYOUT[0][2] * SECTOR
+    assert len(regions[6][2]) == LAYOUT[1][2] * SECTOR
+    assert regions[7][2][:8] == b'ANDROID!' and len(regions[7][2]) < LAYOUT[2][2]*SECTOR
+    records = []
+    with raw.open('xb') as f:
+        f.truncate(SECTORS * SECTOR)
+        for name, sector, b in regions:
+            f.seek(sector * SECTOR)
+            f.write(b)
+            records.append({'name': name, 'sector': sector, 'bytes': len(b), 'sha256': digest(b)})
+        f.seek(LAYOUT[3][1] * SECTOR)
+        with rootfs.open('rb') as source:
+            while b := source.read(8 << 20):
+                if any(b):
+                    f.write(b)
+                else:
+                    f.seek(len(b), 1)
+    records.append({'name': 'rootfs', 'sector': LAYOUT[3][1], 'bytes': rootfs.stat().st_size, 'sha256': file_digest(rootfs)})
+    subprocess.run(['sfdisk', '--verify', str(raw)], check=True)
+    subprocess.run(['sfdisk', '--json', str(raw)], check=True)
+    # Check every written region independently, including the large rootfs.
+    with raw.open('rb') as f:
+        for record in records:
+            f.seek(record['sector'] * SECTOR)
+            h = hashlib.sha256()
+            remaining = record['bytes']
+            while remaining:
+                b = f.read(min(8 << 20, remaining))
+                assert b
+                remaining -= len(b)
+                h.update(b)
+            assert h.hexdigest() == record['sha256'], record['name']
+    lm = make_loader(read_package(ref)[0], entries, payloads, loader)
+    manifest = {'raw': {'path': raw.name, 'bytes': raw.stat().st_size,
+        'sha256': file_digest(raw), 'physical_sector_zero': True, 'regions': records,
+        'partitions': LAYOUT, 'kernel_package': f'6.18.63-{args.revision}',
+        'boot_chain': 'vendor Boot0/BL31/OP-TEE/SCP/U-Boot2018 -> mainline U-Boot2026.10 -> Linux6.18.63 -> Armbian',
+        'postboot': 'Relocate backup GPT to actual eMMC end using sfdisk; no claim of a secure whole-device erase.'},
+        'loader': lm, 'hardware_validated': False,
+        'release_eligible': False,
+        'independent_boot_compliant': False,
+        'purpose': 'legacy_debug_reproduction',
+        'persistent_vendor_components': ['Boot0', 'BL31', 'OP-TEE', 'SCP', 'U-Boot 2018.07']}
+    raw.with_suffix('.manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/userpatches/atlasa1-release/tools/pack_atlasa1_resolute.py b/userpatches/atlasa1-release/tools/pack_atlasa1_resolute.py
new file mode 100755
index 0000000000000000000000000000000000000000..153098a2d67ad88dd94af6f910b548885a226d5f
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/pack_atlasa1_resolute.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Build the fixed AtlasA1 eMMC layout from a completed Ubuntu 26.04 rootfs."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+from build_atlasa1_release_boot import BL31_SHA, ROOT_ID, SPL_SHA, STAGE_SHA
+from pack_armbian_raw_v6 import LAYOUT, SECTOR, SECTORS, gpt
+from pack_t736_media_v28_boot import BASE_LBA, parse
+
+
+def sha(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def text(*argv):
+    return subprocess.check_output(argv, text=True).strip()
+
+
+def main():
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('--rootfs', required=True, type=Path)
+    cli.add_argument('--boot', required=True, type=Path, help='directory from build_atlasa1_release_boot.py')
+    cli.add_argument('--output', required=True, type=Path)
+    args = cli.parse_args()
+    root, boot, output = args.rootfs.resolve(strict=True), args.boot.resolve(strict=True), args.output.absolute()
+    manifest = output.with_suffix('.manifest.json')
+    if output.exists() or manifest.exists() or output.is_symlink() or manifest.is_symlink():
+        cli.error('output paths must be new')
+    identity = (root/'usr/lib/os-release').read_text()
+    if 'VERSION_ID="26.04"' not in identity or 'ID=ubuntu' not in identity or 'resolute' not in identity:
+        cli.error('expected Ubuntu 26.04 Resolute')
+    if 't736-mainline' not in (root/'etc/armbian-release').read_text():
+        cli.error('missing AtlasA1 Armbian BSP')
+    if f'PARTUUID={ROOT_ID}' not in (root/'etc/fstab').read_text():
+        cli.error('root partition does not match the U-Boot boot command')
+    expected_boot_files = {}
+    for name in ('vmlinuz-6.18.63-t736-armbian', 'initrd.img-6.18.63-t736-armbian',
+                 'dtb/allwinner/t736-mainline-bringup.dtb'):
+        path = (root/'boot'/name).resolve(strict=True)
+        if not path.is_relative_to(root/'boot') or not 0 < path.stat().st_size < 48 * 1024**2:
+            cli.error(f'invalid boot file {name}')
+        expected_boot_files[str(path.relative_to(root))] = sha(path)
+    spl, package = boot/'emmc-spl.bin', boot/'boot-package.bin'
+    record = json.loads((boot/'boot-manifest.json').read_text())
+    if sha(spl) != SPL_SHA or sha(package) != record['boot_package_sha256'] or record['root_partuuid'] != ROOT_ID:
+        cli.error('SPL or boot package differs from its build record')
+    entries = parse(package.read_bytes())
+    if [i['sha256'] for i in entries] != [STAGE_SHA, BL31_SHA, sha(boot/'u-boot.bin')]:
+        cli.error('stage64/BL31/U-Boot payload mismatch')
+    primary, backup = gpt()
+    regions = [(0, primary), (16, spl.read_bytes()), (BASE_LBA, package.read_bytes()),
+               (40960, primary), (SECTORS - len(backup)//SECTOR, backup)]
+    root_lba, root_sectors = LAYOUT[3][1:]
+    # Only a new regular file is opened. Loop access is read-only and bounded to p4.
+    with tempfile.TemporaryDirectory(dir=output.parent, prefix='.atlas-image-') as tmp:
+        image = Path(tmp)/'disk.img'
+        with image.open('xb') as stream:
+            stream.truncate(SECTORS * SECTOR)
+        features = ('none,has_journal,ext_attr,resize_inode,dir_index,filetype,extent,64bit,flex_bg,'
+                    'sparse_super,large_file,huge_file,dir_nlink,extra_isize,metadata_csum')
+        subprocess.run(['mke2fs', '-q', '-F', '-t', 'ext4', '-b', '4096', '-I', '256',
+                        '-m', '1', '-L', 'rootfs', '-O', features, '-E',
+                        f'offset={root_lba*SECTOR},nodiscard,lazy_itable_init=0,lazy_journal_init=0',
+                        '-d', root, image, str(root_sectors*SECTOR//4096)], check=True)
+        with image.open('r+b') as stream:
+            for lba, data in regions:
+                stream.seek(lba * SECTOR)
+                stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+            for lba, data in regions:
+                stream.seek(lba * SECTOR)
+                if stream.read(len(data)) != data:
+                    raise ValueError(f'boot data readback mismatch at LBA {lba}')
+        subprocess.run(['sfdisk', '--verify', image], check=True)
+        partitions = json.loads(text('sfdisk', '--json', image))['partitiontable']['partitions']
+        if ([(p['name'], p['start'], p['size']) for p in partitions] != LAYOUT
+                or partitions[3]['uuid'].lower() != ROOT_ID or image.stat().st_size != SECTORS * SECTOR):
+            raise ValueError('incorrect output GPT or image size')
+        loop = text('losetup', '--find', '--show', '--read-only', '--offset', str(root_lba*SECTOR),
+                    '--sizelimit', str(root_sectors*SECTOR), image)
+        try:
+            subprocess.run(['e2fsck', '-fn', loop], check=True)
+            for name, expected in expected_boot_files.items():
+                extracted = Path(tmp)/Path(name).name
+                subprocess.run(['debugfs', '-R', f'dump /{name} {extracted}', loop], check=True)
+                if sha(extracted) != expected:
+                    raise ValueError(f'packed ext4 differs from source for {name}')
+            fs_uuid = text('blkid', '-s', 'UUID', '-o', 'value', loop)
+            env = dict(os.environ, LC_ALL='C')
+            header = subprocess.check_output(['dumpe2fs', '-h', loop], env=env,
+                                             text=True, stderr=subprocess.DEVNULL)
+            numbers = dict(line.split(':', 1) for line in header.splitlines() if ':' in line)
+            block_size = int(numbers['Block size'])
+            user_free = (int(numbers['Free blocks']) - int(numbers['Reserved block count'])) * block_size
+        finally:
+            subprocess.run(['losetup', '-d', loop], check=True)
+        details = dict(image=output.name, bytes=image.stat().st_size, sha256=sha(image),
+                       format='AtlasA1 eMMC raw disk image', distribution='Ubuntu 26.04', root_partuuid=ROOT_ID,
+                       rootfs_uuid=fs_uuid, rootfs_lba=root_lba, boot_files=expected_boot_files,
+                       root_partition_bytes=root_sectors*SECTOR, rootfs_user_available_bytes=user_free,
+                       spl_sha256=SPL_SHA, boot_package_sha256=record['boot_package_sha256'],
+                       components=entries, e2fsck='passed', gpt='passed', hardware_boot='unverified')
+        pending_manifest = Path(tmp)/'manifest.json'
+        pending_manifest.write_text(json.dumps(details, indent=2)+'\n')
+        image.chmod(0o644)
+        os.link(image, output)
+        os.link(pending_manifest, manifest)
+        print(json.dumps(details))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/userpatches/atlasa1-release/tools/pack_boot_validation.py b/userpatches/atlasa1-release/tools/pack_boot_validation.py
