@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fault injection for local safety invariants; not a physical PLL model. */
+#include "a55clock_d.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#define BIT(n) (UINT32_C(1) << (n))
+#define UPDATE BIT(26)
+#define OUTPUT BIT(27)
+#define LOCK BIT(28)
+#define LOCK_EN BIT(29)
+#define LDO BIT(30)
+#define ENABLE BIT(31)
+#define NM UINT32_C(0xff00)
+struct fake {
+	uint32_t regs[0x4000/4], ppu[8], xo;
+	uint8_t pmic[256];
+	unsigned int writes, ctrl_writes, updates, delays, reads;
+	unsigned int early_latch, bad_n, stuck_update, no_lock, frozen_stat;
+	unsigned int write_n_latch, delayed_n, pending_n, pending_reads, bad_gate_at_n;
+	unsigned int pmic_fail, supply_drift, guard_drift, ppu_drift;
+	unsigned int delay_fail_after, initial_mux_fail, rollback_mux_fail, forbid_ctrl;
+};
+static uint32_t rd(void *ctx, uint32_t addr)
+{
+	struct fake *f = ctx;
+	if (addr == T736_CPUCLOCK_XO) return f->xo;
+	for (unsigned int i=0;i<8;i++) if (addr == T736_A55_PPU(i)) return f->ppu[i];
+	assert(addr>=T736_CPUCLOCK_BASE && addr<T736_CPUCLOCK_BASE+0x4000 && !(addr&3));
+	if(addr==T736_CPUCLOCK_BASE+T736_A55_CTRL && f->pending_reads && !--f->pending_reads) {
+	 f->regs[T736_A55_CTRL/4]=(f->regs[T736_A55_CTRL/4]&~NM)|f->pending_n;
+	 if(!f->frozen_stat) f->regs[T736_A55_STAT/4]=f->regs[T736_A55_CTRL/4];
+	}
+	return f->regs[(addr-T736_CPUCLOCK_BASE)/4];
+}
+static void wr(void *ctx, uint32_t addr, uint32_t value)
+{
+	struct fake *f=ctx;
+	uint32_t off=addr-T736_CPUCLOCK_BASE;
+	uint32_t *ctrl=&f->regs[T736_A55_CTRL/4], old=*ctrl;
+	f->writes++;
+	assert(off==T736_A55_CTRL || off==T736_A55_CLK);
+	if(off==T736_A55_CLK) {
+		if (!value && f->initial_mux_fail && !f->ctrl_writes) return;
+		if (!value && f->rollback_mux_fail && f->forbid_ctrl) return;
+		if(value==T736_A55_PLL_CLK) {
+			assert(*ctrl==T736_A55_TARGET && f->regs[T736_A55_STAT/4]==T736_A55_TARGET);
+		}
+		f->regs[off/4]=value;return;
+	}
+	assert(!f->forbid_ctrl);
+	f->ctrl_writes++;
+	assert((value&(ENABLE|LDO))==(ENABLE|LDO)); /* Never turn off a live A55 PLL. */
+	assert(!(value&LOCK));
+	assert(f->regs[T736_A55_CLK/4]==0); /* All PLL changes occur under slow. */
+	*ctrl=(value&~(NM|LOCK|UPDATE))|(old&(NM|LOCK|UPDATE));
+	if(!(value&LOCK_EN)) *ctrl&=~LOCK;
+	if((old&NM)!=(value&NM) && !(value&(LOCK_EN|UPDATE))) {
+	 if(f->write_n_latch) *ctrl=(*ctrl&~NM)|(f->bad_n?0x3500:(value&NM));
+	 if(f->delayed_n) {f->pending_n=f->bad_n?0x3500:(value&NM);f->pending_reads=2;}
+	 if(f->bad_gate_at_n) *ctrl|=OUTPUT;
+	}
+	if(f->early_latch && !(old&LOCK_EN) && (value&LOCK_EN))
+		*ctrl=(*ctrl&~NM)|(f->bad_n?0x3500:(value&NM));
+	if(value&UPDATE) {
+		f->updates++;
+		assert((value&NM)==0x2700); /* Never commit inherited below-spec N19. */
+		assert(!(value&OUTPUT));
+		*ctrl|=UPDATE;
+		if(!f->stuck_update) {
+			*ctrl=(*ctrl&~(NM|LOCK|UPDATE))|(value&NM);
+			if(!f->no_lock) *ctrl|=LOCK;
+		}
+	}
+	if(!f->frozen_stat) f->regs[T736_A55_STAT/4]=*ctrl;
+	if(f->guard_drift && (value&NM)==0x2700) f->regs[0x301c/4]=0x03000104;
+}
+static int delay(void *ctx, uint32_t us)
+{
+	struct fake *f=ctx;
+	assert(us==1||us==10||us==20);
+	f->delays++;
+	assert(f->delays<16000);
+	return f->delay_fail_after && f->delays>=f->delay_fail_after ? -1:0;
+}
+static int pmic(void *ctx,uint8_t reg,uint8_t *v)
+{
+	struct fake *f=ctx;
+	f->reads++;
+	assert(reg==0x0e||reg==0x10||reg==0x14||reg==0x15||reg==0x1b||reg==0x1d);
+	if(f->reads>6) {
+		if(f->pmic_fail) { f->forbid_ctrl=1;return -1; }
+		if(f->ppu_drift) f->ppu[1]=8;
+	}
+	*v=f->pmic[reg];
+	if(f->supply_drift && f->reads>6 && reg==0x14) {(*v)++;f->forbid_ctrl=1;}
+	return 0;
+}
+static struct t736_cpuclock_io init(struct fake *f)
+{
+	memset(f,0,sizeof(*f));f->xo=1u<<15;f->ppu[0]=0x108;
+	f->regs[T736_A55_CTRL/4]=f->regs[T736_A55_STAT/4]=T736_A55_ORIGINAL;
+	f->regs[T736_A55_CLK/4]=T736_A55_PLL_CLK;
+	f->regs[0x1008/4]=0x30000000;f->regs[0x1018/4]=0x40000001;
+	f->regs[0x2000/4]=f->regs[0x202c/4]=T736_CPUCLOCK_TARGET;
+	f->regs[0x201c/4]=T736_CPUCLOCK_TARGET_CLK;
+	f->regs[0x3000/4]=f->regs[0x302c/4]=0xf8801300;f->regs[0x301c/4]=0x03000105;
+	f->pmic[0x0e]=3;f->pmic[0x10]=0x7f;f->pmic[0x14]=f->pmic[0x15]=40;
+	return (struct t736_cpuclock_io){f,rd,wr,delay,pmic,0x412fd050,0x80000000};
+}
+static void failed_slow(struct fake *f,struct t736_a55clock_d_report *r)
+{
+	assert(r->base.error && r->base.mutation_attempted && r->base.slow_verified);
+	assert(r->base.final_ctrl&ENABLE);assert(r->base.final_stat&ENABLE);
+	assert(!r->base.rollback_error);assert(f->regs[T736_A55_CLK/4]==0);
+	assert(f->updates<=1);
+}
+int main(void)
+{
+	struct fake f;struct t736_a55clock_d_report r;struct t736_cpuclock_io io;
+	for(unsigned int early=0;early<2;early++) {
+		io=init(&f);f.early_latch=early;
+		assert(t736_a55clock_d_prepare(&io,&r)==0);
+		assert(r.base.stage==8 && f.updates==1 && f.reads==12 && !r.base.guard_failure);
+		assert(r.base.final_ctrl==T736_A55_TARGET && r.base.final_stat==T736_A55_TARGET && r.base.final_clk==T736_A55_PLL_CLK);
+	}
+	for(unsigned int timing=1;timing<=2;timing++) {
+	 io=init(&f);f.write_n_latch=timing==1;f.delayed_n=timing==2;
+	 assert(!t736_a55clock_d_prepare(&io,&r));
+	 assert(r.base.stage==8 && r.trace_count==11 && !r.failure_recorded);
+	 assert(r.trace[3].step==4 && r.trace[3].ctrl==0xc0802700);
+	 assert(r.trace[3].actual==(timing==1?0xc0802700:0xc0801300));
+	 assert(r.base.final_ctrl==T736_A55_TARGET && r.base.final_stat==T736_A55_TARGET);
+	}
+	io=init(&f);f.write_n_latch=1;f.bad_n=1;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_VERIFY);
+	failed_slow(&f,&r);assert(!f.updates && r.failure_recorded && r.failed.step==4 && r.failed.actual==0xc0803500);
+	io=init(&f);f.delayed_n=1;f.bad_n=1;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_PRECONDITION);
+	failed_slow(&f,&r);assert(!f.updates && r.failure_recorded && r.failed.step==5);
+	io=init(&f);f.write_n_latch=1;f.bad_gate_at_n=1;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_VERIFY);
+	failed_slow(&f,&r);assert(!f.updates && r.failure_recorded && r.failed.step==4);
+	io=init(&f);f.pmic[0x14]|=0x80;f.pmic[0x15]|=0x80;
+	assert(!t736_a55clock_d_prepare(&io,&r));
+	for(unsigned int cpu=0;cpu<8;cpu++) {
+		io=init(&f);f.ppu[cpu]=cpu?8:0;
+		assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_GUARD && !f.writes);
+	}
+	io=init(&f);io.mpidr|=0x100;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_PRECONDITION&&!f.writes);
+	io=init(&f);io.midr=0x410fd0b0;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_PRECONDITION&&!f.writes);
+	io=init(&f);f.pmic[0x14]=39;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_SUPPLY&&!f.writes);
+	io=init(&f);f.regs[0x2000/4]=0xf8802000;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_PRECONDITION&&!f.writes);
+	io=init(&f);f.initial_mux_fail=1;
+	assert(t736_a55clock_d_prepare(&io,&r) && !f.ctrl_writes && r.base.rollback_error);
+	io=init(&f);f.no_lock=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);
+	io=init(&f);f.stuck_update=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);
+	io=init(&f);f.frozen_stat=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);
+	io=init(&f);f.early_latch=1;f.bad_n=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);assert(!f.updates);
+	io=init(&f);f.pmic_fail=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);
+	io=init(&f);f.supply_drift=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);
+	io=init(&f);f.guard_drift=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);assert(r.base.guard_failure);
+	io=init(&f);f.ppu_drift=1;assert(t736_a55clock_d_prepare(&io,&r));failed_slow(&f,&r);assert(r.base.guard_failure);
+	io=init(&f);f.pmic_fail=1;f.rollback_mux_fail=1;
+	assert(t736_a55clock_d_prepare(&io,&r) && r.base.rollback_error && !r.base.slow_verified);
+	io=init(&f);f.delay_fail_after=1;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_DELAY&&!f.writes);
+	io=init(&f);f.delay_fail_after=2;
+	assert(t736_a55clock_d_prepare(&io,&r)==T736_CPUCLOCK_DELAY && r.base.mutation_attempted && r.base.rollback_error && !f.ctrl_writes);
+	puts("A55 D host tests PASS: delayed/LOCK_EN/write-N N latch, buffered trace, unknown N/gate rejected, single bootstrap, EN retained, bounded faults and mux-only failure");
+	return 0;
+}
diff --git a/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock.c b/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock.c
new file mode 100644
index 0000000000000000000000000000000000000000..db5c0fa2d209129103c3ddf0b183b8703a93f8ad
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock.c
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Host fault injection for safety properties, not a hardware model or proof
+ * of the physical PLL/PMIC sequence. The board trials remain mandatory.
+ */
+#include "cpuclock.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define BIT(n) (UINT32_C(1) << (n))
+#define UPDATE BIT(26)
+#define OUTPUT BIT(27)
+#define LOCK BIT(28)
+#define LOCK_EN BIT(29)
+#define ENABLE BIT(31)
+#define N_MASK UINT32_C(0xff00)
+
+struct fake {
+	uint32_t regs[0x4000 / 4], xo, ppu6, ppu7;
+	uint8_t pmic[256];
+	unsigned int writes, pmic_reads, delays, bad_write, mux_fail_seen;
+	unsigned int no_lock, stuck_update, frozen_status, post_pmic_fail;
+	unsigned int supply_drift, guard_drift, delay_fail, rollback_mux_fail;
+	unsigned int post_ppu_drift;
+	unsigned int updates, disabled_updates;
+	unsigned int early_latch, unexpected_latch;
+};
+
+static uint32_t read32(void *ctx, uint32_t addr)
+{
+	struct fake *f = ctx;
+	if (addr == T736_CPUCLOCK_XO) return f->xo;
+	if (addr == T736_CPUCLOCK_PPU6) return f->ppu6;
+	if (addr == T736_CPUCLOCK_PPU7) return f->ppu7;
+	assert(addr >= T736_CPUCLOCK_BASE && addr < T736_CPUCLOCK_BASE + 0x4000);
+	assert(!(addr & 3));
+	return f->regs[(addr - T736_CPUCLOCK_BASE) / 4];
+}
+
+static void write32(void *ctx, uint32_t addr, uint32_t value)
+{
+	struct fake *f = ctx;
+	unsigned int off = addr - T736_CPUCLOCK_BASE;
+	uint32_t *ctrl = &f->regs[T736_CPUCLOCK_CTRL / 4];
+	uint32_t before = *ctrl;
+	f->writes++;
+	assert(!f->mux_fail_seen); /* No PLL shutdown after unconfirmed slow mux. */
+	assert(!(f->ppu6 & 0xf) && !(f->ppu7 & 0xf));
+	if (off != T736_CPUCLOCK_CTRL && off != T736_CPUCLOCK_CLK) {
+		f->bad_write++;
+		assert(0);
+	}
+	if (off == T736_CPUCLOCK_CLK) {
+		if (value == T736_CPUCLOCK_TARGET_CLK) {
+			assert(*ctrl == T736_CPUCLOCK_TARGET);
+			assert(f->regs[T736_CPUCLOCK_STAT / 4] == T736_CPUCLOCK_TARGET);
+		}
+		if (!value && f->rollback_mux_fail &&
+		    f->regs[T736_CPUCLOCK_CLK / 4] == T736_CPUCLOCK_TARGET_CLK) {
+			f->mux_fail_seen = 1;
+			return;
+		}
+		f->regs[off / 4] = value;
+		return;
+	}
+	assert(!(value & LOCK)); /* Never echo the read-only LOCK field. */
+	/* Linear CPU PLL semantics: gates are immediate, N remains the committed
+	 * old value until an enabled PLL receives UPDATE carrying the desired N.
+	 * This specifically models the first real-board trial's stale N read. */
+	*ctrl = (value & ~(N_MASK | UPDATE)) | (*ctrl & (N_MASK | UPDATE | LOCK));
+	if ((f->early_latch == 1 && (~before & value & ENABLE)) ||
+	    (f->early_latch == 2 && (~before & value & LOCK_EN)))
+		*ctrl = (*ctrl & ~N_MASK) | (f->unexpected_latch ? 0x3500 : (value & N_MASK));
+	if (!(value & ENABLE) || !(value & LOCK_EN)) *ctrl &= ~LOCK;
+	if (!f->frozen_status)
+		f->regs[T736_CPUCLOCK_STAT / 4] = *ctrl;
+	if (f->guard_drift && (value & 0xff00) == 0x2700)
+		f->regs[0x101c / 4] = 0x03000001;
+	if (value & UPDATE) {
+		f->updates++;
+		if (!(value & ENABLE)) {
+			f->disabled_updates++;
+			return;
+		}
+		*ctrl |= UPDATE;
+		if (f->stuck_update) return;
+		*ctrl &= ~(UPDATE | LOCK);
+		*ctrl = (*ctrl & ~N_MASK) | (value & N_MASK);
+		if ((value & (ENABLE | LOCK_EN)) == (ENABLE | LOCK_EN) && !f->no_lock)
+			*ctrl |= LOCK;
+		if (!f->frozen_status)
+			f->regs[T736_CPUCLOCK_STAT / 4] = *ctrl;
+	}
+}
+
+static int delay_us(void *ctx, uint32_t us)
+{
+	struct fake *f = ctx;
+	assert(us == 1 || us == 10 || us == 20);
+	f->delays++;
+	assert(f->delays <= 16000); /* A stuck counter cannot make an endless wait. */
+	return f->delay_fail ? -1 : 0;
+}
+
+static int pmic_read8(void *ctx, uint8_t reg, uint8_t *value)
+{
+	struct fake *f = ctx;
+	assert(reg == 0x0e || reg == 0x10 || reg == 0x14 || reg == 0x15 ||
+	       reg == 0x1b || reg == 0x1d);
+	f->pmic_reads++;
+	if (f->post_ppu_drift && f->pmic_reads == 12) f->ppu7 = 8;
+	if (f->post_pmic_fail && f->pmic_reads > 6) return -1;
+	*value = f->pmic[reg];
+	if (f->supply_drift && reg == 0x15 && f->pmic_reads > 6)
+		(*value)++;
+	return 0;
+}
+
+static struct t736_cpuclock_io init(struct fake *f)
+{
+	memset(f, 0, sizeof(*f));
+	f->regs[T736_CPUCLOCK_CTRL / 4] = T736_CPUCLOCK_ORIGINAL;
+	f->regs[T736_CPUCLOCK_STAT / 4] = T736_CPUCLOCK_ORIGINAL;
+	f->regs[0x2008 / 4] = 0x30000000;
+	f->regs[0x2018 / 4] = 0x40000001;
+	f->regs[0x1000 / 4] = f->regs[0x102c / 4] = 0xf8801300;
+	f->regs[0x101c / 4] = 0x03000000;
+	f->regs[0x3000 / 4] = f->regs[0x302c / 4] = 0xf8801300;
+	f->regs[0x301c / 4] = 0x03000105;
+	f->xo = 1u << 15;
+	f->pmic[0x0e] = 3;
+	f->pmic[0x10] = 0x7f;
+	f->pmic[0x14] = f->pmic[0x15] = 40;
+	return (struct t736_cpuclock_io){ f, read32, write32, delay_us,
+		pmic_read8, 0x412fd050, 0x80000000 };
+}
+
+static void assert_restored(struct fake *f, struct t736_cpuclock_report *r)
+{
+	assert(r->rollback_attempted && !r->rollback_error && r->slow_verified);
+	assert((r->final_ctrl & ~N_MASK) == (T736_CPUCLOCK_ORIGINAL & ~N_MASK));
+	assert((r->final_ctrl & N_MASK) == (T736_CPUCLOCK_ORIGINAL & N_MASK) ||
+	       (r->final_ctrl & N_MASK) == (T736_CPUCLOCK_TARGET & N_MASK));
+	assert(r->final_stat == r->final_ctrl);
+	assert(f->regs[T736_CPUCLOCK_CLK / 4] == 0);
+	assert(!f->bad_write);
+	assert(!f->disabled_updates);
+}
+
+int main(void)
+{
+	struct fake f;
+	struct t736_cpuclock_report r;
+	struct t736_cpuclock_io io;
+	int rc;
+	io = init(&f);
+	assert(t736_cpuclock_prepare(&io, &r) == 0);
+	assert(r.stage == 8 && !r.guard_failure && !r.rollback_attempted);
+	assert(r.final_ctrl == T736_CPUCLOCK_TARGET && r.final_clk == T736_CPUCLOCK_TARGET_CLK);
+	assert(f.pmic_reads == 12 && !f.bad_write);
+	assert(f.updates == 1 && !f.disabled_updates);
+	for (unsigned int latch = 1; latch <= 2; latch++) {
+		io = init(&f); f.early_latch = latch;
+		assert(t736_cpuclock_prepare(&io, &r) == 0);
+		assert(r.final_ctrl == T736_CPUCLOCK_TARGET && f.updates == 1);
+		assert(!f.disabled_updates && !r.rollback_attempted);
+	}
+	io = init(&f); f.early_latch = 1; f.unexpected_latch = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_VERIFY);
+	assert(r.rollback_attempted && r.rollback_error && r.slow_verified);
+	assert(!f.updates); /* Unrecognized N fails closed; no target commit. */
+
+	io = init(&f); f.pmic[0x14] |= 0x80; f.pmic[0x15] |= 0x80;
+	assert(t736_cpuclock_prepare(&io, &r) == 0); /* DVM is not voltage code. */
+	io = init(&f); f.pmic[0x15] = 29;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.pmic[0x1b] = 0x80;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.pmic[0x0e] = 2;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.ppu6 = 8;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.ppu7 = 8;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); io.midr = 0x410fd0b0;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.xo = 0;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.regs[T736_CPUCLOCK_STAT / 4] ^= 0x100;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+
+	io = init(&f); f.no_lock = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_TIMEOUT);
+	assert_restored(&f, &r);
+	io = init(&f); f.frozen_status = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_TIMEOUT);
+	assert(r.rollback_attempted && r.rollback_error && r.slow_verified);
+	io = init(&f); f.post_pmic_fail = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_PMIC);
+	assert_restored(&f, &r);
+	io = init(&f); f.supply_drift = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_SUPPLY);
+	assert_restored(&f, &r);
+	io = init(&f); f.guard_drift = 1;
+	assert(t736_cpuclock_prepare(&io, &r) == T736_CPUCLOCK_GUARD && r.guard_failure);
+	assert_restored(&f, &r);
+
+	io = init(&f); f.stuck_update = 1;
+	rc = t736_cpuclock_prepare(&io, &r);
+	assert(rc && r.rollback_attempted && r.rollback_error && r.slow_verified);
+	io = init(&f); f.delay_fail = 1;
+	rc = t736_cpuclock_prepare(&io, &r);
+	assert(rc == T736_CPUCLOCK_DELAY && r.rollback_error && r.slow_verified);
+	io = init(&f); f.post_pmic_fail = 1; f.rollback_mux_fail = 1;
+	rc = t736_cpuclock_prepare(&io, &r);
+	assert(rc && r.rollback_error && !r.slow_verified && f.mux_fail_seen);
+	assert(r.final_ctrl == T736_CPUCLOCK_TARGET); /* Leave PLL when mux uncertain. */
+	io = init(&f); f.post_ppu_drift = 1;
+	rc = t736_cpuclock_prepare(&io, &r);
+	assert(rc == T736_CPUCLOCK_GUARD && r.rollback_error && r.guard_failure);
+	assert(r.final_ctrl == T736_CPUCLOCK_TARGET); /* Never retune a newly live core. */
+
+	puts("CPUCLK host tests PASS: buffered N/active UPDATE, read-only refusals/DVM, bounded waits and rollback/PPU guards");
+	return 0;
+}
diff --git a/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock_c.c b/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock_c.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b3fb43ec0ae7d8b61dc4bf65228a967a5a307b8
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/cpuclock/test_cpuclock_c.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Host fault injection for safety properties, not a hardware model or proof
+ * of the physical PLL/PMIC sequence. The board trials remain mandatory.
+ */
+#include "cpuclock_c.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#define BIT(n) (UINT32_C(1) << (n))
+#define UPDATE BIT(26)
+#define OUTPUT BIT(27)
+#define LOCK BIT(28)
+#define LOCK_EN BIT(29)
+#define ENABLE BIT(31)
+#define N_MASK UINT32_C(0xff00)
+
+struct fake {
+	uint32_t regs[0x4000 / 4], xo, ppu6, ppu7;
+	uint8_t pmic[256];
+	unsigned int writes, pmic_reads, delays, bad_write, mux_fail_seen;
+	unsigned int no_lock, stuck_update, frozen_status, post_pmic_fail;
+	unsigned int supply_drift, guard_drift, delay_fail, rollback_mux_fail;
+	unsigned int post_ppu_drift;
+	unsigned int updates, disabled_updates;
+	unsigned int early_latch, unexpected_latch;
+};
+
+static uint32_t read32(void *ctx, uint32_t addr)
+{
+	struct fake *f = ctx;
+	if (addr == T736_CPUCLOCK_XO) return f->xo;
+	if (addr == T736_CPUCLOCK_PPU6) return f->ppu6;
+	if (addr == T736_CPUCLOCK_PPU7) return f->ppu7;
+	assert(addr >= T736_CPUCLOCK_BASE && addr < T736_CPUCLOCK_BASE + 0x4000);
+	assert(!(addr & 3));
+	return f->regs[(addr - T736_CPUCLOCK_BASE) / 4];
+}
+
+static void write32(void *ctx, uint32_t addr, uint32_t value)
+{
+	struct fake *f = ctx;
+	unsigned int off = addr - T736_CPUCLOCK_BASE;
+	uint32_t *ctrl = &f->regs[T736_CPUCLOCK_CTRL / 4];
+	uint32_t before = *ctrl;
+	f->writes++;
+	assert(!f->mux_fail_seen); /* No PLL shutdown after unconfirmed slow mux. */
+	assert(!(f->ppu6 & 0xf) && !(f->ppu7 & 0xf));
+	if (off != T736_CPUCLOCK_CTRL && off != T736_CPUCLOCK_CLK) {
+		f->bad_write++;
+		assert(0);
+	}
+	if (off == T736_CPUCLOCK_CLK) {
+		if (value == T736_CPUCLOCK_TARGET_CLK) {
+			assert(*ctrl == T736_CPUCLOCK_TARGET);
+			assert(f->regs[T736_CPUCLOCK_STAT / 4] == T736_CPUCLOCK_TARGET);
+		}
+		if (!value && f->rollback_mux_fail &&
+		    f->regs[T736_CPUCLOCK_CLK / 4] == T736_CPUCLOCK_TARGET_CLK) {
+			f->mux_fail_seen = 1;
+			return;
+		}
+		f->regs[off / 4] = value;
+		return;
+	}
+	assert(!(value & LOCK)); /* Never echo the read-only LOCK field. */
+	/* Linear CPU PLL semantics: gates are immediate, N remains the committed
+	 * old value until an enabled PLL receives UPDATE carrying the desired N.
+	 * This specifically models the first real-board trial's stale N read. */
+	*ctrl = (value & ~(N_MASK | UPDATE)) | (*ctrl & (N_MASK | UPDATE | LOCK));
+	if ((f->early_latch == 1 && (~before & value & ENABLE)) ||
+	    (f->early_latch == 2 && (~before & value & LOCK_EN)))
+		*ctrl = (*ctrl & ~N_MASK) | (f->unexpected_latch ? 0x3500 : (value & N_MASK));
+	if (!(value & ENABLE) || !(value & LOCK_EN)) *ctrl &= ~LOCK;
+	if (!f->frozen_status)
+		f->regs[T736_CPUCLOCK_STAT / 4] = *ctrl;
+	if (f->guard_drift && (value & 0xff00) == 0x2700)
+		f->regs[0x101c / 4] = 0x03000001;
+	if (value & UPDATE) {
+		f->updates++;
+		if (!(value & ENABLE)) {
+			f->disabled_updates++;
+			return;
+		}
+		*ctrl |= UPDATE;
+		if (f->stuck_update) return;
+		*ctrl &= ~(UPDATE | LOCK);
+		*ctrl = (*ctrl & ~N_MASK) | (value & N_MASK);
+		if ((value & (ENABLE | LOCK_EN)) == (ENABLE | LOCK_EN) && !f->no_lock)
+			*ctrl |= LOCK;
+		if (!f->frozen_status)
+			f->regs[T736_CPUCLOCK_STAT / 4] = *ctrl;
+	}
+}
+
+static int delay_us(void *ctx, uint32_t us)
+{
+	struct fake *f = ctx;
+	assert(us == 1 || us == 10 || us == 20);
+	f->delays++;
+	assert(f->delays <= 16000); /* A stuck counter cannot make an endless wait. */
+	return f->delay_fail ? -1 : 0;
+}
+
+static int pmic_read8(void *ctx, uint8_t reg, uint8_t *value)
+{
+	struct fake *f = ctx;
+	assert(reg == 0x0e || reg == 0x10 || reg == 0x14 || reg == 0x15 ||
+	       reg == 0x1b || reg == 0x1d);
+	f->pmic_reads++;
+	if (f->post_ppu_drift && f->pmic_reads == 12) f->ppu7 = 8;
+	if (f->post_pmic_fail && f->pmic_reads > 6) return -1;
+	*value = f->pmic[reg];
+	if (f->supply_drift && reg == 0x15 && f->pmic_reads > 6)
+		(*value)++;
+	return 0;
+}
+
+static struct t736_cpuclock_io init(struct fake *f)
+{
+	memset(f, 0, sizeof(*f));
+	f->regs[T736_CPUCLOCK_CTRL / 4] = T736_CPUCLOCK_ORIGINAL;
+	f->regs[T736_CPUCLOCK_STAT / 4] = T736_CPUCLOCK_ORIGINAL;
+	f->regs[0x2008 / 4] = 0x30000000;
+	f->regs[0x2018 / 4] = 0x40000001;
+	f->regs[0x1000 / 4] = f->regs[0x102c / 4] = 0xf8801300;
+	f->regs[0x101c / 4] = 0x03000000;
+	f->regs[0x3000 / 4] = f->regs[0x302c / 4] = 0xf8801300;
+	f->regs[0x301c / 4] = 0x03000105;
+	f->xo = 1u << 15;
+	f->pmic[0x0e] = 3;
+	f->pmic[0x10] = 0x7f;
+	f->pmic[0x14] = f->pmic[0x15] = 40;
+	return (struct t736_cpuclock_io){ f, read32, write32, delay_us,
+		pmic_read8, 0x412fd050, 0x80000000 };
+}
+
+static void assert_restored(struct fake *f, struct t736_cpuclock_c_report *r)
+{
+	assert(r->base.rollback_attempted && !r->base.rollback_error && r->base.slow_verified);
+	assert((r->base.final_ctrl & ~N_MASK) == (T736_CPUCLOCK_ORIGINAL & ~N_MASK));
+	assert((r->base.final_ctrl & N_MASK) == (T736_CPUCLOCK_ORIGINAL & N_MASK) ||
+	       (r->base.final_ctrl & N_MASK) == 0x2000 ||
+	       (r->base.final_ctrl & N_MASK) == (T736_CPUCLOCK_TARGET & N_MASK));
+	assert(r->base.final_stat == r->base.final_ctrl);
+	assert(f->regs[T736_CPUCLOCK_CLK / 4] == 0);
+	assert(!f->bad_write);
+	assert(!f->disabled_updates);
+}
+
+int main(void)
+{
+	struct fake f;
+	struct t736_cpuclock_c_report r;
+	struct t736_cpuclock_io io;
+	int rc;
+	io = init(&f);
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == 0);
+	assert(r.base.stage == 8 && !r.base.guard_failure && !r.base.rollback_attempted);
+	assert(r.base.final_ctrl == T736_CPUCLOCK_TARGET && r.base.final_clk == T736_CPUCLOCK_TARGET_CLK);
+	assert(f.pmic_reads == 12 && !f.bad_write);
+	assert(f.updates == 2 && !f.disabled_updates);
+	for (unsigned int latch = 1; latch <= 2; latch++) {
+		io = init(&f); f.early_latch = latch;
+		assert(t736_cpuclock_c_prepare(&io, &r, NULL) == 0);
+		assert(r.base.final_ctrl == T736_CPUCLOCK_TARGET && f.updates == 2);
+		assert(!f.disabled_updates && !r.base.rollback_attempted);
+	}
+	io = init(&f); f.early_latch = 1; f.unexpected_latch = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_VERIFY);
+	assert(r.base.rollback_attempted && r.base.rollback_error && r.base.slow_verified);
+	assert(!f.updates); /* Unrecognized N fails closed; no target commit. */
+	assert(r.failure_recorded && r.failed.step == 5 && r.failed.actual != r.base.final_ctrl);
+
+	io = init(&f); f.pmic[0x14] |= 0x80; f.pmic[0x15] |= 0x80;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == 0); /* DVM is not voltage code. */
+	io = init(&f); f.pmic[0x15] = 29;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.pmic[0x1b] = 0x80;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.pmic[0x0e] = 2;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_SUPPLY && !f.writes);
+	io = init(&f); f.ppu6 = 8;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.ppu7 = 8;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); io.midr = 0x410fd0b0;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.xo = 0;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+	io = init(&f); f.regs[T736_CPUCLOCK_STAT / 4] ^= 0x100;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PRECONDITION && !f.writes);
+
+	io = init(&f); f.no_lock = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_TIMEOUT);
+	assert_restored(&f, &r);
+	io = init(&f); f.frozen_status = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_VERIFY);
+	assert(r.base.rollback_attempted && r.base.rollback_error && r.base.slow_verified);
+	io = init(&f); f.post_pmic_fail = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_PMIC);
+	assert_restored(&f, &r);
+	io = init(&f); f.supply_drift = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_SUPPLY);
+	assert_restored(&f, &r);
+	io = init(&f); f.guard_drift = 1;
+	assert(t736_cpuclock_c_prepare(&io, &r, NULL) == T736_CPUCLOCK_GUARD && r.base.guard_failure);
+	assert_restored(&f, &r);
+
+	io = init(&f); f.stuck_update = 1;
+	rc = t736_cpuclock_c_prepare(&io, &r, NULL);
+	assert(rc && r.base.rollback_attempted && r.base.rollback_error && r.base.slow_verified);
+	io = init(&f); f.delay_fail = 1;
+	rc = t736_cpuclock_c_prepare(&io, &r, NULL);
+	assert(rc == T736_CPUCLOCK_DELAY && r.base.rollback_error && r.base.slow_verified);
+	io = init(&f); f.post_pmic_fail = 1; f.rollback_mux_fail = 1;
+	rc = t736_cpuclock_c_prepare(&io, &r, NULL);
+	assert(rc && r.base.rollback_error && !r.base.slow_verified && f.mux_fail_seen);
+	assert(r.base.final_ctrl == T736_CPUCLOCK_TARGET); /* Leave PLL when mux uncertain. */
+	io = init(&f); f.post_ppu_drift = 1;
+	rc = t736_cpuclock_c_prepare(&io, &r, NULL);
+	assert(rc == T736_CPUCLOCK_GUARD && r.base.rollback_error && r.base.guard_failure);
+	assert(r.base.final_ctrl == T736_CPUCLOCK_TARGET); /* Never retune a newly live core. */
+
+	puts("CPU-C host tests PASS: cold416/warm1014 two commits; buffered N/active UPDATE, read-only refusals/DVM, bounded waits and rollback/PPU guards");
+	return 0;
+}
diff --git a/userpatches/atlasa1-release/spl/early/platform.c b/userpatches/atlasa1-release/spl/early/platform.c
new file mode 100644
index 0000000000000000000000000000000000000000..90fe17a9bc5aa204b247d5c9f038cddd9c3b8a9d
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/platform.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "platform.h"
+
+struct t736_timer_state t736_timer_observation;
+
+uint32_t t736_counter_frequency(void)
+{
+	uint32_t value;
+	__asm__ volatile("mrc p15, 0, %0, c14, c0, 0" : "=r"(value));
+	return value;
+}
+
+uint32_t t736_counter_low(void)
+{
+	uint32_t lo, hi;
+	__asm__ volatile("isb\n\tmrrc p15, 0, %0, %1, c14" : "=r"(lo), "=r"(hi) :: "memory");
+	return lo;
+}
+
+static uint32_t timestamp_read(void *context, uint32_t address)
+{
+	(void)context;
+	return t736_read32(address);
+}
+
+static void timestamp_write(void *context, uint32_t address, uint32_t value)
+{
+	(void)context;
+	t736_write32(address, value);
+}
+
+static uint32_t timestamp_counter(void *context)
+{
+	(void)context;
+	return t736_counter_low();
+}
+
+static uint32_t timestamp_cntfrq(void *context)
+{
+	(void)context;
+	return t736_counter_frequency();
+}
+
+int t736_timer_init(void)
+{
+	const struct t736_timer_io io = {0, timestamp_read, timestamp_write,
+		timestamp_counter, timestamp_cntfrq};
+	return t736_timestamp_prepare(&io, &t736_timer_observation, T736_POLL_LIMIT);
+}
+
+int t736_delay_us(uint32_t usec)
+{
+	uint32_t begin, i;
+	if (t736_timer_observation.effective_hz != T736_COUNTER_HZ || usec > 0x7fffffffu / 24u)
+		return -1;
+	begin = t736_counter_low();
+	for (i = 0; i < T736_POLL_LIMIT; i++)
+		if ((uint32_t)(t736_counter_low() - begin) >= usec * 24u)
+			return 0;
+	return -1;
+}
+
+int t736_wait32(uintptr_t address, uint32_t mask, uint32_t value, uint32_t usec)
+{
+	uint32_t begin, i;
+	if (t736_timer_observation.effective_hz != T736_COUNTER_HZ || usec > 0x7fffffffu / 24u || (value & ~mask))
+		return -1;
+	begin = t736_counter_low();
+	for (i = 0; i < T736_POLL_LIMIT; i++) {
+		if ((t736_read32(address) & mask) == value)
+			return 0;
+		if ((uint32_t)(t736_counter_low() - begin) >= usec * 24u)
+			break;
+	}
+	return -1;
+}
diff --git a/userpatches/atlasa1-release/spl/early/platform.h b/userpatches/atlasa1-release/spl/early/platform.h
new file mode 100644
index 0000000000000000000000000000000000000000..19b09e4c0bb88537534dfbea73ed4c3e34a31741
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/platform.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef T736_EARLY_PLATFORM_H
+#define T736_EARLY_PLATFORM_H
+#include <stdint.h>
+#include "timer_init.h"
+#define T736_COUNTER_HZ 24000000u
+#define T736_POLL_LIMIT 1000000u
+
+static inline uint32_t t736_read32(uintptr_t address)
+{
+	uint32_t value = *(volatile uint32_t *)address;
+	__asm__ volatile("dmb sy" ::: "memory");
+	return value;
+}
+static inline void t736_write32(uintptr_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static inline void t736_clrset32(uintptr_t address, uint32_t mask, uint32_t value)
+{
+	t736_write32(address, (t736_read32(address) & ~mask) | value);
+}
+uint32_t t736_counter_frequency(void);
+uint32_t t736_counter_low(void);
+/* Validate/init T736 fixed-rate timestamp metadata/EN, then require CNTPCT advance.
+ * CNTFRQ may be zero in BootROM; this does not write the CP15 CNTFRQ register. */
+int t736_timer_init(void);
+/* All waits also terminate if the physical counter stalls. */
+int t736_delay_us(uint32_t usec);
+int t736_wait32(uintptr_t address, uint32_t mask, uint32_t value, uint32_t usec);
+#endif
diff --git a/userpatches/atlasa1-release/spl/early/probe.c b/userpatches/atlasa1-release/spl/early/probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..ae92e938bb720085206e7d0fec1ebc28df38ad6e
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/probe.c
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "platform.h"
+#include "twi.h"
+
+#define PIO 0x02000000u
+#define CCU 0x02002000u
+#define UART 0x02500000u
+#define PRCM 0x07010000u
+#define RPIO 0x07025000u
+#define TWI0 0x07083000u
+#define PMIC 0x36u
+
+/* Fixed SRAM report at 0x4e000, 16 little-endian uint32_t words. */
+struct report {
+	uint32_t magic, version, status, counter_hz, timer_delta;
+	uint32_t pmic_id, twi_status, cleanup_error;
+	uint32_t rail_registers[6], sctlr, raw_cntfrq;
+};
+volatile struct report probe_report __attribute__((section(".report")));
+extern char __stack_bottom[], __stack_top[];
+
+static void uart_init(void)
+{
+	/* PB9/PB10, function 2; T736 main PIO uses 0x80 bank stride. */
+	t736_clrset32(PIO + 0x104, 0xff0, 0x220);
+	/* APB_UART = SYS_CLK24M / 1. UART0 clock/reset only. */
+	t736_clrset32(CCU + 0x538, 0x0700001f, 0);
+	t736_clrset32(CCU + 0xe00, 0, (1u << 16) | 1u);
+	t736_write32(UART + 0x04, 0);
+	t736_write32(UART + 0x0c, 0x80);
+	t736_write32(UART + 0x00, 13); /* 115384 baud at 24 MHz, error +0.16%. */
+	t736_write32(UART + 0x04, 0);
+	t736_write32(UART + 0x0c, 3);
+	t736_write32(UART + 0x08, 7);
+}
+
+static void putc_uart(char c)
+{
+	uint32_t n;
+	for (n = 0; n < T736_POLL_LIMIT; n++)
+		if (t736_read32(UART + 0x14) & 0x20) {
+			t736_write32(UART, (uint8_t)c);
+			return;
+		}
+}
+
+static void puts_uart(const char *s)
+{
+	for (; *s; s++) {
+		if (*s == '\n')
+			putc_uart('\r');
+		putc_uart(*s);
+	}
+}
+
+static void hex(uint32_t value)
+{
+	int shift;
+	for (shift = 28; shift >= 0; shift -= 4)
+		putc_uart("0123456789abcdef"[(value >> shift) & 15]);
+}
+
+static void field(const char *name, uint32_t value)
+{
+	puts_uart(name);
+	hex(value);
+	puts_uart("\n");
+}
+
+static uint32_t bus_read(void *ctx, uint32_t offset)
+{
+	(void)ctx;
+	return t736_read32(TWI0 + offset);
+}
+
+static void bus_write(void *ctx, uint32_t offset, uint32_t value)
+{
+	(void)ctx;
+	t736_write32(TWI0 + offset, value);
+}
+
+static uint32_t bus_ticks(void *ctx)
+{
+	(void)ctx;
+	return t736_counter_low();
+}
+
+int probe_main(void)
+{
+	static const uint8_t registers[] = {0x10, 0x19, 0x20, 0x27, 0x22, 0x3a};
+	static struct t736_twi bus = {
+		.ctx = 0, .read = bus_read, .write = bus_write, .ticks = bus_ticks,
+		.timeout_ticks = 240000, .poll_limit = T736_POLL_LIMIT
+	};
+	uint32_t i, begin;
+	uint8_t value = 0;
+	int rc;
+	volatile uint32_t *words = (volatile uint32_t *)&probe_report;
+	for (i = 0; i < 16; i++)
+		words[i] = 0;
+	probe_report.magic = 0x54373336; /* T736 */
+	probe_report.version = 2;
+	probe_report.status = 1; /* entered */
+	__asm__ volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(i));
+	probe_report.sctlr = i;
+	uart_init();
+	puts_uart("T736 SRAM source probe v2; NO DDR INITIALIZATION\n");
+	field("stack.bottom=", (uintptr_t)__stack_bottom);
+	field("stack.top=", (uintptr_t)__stack_top);
+	probe_report.raw_cntfrq = t736_counter_frequency();
+	field("counter.raw_cntfrq=", probe_report.raw_cntfrq);
+	rc = t736_timer_init();
+	probe_report.counter_hz = t736_timer_observation.effective_hz;
+	field("timestamp.ctrl.before=", t736_timer_observation.ctrl_before);
+	field("timestamp.freqid.before=", t736_timer_observation.freqid_before);
+	field("timestamp.advanced.before=", t736_timer_observation.advanced_before);
+	field("timestamp.ctrl.after=", t736_timer_observation.ctrl_after);
+	field("timestamp.freqid.after=", t736_timer_observation.freqid_after);
+	field("counter.effective_hw_hz=", probe_report.counter_hz);
+	if (rc) {
+		probe_report.status = 0x101;
+		puts_uart("FAIL: physical counter unavailable or wrong frequency\n");
+		return rc;
+	}
+	begin = t736_counter_low();
+	rc = t736_delay_us(10);
+	probe_report.timer_delta = t736_counter_low() - begin;
+	if (rc) {
+		probe_report.status = 0x102;
+		return rc;
+	}
+	/* Read existing autonomous-master state before changing APBS1/pins. */
+	t736_clrset32(PRCM + 0x19c, 0, (1u << 16) | 1u);
+	if ((bus_read(0, TWI_DRV_CTRL) & 0x80000001u) ||
+	    (bus_read(0, TWI_PMU_CTRL) & 0xff)) {
+		probe_report.status = 0x103;
+		puts_uart("FAIL: active TWI packet/DVFS engine\n");
+		return TWI_BUSY;
+	}
+	/* APBS1 = SYS_CLK24M / 1; PL0/PL1 function 2, preserve other pins. */
+	t736_clrset32(PRCM + 0x10, 0x0700001f, 4u << 24);
+	t736_clrset32(RPIO, 0xff, 0x22);
+	rc = t736_twi_init(&bus);
+	if (!rc)
+		rc = t736_twi_read8(&bus, PMIC, 0x0e, &value);
+	probe_report.pmic_id = value;
+	field("pmic.id=", value);
+	if (!rc && value != 3)
+		rc = -8;
+	for (i = 0; !rc && i < sizeof(registers); i++) {
+		rc = t736_twi_read8(&bus, PMIC, registers[i], &value);
+		if (!rc) {
+			probe_report.rail_registers[i] = value;
+			puts_uart("pmic.reg="); hex(registers[i]);
+			puts_uart(" value="); hex(value); puts_uart("\n");
+		}
+	}
+	probe_report.twi_status = bus.last_status;
+	probe_report.cleanup_error = (uint32_t)bus.cleanup_error;
+	probe_report.status = rc ? 0x200u + (uint32_t)(-rc) : 2;
+	field("probe.status=", probe_report.status);
+	puts_uart("PMIC writes: 0; DDR tested: NO; returning to FEL caller\n");
+	__asm__ volatile("dsb sy" ::: "memory");
+	return rc;
+}
diff --git a/userpatches/atlasa1-release/spl/early/test_timer.c b/userpatches/atlasa1-release/spl/early/test_timer.c
new file mode 100644
index 0000000000000000000000000000000000000000..2db461a5b68c1e6f46efb605bc5f4aafebbe9aac
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/test_timer.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "timer_init.h"
+#include <assert.h>
+#include <stdio.h>
+
+struct fake { uint32_t ctrl, fid, freq, count, writes, addresses[4]; int stalled, drop_fid, drop_en; };
+static uint32_t rd(void *p, uint32_t a)
+{
+	struct fake *f = p;
+	assert(a == T736_TIMESTAMP_CTRL || a == T736_TIMESTAMP_FREQID);
+	return a == T736_TIMESTAMP_CTRL ? f->ctrl : f->fid;
+}
+static void wr(void *p, uint32_t a, uint32_t v)
+{
+	struct fake *f = p;
+	assert(a == T736_TIMESTAMP_CTRL || a == T736_TIMESTAMP_FREQID);
+	assert(f->writes < 4u); f->addresses[f->writes++] = a;
+	if (a == T736_TIMESTAMP_CTRL) { if (!f->drop_en) f->ctrl = v; }
+	else if (!f->drop_fid) f->fid = v;
+}
+static uint32_t count(void *p)
+{
+	struct fake *f = p;
+	if ((f->ctrl & 1u) && !f->stalled) f->count++;
+	return f->count;
+}
+static uint32_t freq(void *p) { return ((struct fake *)p)->freq; }
+static int run(struct fake *f, struct t736_timer_state *s)
+{
+	const struct t736_timer_io io = {f, rd, wr, count, freq};
+	return t736_timestamp_prepare(&io, s, 100);
+}
+int main(void)
+{
+	struct t736_timer_state s;
+	struct fake f = {.ctrl=1, .fid=T736_TIMESTAMP_HZ, .count=100};
+	assert(run(&f,&s)==0 && f.writes==0 && s.raw_cntfrq==0 && s.advanced_before==1 && s.effective_hz==T736_TIMESTAMP_HZ);
+	f=(struct fake){.count=1234};
+	assert(run(&f,&s)==0 && f.writes==2 && f.count>1234 && s.advanced_before==0);
+	assert(f.addresses[0]==T736_TIMESTAMP_FREQID && f.addresses[1]==T736_TIMESTAMP_CTRL);
+	f=(struct fake){.ctrl=1, .count=0xfffffffeu};
+	assert(run(&f,&s)==0 && f.writes==1 && s.advanced_before==1);
+	f=(struct fake){.ctrl=1, .fid=T736_TIMESTAMP_HZ, .freq=19200000};
+	assert(run(&f,&s)==-2 && f.writes==0 && s.effective_hz==0);
+	f=(struct fake){.ctrl=1, .fid=19200000};
+	assert(run(&f,&s)==-2 && f.writes==0);
+	f=(struct fake){.drop_fid=1};
+	assert(run(&f,&s)==-3 && f.writes==1 && f.ctrl==0);
+	f=(struct fake){.drop_en=1};
+	assert(run(&f,&s)==-3 && f.writes==2 && s.effective_hz==0);
+	f=(struct fake){.stalled=1};
+	assert(run(&f,&s)==-4 && s.effective_hz==0 && f.count==0);
+	f=(struct fake){.ctrl=1, .fid=T736_TIMESTAMP_HZ, .stalled=1};
+	assert(run(&f,&s)==-4 && f.writes==0);
+	f=(struct fake){.ctrl=1, .fid=T736_TIMESTAMP_HZ, .freq=T736_TIMESTAMP_HZ};
+	assert(run(&f,&s)==0 && f.writes==0);
+	puts("Timer tests PASS: raw CNTFRQ zero, enabled/no-write, metadata-only, stopped/enable, wrap, mismatches, failed readbacks, no counter-value/CNTFRQ writes");
+	return 0;
+}
diff --git a/userpatches/atlasa1-release/spl/early/test_twi.c b/userpatches/atlasa1-release/spl/early/test_twi.c
new file mode 100644
index 0000000000000000000000000000000000000000..267d3f0d4b96e9b268b18676104d56f8397eccc0
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/test_twi.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "twi.h"
+
+struct fake {
+	uint8_t states[8], sent[8];
+	unsigned pos, state_count, sent_count, starts, stops, resets;
+	uint32_t ctrl, status, time, step, clock, lines, drv, pmu, reads;
+	int stall_at, stop_stuck, reset_stuck;
+};
+static uint32_t read_reg(void *p, uint32_t reg)
+{
+	struct fake *f = p;
+	f->reads++;
+	switch (reg) {
+	case TWI_CTRL: return f->ctrl;
+	case TWI_STATUS: return f->status;
+	case TWI_RESET: return f->reset_stuck;
+	case TWI_LINE: return f->lines;
+	case TWI_DATA: return 3;
+	case TWI_DRV_CTRL: return f->drv;
+	case TWI_PMU_CTRL: return f->pmu;
+	default: return 0;
+	}
+}
+static void write_reg(void *p, uint32_t reg, uint32_t value)
+{
+	struct fake *f = p;
+	if (reg == TWI_RESET) {
+		f->resets++; f->status = 0xf8; f->ctrl = 0;
+	} else if (reg == TWI_CLOCK) {
+		f->clock = value;
+	} else if (reg == TWI_DATA) {
+		assert(f->sent_count < sizeof(f->sent));
+		f->sent[f->sent_count++] = (uint8_t)value;
+	} else if (reg == TWI_CTRL) {
+		assert(!(value & TWI_ACK)); /* final byte must be NACKed */
+		if (!(value & TWI_IF)) { f->ctrl = value; return; }
+		if (value & TWI_STOP) {
+			f->stops++;
+			f->ctrl = f->stop_stuck ? value : TWI_EN;
+			if (!f->stop_stuck) f->status = 0xf8;
+			return;
+		}
+		assert(f->pos < f->state_count);
+		if (value & TWI_START) f->starts++;
+		f->ctrl = TWI_EN;
+		if ((int)f->pos != f->stall_at) {
+			f->status = f->states[f->pos]; f->ctrl |= TWI_IF;
+		}
+		f->pos++;
+	}
+}
+static uint32_t ticks(void *p)
+{
+	struct fake *f = p;
+	f->time += f->step;
+	return f->time;
+}
+static struct t736_twi setup(struct fake *f)
+{
+	static const uint8_t read_states[] = {8, 0x18, 0x28, 0x10, 0x40, 0x58};
+	memset(f, 0, sizeof(*f));
+	memcpy(f->states, read_states, sizeof(read_states));
+	f->state_count = sizeof(read_states); f->stall_at = -1;
+	f->lines = 0x30; f->status = 0xf8; f->step = 1;
+	return (struct t736_twi){.ctx = f, .read = read_reg, .write = write_reg,
+		.ticks = ticks, .timeout_ticks = 10, .poll_limit = 20};
+}
+int main(void)
+{
+	struct fake f;
+	struct t736_twi b = setup(&f);
+	uint8_t value = 0xaa;
+	unsigned i;
+	assert(t736_twi_init(&b) == 0);
+	assert(f.clock == 0x59 && f.resets == 1);
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == 0 && value == 3);
+	assert(f.starts == 2 && f.stops == 1 && f.pos == 6);
+	assert(f.sent_count == 3 && f.sent[0] == 0x6c && f.sent[1] == 0x0e && f.sent[2] == 0x6d);
+	b = setup(&f); f.states[3] = 0x28; f.state_count = 4;
+	assert(t736_twi_write8(&b, 0x36, 0x19, 0x55) == 0);
+	assert(f.sent_count == 3 && f.sent[2] == 0x55 && f.starts == 1 && f.stops == 1);
+	for (i = 0; i < 6; i++) {
+		b = setup(&f); f.states[i] = 0x20; value = 0xaa;
+		assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_NACK);
+		assert(value == 0xaa && f.stops == 1 && f.pos == i + 1);
+		b = setup(&f); f.states[i] = 0x38;
+		assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_ARBITRATION);
+		assert(f.stops == 0 && f.resets == 1);
+		b = setup(&f); f.stall_at = (int)i;
+		assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_TIMEOUT);
+		assert(f.stops == 1 && f.reads < 100);
+	}
+	b = setup(&f); f.step = 0; f.stall_at = 0;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_TIMEOUT && f.reads < 100);
+	b = setup(&f); f.stop_stuck = 1; value = 0xaa;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_TIMEOUT);
+	assert(value == 0xaa && f.resets == 1 && b.cleanup_error == TWI_TIMEOUT);
+	b = setup(&f); f.states[1] = 0x20; f.stop_stuck = 1;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_NACK && b.cleanup_error == TWI_TIMEOUT);
+	b = setup(&f); f.reset_stuck = 1;
+	assert(t736_twi_init(&b) == TWI_TIMEOUT && f.reads < 100);
+	b = setup(&f); f.lines = 0x20;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_BUSY && !f.starts && !f.stops);
+	b = setup(&f); f.drv = 1;
+	assert(t736_twi_init(&b) == TWI_BUSY && !f.resets);
+	b = setup(&f); f.pmu = 0x80;
+	assert(t736_twi_init(&b) == TWI_BUSY && !f.resets);
+	b = setup(&f); f.time = 0xfffffff8u; f.stall_at = 0;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_TIMEOUT && f.reads < 100);
+	assert(t736_twi_read8(&b, 0x80, 0x0e, &value) == TWI_INVALID);
+	b.read = 0;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_INVALID);
+	b = setup(&f); f.states[0] = 0;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_BUS_ERROR);
+	b = setup(&f); f.states[0] = 0x50;
+	assert(t736_twi_read8(&b, 0x36, 0x0e, &value) == TWI_UNEXPECTED);
+	puts("TWI tests PASS: read/write, W1C/repeated-start, NACK/arbitration/timeout at every phase, stopped counter, wraparound, STOP failure, busy engines");
+	return 0;
+}
diff --git a/userpatches/atlasa1-release/spl/early/timer_init.c b/userpatches/atlasa1-release/spl/early/timer_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..4ba89dc74095e3f99faa87e75f90d81082104967
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/timer_init.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "timer_init.h"
+
+int t736_timestamp_prepare(const struct t736_timer_io *io,
+			   struct t736_timer_state *s, uint32_t limit)
+{
+	uint32_t i, begin;
+	if (!io || !s || !io->read32 || !io->write32 || !io->counter || !io->cntfrq ||
+	    !limit || limit > 1000000u)
+		return -1;
+	s->effective_hz = 0;
+	s->advanced_before = 0;
+	s->ctrl_before = s->ctrl_after = io->read32(io->context, T736_TIMESTAMP_CTRL);
+	s->freqid_before = s->freqid_after = io->read32(io->context, T736_TIMESTAMP_FREQID);
+	s->raw_cntfrq = io->cntfrq(io->context);
+	s->counter_before = io->counter(io->context);
+	/* This is an observation, not a timing loop; CNTFRQ=0 is not a dead timer. */
+	for (i = 0; i < 128u; i++)
+		if (io->counter(io->context) != s->counter_before) {
+			s->advanced_before = 1;
+			break;
+		}
+	if ((s->raw_cntfrq && s->raw_cntfrq != T736_TIMESTAMP_HZ) ||
+	    (s->freqid_before && s->freqid_before != T736_TIMESTAMP_HZ))
+		return -2;
+	if (!s->freqid_before) {
+		io->write32(io->context, T736_TIMESTAMP_FREQID, T736_TIMESTAMP_HZ);
+		s->freqid_after = io->read32(io->context, T736_TIMESTAMP_FREQID);
+		if (s->freqid_after != T736_TIMESTAMP_HZ)
+			return -3;
+	}
+	if (!(s->ctrl_before & 1u)) {
+		io->write32(io->context, T736_TIMESTAMP_CTRL, s->ctrl_before | 1u);
+		s->ctrl_after = io->read32(io->context, T736_TIMESTAMP_CTRL);
+		if (!(s->ctrl_after & 1u))
+			return -3;
+	}
+	begin = io->counter(io->context);
+	for (i = 0; i < limit; i++)
+		if (io->counter(io->context) != begin) {
+			/* Documented fixed hardware rate; not an oscillator measurement. */
+			s->effective_hz = T736_TIMESTAMP_HZ;
+			return 0;
+		}
+	return -4;
+}
diff --git a/userpatches/atlasa1-release/spl/early/timer_init.h b/userpatches/atlasa1-release/spl/early/timer_init.h
new file mode 100644
index 0000000000000000000000000000000000000000..d11f68e316e950f27eb6f6dcdbeeb62f61008232
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/timer_init.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef T736_EARLY_TIMER_INIT_H
+#define T736_EARLY_TIMER_INIT_H
+#include <stdint.h>
+#define T736_TIMESTAMP_CTRL UINT32_C(0x08020000)
+#define T736_TIMESTAMP_FREQID UINT32_C(0x08020020)
+#define T736_TIMESTAMP_HZ UINT32_C(24000000)
+struct t736_timer_io {
+	void *context;
+	uint32_t (*read32)(void *, uint32_t);
+	void (*write32)(void *, uint32_t, uint32_t);
+	uint32_t (*counter)(void *);
+	uint32_t (*cntfrq)(void *);
+};
+struct t736_timer_state {
+	uint32_t ctrl_before, freqid_before, raw_cntfrq, counter_before;
+	uint32_t advanced_before, ctrl_after, freqid_after, effective_hz;
+};
+/* T736 manual 5.1.8: +0 bit0 enables; +0x20 only records the fixed clock
+ * frequency, it does not set/divide it. SyterKit ARM timer uses 24 MHz.
+ * No counter-value or CNTFRQ writes. Reject conflicting nonzero metadata.
+ */
+int t736_timestamp_prepare(const struct t736_timer_io *, struct t736_timer_state *, uint32_t);
+extern struct t736_timer_state t736_timer_observation;
+#endif
diff --git a/userpatches/atlasa1-release/spl/early/twi.c b/userpatches/atlasa1-release/spl/early/twi.c
new file mode 100644
index 0000000000000000000000000000000000000000..8a5d44157cfc2ff742e7d73ca06e0af1ceb7c22b
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/twi.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T736 User Manual v0.90, 18.11.10: S_TWI0 byte engine.
+ * INT_FLAG is W1C. No automatic retries: PMIC writes must be explicit.
+ */
+#include "twi.h"
+
+static int valid(const struct t736_twi *b)
+{
+	return b && b->read && b->write && b->ticks &&
+		b->timeout_ticks && b->timeout_ticks < 0x80000000u && b->poll_limit;
+}
+
+static int wait_mask(struct t736_twi *b, uint32_t reg, uint32_t mask, uint32_t value)
+{
+	uint32_t begin = b->ticks(b->ctx), count;
+	for (count = 0; count < b->poll_limit; count++) {
+		if ((b->read(b->ctx, reg) & mask) == value)
+			return TWI_OK;
+		if ((uint32_t)(b->ticks(b->ctx) - begin) >= b->timeout_ticks)
+			break;
+	}
+	return TWI_TIMEOUT;
+}
+
+static int reset(struct t736_twi *b)
+{
+	b->write(b->ctx, TWI_RESET, 1);
+	return wait_mask(b, TWI_RESET, 1, 0);
+}
+
+static int state(struct t736_twi *b, unsigned expected)
+{
+	int rc = wait_mask(b, TWI_CTRL, TWI_IF, TWI_IF);
+	b->last_status = b->read(b->ctx, TWI_STATUS) & 0xff;
+	if (rc)
+		return rc;
+	if (b->last_status == expected)
+		return TWI_OK;
+	switch (b->last_status) {
+	case 0x20: case 0x30: case 0x48: return TWI_NACK;
+	case 0x38: return TWI_ARBITRATION;
+	case 0: return TWI_BUS_ERROR;
+	default: return TWI_UNEXPECTED;
+	}
+}
+
+static int stop(struct t736_twi *b)
+{
+	int rc;
+	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_STOP | TWI_IF);
+	rc = wait_mask(b, TWI_CTRL, TWI_STOP, 0);
+	if (rc)
+		return rc;
+	return wait_mask(b, TWI_STATUS, 0xff, 0xf8);
+}
+
+static int finish(struct t736_twi *b, int rc)
+{
+	/* After arbitration loss we no longer own the wires: never send STOP. */
+	b->cleanup_error = rc == TWI_ARBITRATION ? reset(b) : stop(b);
+	if (b->cleanup_error && rc != TWI_ARBITRATION)
+		(void)reset(b);
+	return rc ? rc : b->cleanup_error;
+}
+
+static int send(struct t736_twi *b, uint8_t value, unsigned expected)
+{
+	b->write(b->ctx, TWI_DATA, value);
+	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_IF);
+	return state(b, expected);
+}
+
+static int begin(struct t736_twi *b, uint8_t address, uint8_t reg)
+{
+	int rc;
+	b->cleanup_error = 0;
+	/* No attempt to clear a stuck bus by clocking the PMIC blindly. */
+	if ((b->read(b->ctx, TWI_LINE) & 0x30) != 0x30 ||
+	    (b->read(b->ctx, TWI_STATUS) & 0xff) != 0xf8)
+		return TWI_BUSY;
+	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_START | TWI_IF);
+	rc = state(b, 0x08);
+	if (!rc)
+		rc = send(b, (uint8_t)(address << 1), 0x18);
+	if (!rc)
+		rc = send(b, reg, 0x28);
+	return rc;
+}
+
+int t736_twi_init(struct t736_twi *b)
+{
+	int rc;
+	if (!valid(b))
+		return TWI_INVALID;
+	b->cleanup_error = 0;
+	b->last_status = 0xf8;
+	/* Refuse to take over an active hardware DVFS/packet master. */
+	if ((b->read(b->ctx, TWI_DRV_CTRL) & 0x80000001u) ||
+	    (b->read(b->ctx, TWI_PMU_CTRL) & 0xff))
+		return TWI_BUSY;
+	rc = reset(b);
+	if (rc)
+		return rc;
+	/* 24 MHz / (2^1 * (11 + 1) * 10) = 100 kHz, duty cycle 50%. */
+	b->write(b->ctx, TWI_CLOCK, (11u << 3) | 1u);
+	b->write(b->ctx, TWI_EFR, 0);
+	b->write(b->ctx, TWI_CTRL, TWI_EN);
+	return TWI_OK;
+}
+
+int t736_twi_read8(struct t736_twi *b, uint8_t address, uint8_t reg, uint8_t *value)
+{
+	int rc;
+	uint8_t received = 0;
+	if (!valid(b) || !value || address > 0x7f)
+		return TWI_INVALID;
+	rc = begin(b, address, reg);
+	if (rc == TWI_BUSY)
+		return rc;
+	if (!rc) {
+		b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_START | TWI_IF);
+		rc = state(b, 0x10);
+	}
+	if (!rc)
+		rc = send(b, (uint8_t)((address << 1) | 1), 0x40);
+	if (!rc) {
+		/* One byte only: leave ACK clear and end with a NACK. */
+		b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_IF);
+		rc = state(b, 0x58);
+	}
+	if (!rc)
+		received = (uint8_t)b->read(b->ctx, TWI_DATA);
+	rc = finish(b, rc);
+	if (!rc)
+		*value = received;
+	return rc;
+}
+
+int t736_twi_write8(struct t736_twi *b, uint8_t address, uint8_t reg, uint8_t value)
+{
+	int rc;
+	if (!valid(b) || address > 0x7f)
+		return TWI_INVALID;
+	rc = begin(b, address, reg);
+	if (rc == TWI_BUSY)
+		return rc;
+	if (!rc)
+		rc = send(b, value, 0x28);
+	return finish(b, rc);
+}
diff --git a/userpatches/atlasa1-release/spl/early/twi.h b/userpatches/atlasa1-release/spl/early/twi.h
new file mode 100644
index 0000000000000000000000000000000000000000..cedd670de6e4a0f86b24793cd1829043c3d1838c
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/early/twi.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef T736_EARLY_TWI_H
+#define T736_EARLY_TWI_H
+#include <stdint.h>
+
+enum {
+	TWI_DATA = 0x08, TWI_CTRL = 0x0c, TWI_STATUS = 0x10,
+	TWI_CLOCK = 0x14, TWI_RESET = 0x18, TWI_EFR = 0x1c,
+	TWI_LINE = 0x20, TWI_DRV_CTRL = 0x200, TWI_PMU_CTRL = 0x314,
+	TWI_ACK = 4, TWI_IF = 8, TWI_STOP = 16, TWI_START = 32, TWI_EN = 64
+};
+enum t736_twi_error {
+	TWI_OK = 0, TWI_TIMEOUT = -1, TWI_NACK = -2,
+	TWI_ARBITRATION = -3, TWI_BUS_ERROR = -4, TWI_UNEXPECTED = -5,
+	TWI_BUSY = -6, TWI_INVALID = -7
+};
+struct t736_twi {
+	void *ctx;
+	uint32_t (*read)(void *ctx, uint32_t offset);
+	void (*write)(void *ctx, uint32_t offset, uint32_t value);
+	uint32_t (*ticks)(void *ctx);
+	uint32_t timeout_ticks, poll_limit;
+	uint32_t last_status;
+	int cleanup_error;
+};
+int t736_twi_init(struct t736_twi *bus);
+int t736_twi_read8(struct t736_twi *bus, uint8_t address, uint8_t reg, uint8_t *value);
+int t736_twi_write8(struct t736_twi *bus, uint8_t address, uint8_t reg, uint8_t value);
+#endif
diff --git a/userpatches/atlasa1-release/spl/lpddr4/axp8191.c b/userpatches/atlasa1-release/spl/lpddr4/axp8191.c
new file mode 100644
index 0000000000000000000000000000000000000000..009bb4fc4e293d5217b5eac487eec2130f5fa2d4
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/lpddr4/axp8191.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AXP8191 Serial datasheet v1.0, sections 6.10.2 and 7.1.
+ * The interface/rail register mapping was cross-checked with GPL SyterKit
+ * drivers/pmu/axp8191.c. Exact voltage requests are required (no rounding).
+ */
+#include "axp8191.h"
+
+struct rail_registers {
+	uint8_t voltage, enable, enable_bit, mask;
+};
+
+static int rail_registers(enum t736_axp_rail rail, struct rail_registers *r)
+{
+	switch (rail) {
+	case T736_AXP_DCDC8:
+		*r = (struct rail_registers){0x19, 0x10, 7, 0x7f};
+		break;
+	case T736_AXP_ALDO4:
+		*r = (struct rail_registers){0x27, 0x20, 3, 0x1f};
+		break;
+	case T736_AXP_ELDO1:
+		*r = (struct rail_registers){0x3a, 0x22, 6, 0x3f};
+		break;
+	default:
+		return T736_AXP_INVALID;
+	}
+	return T736_AXP_OK;
+}
+
+int t736_axp_encode_mv(enum t736_axp_rail rail, unsigned int mv, uint8_t *code)
+{
+	unsigned int base, step, start;
+	if (!code)
+		return T736_AXP_INVALID;
+	switch (rail) {
+	case T736_AXP_DCDC8:
+		if (mv >= 500 && mv <= 1200) {
+			base = 500; step = 10; start = 0;
+		} else if (mv >= 1220 && mv <= 1840) {
+			base = 1220; step = 20; start = 71;
+		} else if (mv >= 1900 && mv <= 3400) {
+			base = 1900; step = 100; start = 103;
+		} else {
+			return T736_AXP_RANGE;
+		}
+		break;
+	case T736_AXP_ALDO4:
+		if (mv < 500 || mv > 3400)
+			return T736_AXP_RANGE;
+		base = 500; step = 100; start = 0;
+		break;
+	case T736_AXP_ELDO1:
+		if (mv < 500 || mv > 1500)
+			return T736_AXP_RANGE;
+		base = 500; step = 25; start = 0;
+		break;
+	default:
+		return T736_AXP_INVALID;
+	}
+	if ((mv - base) % step)
+		return T736_AXP_RANGE;
+	*code = (uint8_t)(start + (mv - base) / step);
+	return T736_AXP_OK;
+}
+
+int t736_axp_decode_mv(enum t736_axp_rail rail, uint8_t code, unsigned int *mv)
+{
+	if (!mv)
+		return T736_AXP_INVALID;
+	switch (rail) {
+	case T736_AXP_DCDC8:
+		if (code <= 70)
+			*mv = 500u + code * 10u;
+		else if (code <= 102)
+			*mv = 1220u + (code - 71u) * 20u;
+		else if (code <= 118)
+			*mv = 1900u + (code - 103u) * 100u;
+		else
+			return T736_AXP_RANGE;
+		break;
+	case T736_AXP_ALDO4:
+		if (code > 29)
+			return T736_AXP_RANGE;
+		*mv = 500u + code * 100u;
+		break;
+	case T736_AXP_ELDO1:
+		if (code > 40)
+			return T736_AXP_RANGE;
+		*mv = 500u + code * 25u;
+		break;
+	default:
+		return T736_AXP_INVALID;
+	}
+	return T736_AXP_OK;
+}
+
+int t736_axp_set_rail(const struct t736_axp_bus *bus, enum t736_axp_rail rail,
+		    unsigned int mv)
+{
+	struct rail_registers r;
+	uint8_t id, code, old_voltage, old_enable, value, verify;
+	unsigned int old_mv;
+	int ret;
+
+	if (!bus || !bus->read8 || !bus->write8)
+		return T736_AXP_INVALID;
+	ret = rail_registers(rail, &r);
+	if (ret)
+		return ret;
+	ret = t736_axp_encode_mv(rail, mv, &code);
+	if (ret)
+		return ret;
+	if (bus->read8(bus->ctx, 0x0e, &id))
+		return T736_AXP_IO;
+	if (id != 0x03)
+		return T736_AXP_ID;
+	if (bus->read8(bus->ctx, r.voltage, &old_voltage) ||
+	    bus->read8(bus->ctx, r.enable, &old_enable))
+		return T736_AXP_IO;
+	ret = t736_axp_decode_mv(rail, old_voltage & r.mask, &old_mv);
+	if (ret)
+		return ret;
+	/* Datasheet 7.1 forbids a live DCDC8 change across the 1.54 V boundary. */
+	if (rail == T736_AXP_DCDC8 && (old_enable & (1u << r.enable_bit)) &&
+	    ((old_mv > 1540u) != (mv > 1540u)))
+		return T736_AXP_LIVE_RANGE_CHANGE;
+	value = (uint8_t)((old_voltage & (uint8_t)~r.mask) | code);
+	if (value != old_voltage && bus->write8(bus->ctx, r.voltage, value))
+		return T736_AXP_IO;
+	if (bus->read8(bus->ctx, r.voltage, &verify))
+		return T736_AXP_IO;
+	if (verify != value)
+		return T736_AXP_VERIFY;
+	value = (uint8_t)(old_enable | (1u << r.enable_bit));
+	if (value != old_enable && bus->write8(bus->ctx, r.enable, value))
+		return T736_AXP_IO;
+	if (bus->read8(bus->ctx, r.enable, &verify))
+		return T736_AXP_IO;
+	return verify == value ? T736_AXP_OK : T736_AXP_VERIFY;
+}
diff --git a/userpatches/atlasa1-release/spl/lpddr4/axp8191.h b/userpatches/atlasa1-release/spl/lpddr4/axp8191.h
