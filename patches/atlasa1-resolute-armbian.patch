+2: lsr x0,x6,x4
+ and x0,x0,#15
+ add w0,w0,#48
+ cmp w0,#58
+ b.lo 3f
+ add w0,w0,#39
+3: ldr w1,[x2,#0x14]
+ tbz w1,#6,3b
+ str w0,[x2]
+ subs x4,x4,#4
+ b.ge 2b
+ mov x6,x7
+ subs x8,x8,#1
