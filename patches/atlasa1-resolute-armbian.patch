--- /dev/null
+++ b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_client.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef T736_CEDAR_CLIENT_H
+#define T736_CEDAR_CLIENT_H
+#include <stddef.h>
+#include <stdint.h>
+
+enum { T736_CODEC_H264 = 1, T736_CODEC_HEVC = 2 };
+#define T736_MAX_WIDTH 3840U
+#define T736_MAX_HEIGHT 2160U
+#define T736_MAX_PACKET (8U * 1024U * 1024U)
+#define T736_MAX_FRAME (T736_MAX_WIDTH * T736_MAX_HEIGHT * 3U / 2U)
+
+struct t736_frame {
+    uint32_t width, height, bytes_written;
+    uint32_t color_range, colorspace;
+    int64_t pts_us;
+};
+
+/* A connection is established by the preload constructor, before the RDD
+ * sandbox starts. None of these methods opens a device or connects a socket.
+ * All negative returns are -errno. Pixels are tightly packed 8-bit I420.
+ */
+int t736_client_available(void);
+int t736_client_open(int codec, unsigned width, unsigned height);
+int t736_client_push(int session, const uint8_t *data, size_t size,
+                     int64_t pts_us, int64_t dts_us);
+int t736_client_pull(int session, uint8_t *dst, size_t capacity,
+                     struct t736_frame *frame, unsigned timeout_ms);
+int t736_client_drain(int session);
+int t736_client_flush(int session);
+int t736_client_close(int session);
+#endif
diff --git a/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_protocol.h b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..a004861296da4afdd2e3a4b1f1cd52594a8d7add
--- /dev/null
+++ b/userpatches/atlasa1-release/tools/browser/shm_v2/cedar_protocol.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: MIT
+ * Private local protocol v2. Native little endian, fixed width, no pointers or
+ * hardware addresses. Both peers must be built from this header.
+ */
+#ifndef T736_CEDAR_PROTOCOL_H
+#define T736_CEDAR_PROTOCOL_H
+#include "cedar_client.h"
+#define T736_MAGIC 0x54373643U
+#define T736_PROTOCOL_VERSION 2U
+#define T736_SOCKET_PATH "/run/t736-cedar/decoder.sock"
+#define T736_MAX_BODY (T736_MAX_PACKET + 64U)
+enum t736_op { T736_OPEN = 1, T736_PUSH, T736_PULL, T736_DRAIN,
+               T736_FLUSH, T736_CLOSE, T736_SETUP };
+struct t736_message {
+    uint32_t magic, version, operation, length;
+    uint32_t sequence, session;
+    int32_t status;
+    uint32_t reserved;
+};
+struct t736_open { uint32_t codec, width, height, reserved; };
+struct t736_packet { int64_t pts_us, dts_us; };
+struct t736_pull { uint32_t capacity, timeout_ms; };
+struct t736_picture {
+    uint32_t width, height, bytes, color_range, colorspace, reserved;
+    int64_t pts_us;
+};
+/* One immutable-size ordinary-RAM slot per connection. PULL carries only
+ * t736_picture; the client copies the slot before it sends another request. */
+#define T736_SHM_I420 1U
+struct t736_setup {
+    uint32_t capacity, format, seals, reserved;
+    uint64_t device, inode;
+};
+_Static_assert(sizeof(struct t736_message) == 32, "wire header");
+_Static_assert(sizeof(struct t736_picture) == 32, "wire picture");
+_Static_assert(sizeof(struct t736_setup) == 32, "wire setup");
+#endif
