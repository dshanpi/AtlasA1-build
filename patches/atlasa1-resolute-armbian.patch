+++	regs[1] = ccu->usb + 0x0c;
+++	regs[2] = ccu->usb + 0x0c;
+++	regs[3] = ccu->usb + 0x08;
+++	regs[4] = ccu->msi;
+++	regs[5] = ccu->master;
