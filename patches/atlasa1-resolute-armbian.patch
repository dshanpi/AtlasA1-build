+ PVRSRV_ERROR sunxi_secure_config(IMG_HANDLE hSysData)
+ {
+-
+-	void __iomem *ioaddr;
+-
+-	ioaddr = ioremap(SMC_BASE_ADDR + SMC_DRM_GPU_HW_RST, 4);
+-	writel(0x2, ioaddr);
+-	iounmap(ioaddr);
+-
+-	ioaddr = ioremap(GPU_GLB_ADDR + GPU_DRM_CTRL, 4);
+-
+-	writel(0x0, ioaddr);
+-	iounmap(ioaddr);
+-
