diff --git a/userpatches/atlasa1-release/spl/storage/emmc.c b/userpatches/atlasa1-release/spl/storage/emmc.c
new file mode 100644
index 0000000000000000000000000000000000000000..7cffcd713b3c312c23763f466a0620e44d675c1b
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/storage/emmc.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T736 manual 0.90, SMHC3 chapter; project t736_mmc.c PIO sequence. */
+#include "emmc.h"
+#include <stddef.h>
+
+#define BASE UINT32_C(0x04023000)
+#define MODULE_CLK UINT32_C(0x02002d30)
+#define BIT(n) (UINT32_C(1) << (n))
+#define CTRL 0x00u
+#define CLKDIV 0x04u
+#define TIMEOUT 0x08u
+#define WIDTH 0x0cu
+#define BLOCKSIZE 0x10u
+#define BYTECOUNT 0x14u
+#define COMMAND 0x18u
+#define ARGUMENT 0x1cu
+#define RESPONSE 0x20u
+#define IRQMASK 0x30u
+#define IRQSTATUS 0x38u
+#define STATUS 0x3cu
+#define TIMING 0x5cu
+#define CARDRESET 0x78u
+#define FIFO 0x200u
+#define IRQ_ERRORS UINT32_C(0xbfc2)
+/* R1 errors: OUT_OF_RANGE through ERROR, plus CID/CSD overwrite,
+ * WP erase skip, erase reset, switch error and AKE sequence error. */
+#define R1_ERRORS UINT32_C(0xfff9a088)
+#define RESP BIT(6)
+#define LONG_RESP BIT(7)
+#define CRC BIT(8)
+#define LIMIT_US 1000000u
+
+static uint32_t rd(struct t736_emmc *c, uint32_t offset)
+{
+	return c->io.read32(c->io.ctx, BASE + offset);
+}
+
+static void wr(struct t736_emmc *c, uint32_t offset, uint32_t value)
+{
+	c->io.write32(c->io.ctx, BASE + offset, value);
+}
+
+static int clear_wait(struct t736_emmc *c, uint32_t offset, uint32_t mask)
+{
+	uint32_t n;
+	for (n = 0; n < LIMIT_US; n++) {
+		if (!(rd(c, offset) & mask))
+			return 0;
+		if (c->io.delay_us(c->io.ctx, 1))
+			return T736_EMMC_TIMER;
+	}
+	return T736_EMMC_TIMEOUT;
+}
+
+static int update_clock(struct t736_emmc *c)
+{
+	int ret;
+	wr(c, COMMAND, BIT(31) | BIT(21) | BIT(13));
+	ret = clear_wait(c, COMMAND, BIT(31));
+	c->last_irq = rd(c, IRQSTATUS);
+	if (!ret && (c->last_irq & IRQ_ERRORS))
+		ret = T736_EMMC_IO;
+	wr(c, IRQSTATUS, UINT32_MAX);
+	return ret;
+}
+
+/* Fixed oscillator, 400 kHz identification or 12 MHz SDR transfer. */
+static int set_clock(struct t736_emmc *c, uint32_t divisor)
+{
+	int ret;
+	wr(c, CLKDIV, BIT(31));
+	ret = update_clock(c);
+	if (ret)
+		return ret;
+	c->io.write32(c->io.ctx, MODULE_CLK, BIT(31) | (divisor - 1u));
+	wr(c, TIMING, rd(c, TIMING) | BIT(31));
+	wr(c, CLKDIV, BIT(31) | BIT(16));
+	ret = update_clock(c);
+	if (!ret)
+		wr(c, CLKDIV, BIT(16));
+	return ret;
+}
+
+static int command(struct t736_emmc *c, uint32_t index, uint32_t arg,
+		   uint32_t response_flags, int check_r1, int busy, uint8_t *data)
+{
+	uint32_t flags = BIT(31) | index | response_flags;
+	uint32_t n, got = 0;
+	int ret, checked_r1 = 0;
+	c->last_irq = 0;
+	c->last_r1 = 0;
+	if (data) {
+		wr(c, CTRL, rd(c, CTRL) | BIT(1));
+		ret = clear_wait(c, CTRL, BIT(1));
+		if (ret)
+			return ret;
+		wr(c, BLOCKSIZE, 512);
+		wr(c, BYTECOUNT, 512);
+		flags |= BIT(9) | BIT(13);
+	}
+	if (!index)
+		flags |= BIT(15);
+	wr(c, IRQSTATUS, UINT32_MAX);
+	wr(c, ARGUMENT, arg);
+	wr(c, COMMAND, flags);
+	for (n = 0; n < LIMIT_US; n++) {
+		uint32_t irq = rd(c, IRQSTATUS);
+		c->last_irq = irq;
+		if (irq & IRQ_ERRORS)
+			return irq & (BIT(8) | BIT(9)) ? T736_EMMC_TIMEOUT : T736_EMMC_IO;
+		if (check_r1 && !checked_r1 && (irq & BIT(2))) {
+			c->last_r1 = rd(c, RESPONSE);
+			checked_r1 = 1;
+			if (c->last_r1 & R1_ERRORS)
+				return T736_EMMC_IO;
+		}
+		if (data && got < 512u && !(rd(c, STATUS) & BIT(2))) {
+			uint32_t word = rd(c, FIFO);
+			unsigned int b;
+			for (b = 0; b < 4; b++)
+				data[got++] = (uint8_t)(word >> (b * 8u));
+		}
+		if ((irq & BIT(2)) && (!data || (got == 512u && (irq & BIT(3)))))
+			break;
+		if (c->io.delay_us(c->io.ctx, 1))
+			return T736_EMMC_TIMER;
+	}
+	if (n == LIMIT_US)
+		return T736_EMMC_TIMEOUT;
+	if ((response_flags & RESP) && !checked_r1)
+		c->last_r1 = rd(c, RESPONSE);
+	if (check_r1 && (c->last_r1 & R1_ERRORS))
+		return T736_EMMC_IO;
+	if (busy) {
+		ret = clear_wait(c, STATUS, BIT(9));
+		if (ret)
+			return ret;
+	}
+	wr(c, IRQSTATUS, UINT32_MAX);
+	return 0;
+}
+
+int t736_emmc_open(struct t736_emmc *c, const struct t736_emmc_io *io,
+		   uint8_t workspace[512])
+{
+	unsigned int attempt;
+	int ret;
+	if (!c)
+		return T736_EMMC_INVALID;
+	c->initialized = 0;
+	c->sectors = 0;
+	if (!io || !workspace || !io->read32 || !io->write32 || !io->delay_us)
+		return T736_EMMC_INVALID;
+	c->io = *io;
+	c->last_irq = 0;
+	c->last_r1 = 0;
+	/* CCU bus clock/reset are caller prerequisites. The module clock must
+	 * also run before SMHC internal reset can complete on a cold start. */
+	c->io.write32(c->io.ctx, MODULE_CLK, BIT(31) | 29u);
+	wr(c, CTRL, 7);
+	ret = clear_wait(c, CTRL, 7);
+	if (ret)
+		return ret;
+	wr(c, CTRL, BIT(31));
+	wr(c, IRQMASK, 0);
+	wr(c, IRQSTATUS, UINT32_MAX);
+	wr(c, TIMEOUT, UINT32_MAX);
+	wr(c, WIDTH, 0);
+	wr(c, CARDRESET, 0);
+	if (c->io.delay_us(c->io.ctx, 10))
+		return T736_EMMC_TIMER;
+	wr(c, CARDRESET, 1);
+	if (c->io.delay_us(c->io.ctx, 1000))
+		return T736_EMMC_TIMER;
+	ret = set_clock(c, 30);
+	if (ret)
+		return ret;
+	ret = command(c, 0, 0, 0, 0, 0, NULL);
+	if (ret)
+		return ret;
+	for (attempt = 0; attempt < 1000; attempt++) {
+		/* Host supports sector addressing and the board's 3.3 V VCC range. */
+		ret = command(c, 1, UINT32_C(0x40ff8000), RESP, 0, 0, NULL);
+		if (ret)
+			return ret;
+		if (c->last_r1 & BIT(31))
+			break;
+		if (c->io.delay_us(c->io.ctx, 1000))
+			return T736_EMMC_TIMER;
+	}
+	if (attempt == 1000)
+		return T736_EMMC_TIMEOUT;
+	if ((c->last_r1 & UINT32_C(0x60000000)) != BIT(30) ||
+	    !(c->last_r1 & UINT32_C(0x00ff8000)))
+		return T736_EMMC_UNSUPPORTED;
+	ret = command(c, 2, 0, RESP | LONG_RESP | CRC, 0, 0, NULL);
+	if (!ret)
+		ret = command(c, 3, UINT32_C(0x00010000), RESP | CRC, 1, 0, NULL);
+	if (!ret)
+		ret = command(c, 7, UINT32_C(0x00010000), RESP | CRC, 1, 1, NULL);
+	if (!ret)
+		ret = command(c, 8, 0, RESP | CRC, 1, 0, workspace);
+	if (ret)
+		return ret;
+	/* EXT_CSD revision >= 2 includes SEC_COUNT. Never change partition access. */
+	if (workspace[192] < 2 || (workspace[179] & 7u))
+		return T736_EMMC_UNSUPPORTED;
+	c->sectors = (uint32_t)workspace[212] | ((uint32_t)workspace[213] << 8) |
+		((uint32_t)workspace[214] << 16) | ((uint32_t)workspace[215] << 24);
+	if (!c->sectors)
+		return T736_EMMC_UNSUPPORTED;
+	ret = set_clock(c, 1);
+	if (!ret)
+		c->initialized = 1;
+	return ret;
+}
+
+int t736_emmc_read(struct t736_emmc *c, uint32_t sector, uint8_t dest[512])
+{
+	int ret;
+	if (!c || !dest || !c->initialized || sector >= c->sectors)
+		return T736_EMMC_INVALID;
+	ret = command(c, 17, sector, RESP | CRC, 1, 0, dest);
+	/* A failed transfer needs explicit reinitialization before another command. */
+	if (ret)
+		c->initialized = 0;
+	return ret;
+}
diff --git a/userpatches/atlasa1-release/spl/storage/emmc.h b/userpatches/atlasa1-release/spl/storage/emmc.h
new file mode 100644
index 0000000000000000000000000000000000000000..3e5374c46dd43929aded4d0d0dcde1818abfce6e
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/storage/emmc.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef T736_SPL_EMMC_H
+#define T736_SPL_EMMC_H
+#include <stdint.h>
+
+enum t736_emmc_error {
+	T736_EMMC_INVALID = -1,
+	T736_EMMC_TIMEOUT = -2,
+	T736_EMMC_IO = -3,
+	T736_EMMC_UNSUPPORTED = -4,
+	T736_EMMC_TIMER = -5,
+};
+
+struct t736_emmc_io {
+	void *ctx;
+	uint32_t (*read32)(void *ctx, uint32_t address);
+	void (*write32)(void *ctx, uint32_t address, uint32_t value);
+	/* Return 0 on elapsed delay, nonzero if the timer is unavailable/stalled. */
+	int (*delay_us)(void *ctx, uint32_t usec);
+};
+
+struct t736_emmc {
+	struct t736_emmc_io io;
+	uint32_t sectors;
+	uint32_t last_irq;
+	uint32_t last_r1;
+	uint8_t initialized;
+};
+
+/*
+ * SMHC3 protocol/controller only. Caller MUST first establish the actual board's
+ * VCC/VCCQ supplies, PC pad-voltage selection, pinmux/drive and CCU bus reset.
+ * No claim that these cold-start prerequisites have yet been implemented.
+ * Resets host/card to 1-bit SDR, negotiates sector-addressed eMMC, and checks
+ * EXT_CSD user-area selection/capacity. Does not write storage or EXT_CSD.
+ * workspace is 512 caller-owned bytes in SRAM; stack usage is bounded.
+ */
+int t736_emmc_open(struct t736_emmc *card, const struct t736_emmc_io *io,
+		   uint8_t workspace[512]);
+/* Exact one-sector PIO read; no arbitrary command/write API exposed. */
+int t736_emmc_read(struct t736_emmc *card, uint32_t sector, uint8_t dest[512]);
+#endif
diff --git a/userpatches/atlasa1-release/spl/vendor_ddr/boot.ld b/userpatches/atlasa1-release/spl/vendor_ddr/boot.ld
new file mode 100644
index 0000000000000000000000000000000000000000..0d7fe66732c8692674b8fac97f290a591bd915eb
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/vendor_ddr/boot.ld
@@ -0,0 +1,24 @@
+/* Callable FEL image, entirely within the prior golden FES upload range. */
+OUTPUT_FORMAT("elf32-littlearm")
+OUTPUT_ARCH(arm)
+ENTRY(_start)
+MEMORY { sram (rwx) : ORIGIN = 0x47000, LENGTH = 0x38c00 }
+PHDRS { text PT_LOAD FLAGS(5); data PT_LOAD FLAGS(6); }
+SECTIONS {
+ .text : { KEEP(*(.text.entry)) *(.text .text.*) } > sram :text
+ .rodata : ALIGN(8) { *(.rodata .rodata.*) } > sram :text
+ .data : ALIGN(8) { *(.data .data.*) } > sram :data
+ .bss (NOLOAD) : ALIGN(8) {
+  __bss_start = .; *(.bss .bss.* COMMON) . = ALIGN(8); __bss_end = .;
+ } > sram :data
+ ASSERT(__bss_end <= 0x7d000, "library overlaps report/stack")
+ .report 0x7d000 (NOLOAD) : { KEEP(*(.report)) } > sram :data
+ .fault_report 0x7d400 (NOLOAD) : { KEEP(*(.fault_report)) } > sram :data
+ .stack 0x7dc00 (NOLOAD) : {
+  __stack_bottom = .; . += 0x2000; __stack_top = .;
+ } > sram :data
+ /DISCARD/ : { *(.comment .note* .ARM.exidx* .ARM.extab*) }
+ ASSERT(_start == 0x47000, "entry mismatch")
+ ASSERT(SIZEOF(.report) == 512, "report ABI changed")
+ ASSERT(__stack_top == 0x7fc00, "SRAM range mismatch")
+}
diff --git a/userpatches/atlasa1-release/spl/vendor_ddr/emmc_boot.c b/userpatches/atlasa1-release/spl/vendor_ddr/emmc_boot.c
new file mode 100644
index 0000000000000000000000000000000000000000..df4b3817f0d794b91772eca98ea09c16fdc29da1
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/vendor_ddr/emmc_boot.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Source user-area boot loader. Read-only eMMC, fixed payload destinations.
+ * eMMC is already the BootROM's boot medium; its VCC/VCCQ power is not changed.
+ * Keep board recovery usable before DDR: Ctrl-C, then the fixed 'efex' command.
+ */
+#include "platform.h"
+#include "emmc.h"
+#include <stdint.h>
+extern int printf(const char *,...);
+extern void t736_enter_a64(void) __attribute__((noreturn));
+extern void t736_enter_brom_fel(void) __attribute__((noreturn));
+#define UART 0x02500000u
+static uint8_t workspace[512];
+static uint32_t header[128];
+static uint32_t crc32(const uint8_t *p,uint32_t n){
+ uint32_t c=~0u;while(n--){c^=*p++;for(unsigned i=0;i<8;i++)c=(c>>1)^(0xedb88320u&(0u-(c&1)));}return ~c;
+}
+static void stop(void) __attribute__((noreturn));
+static void stop(void){printf("SPL stopped; power-cycle and Ctrl-C for recovery\n");for(;;)__asm__ volatile("wfi");}
+static int rx(void){if(t736_read32(UART+0x14)&1)return t736_read32(UART)&255;return -1;}
+static void enter_fel(void) __attribute__((noreturn));
+static void enter_fel(void){
+ /* RTC EFEX is consumed by vendor Boot0, not by BootROM. We replace Boot0,
+  * so enter this chip's ROM FEL entry directly, before any DDR/PLL changes.
+  * Board golden Boot0: 0x5eecc loads 0x20; 0x48ec6 branches to it in ARM.
+  * The address is a ROM ABI, not a copied vendor executable. */
+ t736_write32(0x07090108,0);
+ if(t736_read32(0x07090108))stop();
+ printf("SPL fixed efex: entering BootROM FEL at 0x20\n");
+ for(unsigned n=0;n<T736_POLL_LIMIT;n++){
+  if(t736_read32(UART+0x14)&0x40)t736_enter_brom_fel();
+ }
+ stop();
+}
+void spl_recovery_window(void){
+ t736_clrset32(0x02000104,0xff0,0x220);t736_clrset32(0x02002538,0x0700001f,0);t736_clrset32(0x02002e00,0,0x10001);
+ t736_write32(UART+4,0);t736_write32(UART+12,0x80);t736_write32(UART,13);t736_write32(UART+4,0);t736_write32(UART+12,3);t736_write32(UART+8,7);
+ if(t736_timer_init())stop();
+#ifdef T736_CPUCLOCK
+ printf("T736 SPL v5; Ctrl-C 3s for recovery\n");
+#elif defined(T736_PERIPHERAL_POWER)
+ printf("T736 source eMMC SPL v4; fixed LPDDR4x and peripheral power; Ctrl-C within 3 seconds for recovery\n");
+#else
+ printf("T736 source eMMC SPL v3; fixed board LPDDR4x; Ctrl-C within 3 seconds for recovery\n");
+#endif
+ printf("CCU before DDR: PERI0=%x AHB=%x APB0=%x\n",t736_read32(0x020020a0),t736_read32(0x02002500),t736_read32(0x02002510));
+ uint32_t start=t736_counter_low();int interrupted=0;
+ while((uint32_t)(t736_counter_low()-start)<72000000u){if(rx()==3){interrupted=1;break;}if(t736_delay_us(100))stop();}
+ if(!interrupted)return;
+ /* The board-scoped recovery tool recognizes a standalone U-Boot prompt. */
+ printf("\n=> ");char command[8];unsigned used=0;
+ for(;;){int c=rx();if(c<0){if(t736_delay_us(100))stop();continue;}
+  if(c=='\r'||c=='\n'){
+   if(used==4&&command[0]=='e'&&command[1]=='f'&&command[2]=='e'&&command[3]=='x')enter_fel();
+   used=0;printf("\nOnly efex recovery is supported\n=> ");
+  }else if(c==3){used=0;}else if(used<sizeof(command))command[used++]=(char)c;
+ }
+}
+static uint32_t io_read(void *ctx,uint32_t a){(void)ctx;return t736_read32(a);}
+static void io_write(void *ctx,uint32_t a,uint32_t v){(void)ctx;t736_write32(a,v);}
+static int io_delay(void *ctx,uint32_t us){(void)ctx;return t736_delay_us(us);}
+void emmc_boot_main(void){
+ printf("CCU after DDR: PERI0=%x AHB=%x APB0=%x\n",t736_read32(0x020020a0),t736_read32(0x02002500),t736_read32(0x02002510));
+ static const uint8_t pins[]={0,1,5,6,8,9,10,11,13,14,15,16};
+ for(unsigned i=0;i<sizeof(pins);i++){
+  uint32_t shift=(pins[i]%8)*4,a=0x02000180+(pins[i]/8)*4;
+  t736_clrset32(a,15u<<shift,4u<<shift);
+ }
+ t736_write32(0x02002d30,1u<<31);t736_clrset32(0x02002d3c,1u<<16,0);t736_delay_us(10);t736_clrset32(0x02002d3c,0,0x10001);
+ struct t736_emmc card={0};const struct t736_emmc_io io={0,io_read,io_write,io_delay};
+ int rc=t736_emmc_open(&card,&io,workspace);
+ printf("SPL eMMC open rc=%d sectors=%u irq=%x r1=%x\n",rc,card.sectors,card.last_irq,card.last_r1);
+ if(rc||card.sectors!=122142720u)stop();
+ if(t736_emmc_read(&card,24576,(uint8_t*)header))stop();
+ uint32_t saved=header[4];header[4]=0;
+ if(header[0]!=0x36333754||header[1]!=0x314c5053||header[2]!=1||header[3]!=3||crc32((uint8_t*)header,512)!=saved){printf("SPL payload header invalid\n");stop();}
+ static const uint32_t addresses[]={0x47000000,0x48000000,0x52000000};
+ static const uint32_t limits[]={8192,0x200000,0x100000};
+ uint32_t previous=24577;
+ for(unsigned i=0;i<3;i++){
+  uint32_t *h=&header[8+i*4],sector=h[0],address=h[1],length=h[2],crc=h[3];
+  uint32_t count=(length+511)/512;
+  if(address!=addresses[i]||!length||length>limits[i]||sector<previous||sector+count>32800)stop();
+  previous=sector+count;printf("SPL load addr=%x bytes=%u LBA=%u\n",address,length,sector);
+  for(uint32_t j=0;j<count;j++){
+   rc=t736_emmc_read(&card,sector+j,workspace);if(rc){printf("SPL read failed rc=%d irq=%x r1=%x\n",rc,card.last_irq,card.last_r1);stop();}
+   uint32_t bytes=length-j*512;if(bytes>512)bytes=512;
+   for(uint32_t k=0;k<bytes;k++)((volatile uint8_t*)address)[j*512+k]=workspace[k];
+  }
+  __asm__ volatile("dsb sy" ::: "memory");
+  if(crc32((const uint8_t*)address,length)!=crc){printf("SPL payload CRC failed\n");stop();}
+ }
+ printf("SPL payload CRCs passed; source AArch64 handoff\n");
+ t736_enter_a64();
+}
diff --git a/userpatches/atlasa1-release/spl/vendor_ddr/entry_boot.S b/userpatches/atlasa1-release/spl/vendor_ddr/entry_boot.S
new file mode 100644
index 0000000000000000000000000000000000000000..ba79ade735847ea2d7397430207671e5b77c1f8b
--- /dev/null
+++ b/userpatches/atlasa1-release/spl/vendor_ddr/entry_boot.S
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Optional SRAM entry with an independent 128-byte exception record.
+ * Link .fault_report at 0x4ed00, after the largest current report (0x4e930)
+ * and before stack bottom (0x4f000). Never replace a frozen entry.S build.
+ * No exception-stack use; UART is the only peripheral written by faults.
+ */
+.syntax unified
+.arm
+.section .text.entry,"ax",%progbits
+.global _start
+.type _start,%function
+_start:
+ b enter
+ .ascii "eGON.BT0"
+ .word 0x5f0a6c39
+ .word 0 /* packed image length */
+ .word 48 /* public header bytes */
+ .word 0
+ .word 0x47000 /* BootROM load address */
+ .word 0x47000
+ .word 0
+ .word 0
+ .ascii "T736"
+ .space 16
+.balign 32
+.global diag_vectors
+diag_vectors:
+ b diag_vector_reset
+ b diag_vector_undef
+ b diag_vector_svc
+ b diag_vector_prefetch
+ b diag_vector_data
+ b diag_vector_reserved
+ b diag_vector_irq
+ b diag_vector_fiq
+enter:
+ mrs r0, cpsr
+ and r1, r0, #0x1f
+ cmp r1, #0x13
+ bne reject
+ mrc p15, 0, r1, c1, c0, 0
+ tst r1, #5
+ bne reject
+ tst r1, #0x2000
+ bne reject
+ cpsid if
+ ldr r12, =saved_context
+ stmia r12, {r4-r11, sp, lr}
+ str r0, [r12, #40]
+ mrc p15, 0, r1, c12, c0, 0
+ str r1, [r12, #44]
+ ldr sp, =__stack_top
+ /* Clear before installing our vectors so any record is from this run. */
+ ldr r1, =diag_fault_record
+ add r2, r1, #128
+ mov r3, #0
+1:
+ str r3, [r1], #4
+ cmp r1, r2
+ blo 1b
+ ldr r1, =diag_vectors
+ mcr p15, 0, r1, c12, c0, 0
+ isb
+ ldr r1, =__bss_start
+ ldr r2, =__bss_end
+2:
+ cmp r1, r2
+ strlo r3, [r1], #4
+ blo 2b
+ bl spl_recovery_window
+ bl probe_main
+ cmp r0,#0
+ bne boot_failed
+ bl emmc_boot_main
+boot_failed:
+ wfi
+ b boot_failed
+ ldr r12, =saved_context
+ ldr r1, [r12, #44]
+ mcr p15, 0, r1, c12, c0, 0
+ dsb sy
+ isb
+ ldr r1, [r12, #40]
+ ldmia r12, {r4-r11, sp, lr}
+ msr cpsr_c, r1
+ bx lr
+reject:
+ mov r0, #0x100
+ bx lr
+.size _start, .-_start
+
+/* Fixed recovery ABI, used only by the pre-DDR console. No reset and no
+ * dependency on a vendor Boot0 interpreting an RTC mailbox. Restore ROM
+ * vectors and disable/invalidate instruction cache and branch prediction.
+ * Entry rejects an enabled MMU/D-cache, and recovery has not enabled them. */
+.global t736_enter_brom_fel
+.type t736_enter_brom_fel,%function
+t736_enter_brom_fel:
+ cpsid if
+ ldr r12, =saved_context
+ ldr r1, [r12, #44]
+ mcr p15, 0, r1, c12, c0, 0
+ mrc p15, 0, r1, c1, c0, 0
+ bic r1, r1, #0x1000
+ bic r1, r1, #7
+ mcr p15, 0, r1, c1, c0, 0
+ isb
+ mov r1, #0
+ mcr p15, 0, r1, c7, c5, 0
+ mcr p15, 0, r1, c7, c5, 6
+ dsb sy
+ isb
+ mov r0, #0x20
+ bx r0
+.size t736_enter_brom_fel, .-t736_enter_brom_fel
+
+/* Branches preserve architectural exception LR and SPSR. */
+.macro DIAG_VECTOR name, number
+.global diag_vector_\name
+diag_vector_\name:
+ mov r0, #\number
+ b diag_fault
+.endm
+DIAG_VECTOR reset, 0
+DIAG_VECTOR undef, 1
+DIAG_VECTOR svc, 2
+DIAG_VECTOR prefetch, 3
+DIAG_VECTOR data, 4
+DIAG_VECTOR reserved, 5
+DIAG_VECTOR irq, 6
+DIAG_VECTOR fiq, 7
+
+.type diag_fault,%function
+diag_fault:
+ mrs r12, cpsr
+ cpsid if
+ ldr r1, =diag_fault_record
+ ldr r2, [r1]
+ ldr r3, =0x54374644
+ cmp r2, r3
+ bne 3f
+ ldr r2, [r1, #8]
+ cmp r2, #0
+ bne diag_nested
+3:
+ str r3, [r1]       /* 0: magic */
+ mov r2, #1
+ str r2, [r1, #4]   /* 4: version */
+ str r2, [r1, #8]   /* 8: 1=capture underway, 2=captured */
+ str r0, [r1, #12]  /* 12: vector index */
+ str r12, [r1, #16] /* 16: exception CPSR, before our CPSID */
+ mrs r2, spsr
+ str r2, [r1, #20]  /* 20: raw SPSR */
+ str lr, [r1, #24]  /* 24: raw exception LR, no guessed PC */
+ /* Validity: bit0 SPSR, bit1 data-fault pair, bit2 instruction-fault pair,
+  * bit3 SCTLR, bit4 VBAR. Other fault registers may contain stale values. */
+ mov r2, #0
+ cmp r0, #0
+ beq 4f
+ cmp r0, #5
+ orrne r2, r2, #1
+4:
+ str r2, [r1, #64]
+ mrc p15, 0, r2, c5, c0, 0
+ str r2, [r1, #28]  /* DFSR */
+ mrc p15, 0, r2, c6, c0, 0
+ str r2, [r1, #32]  /* DFAR */
+ ldr r3, [r1, #64]
+ cmp r0, #4
+ orreq r3, r3, #2
+ str r3, [r1, #64]
+ mrc p15, 0, r2, c5, c0, 1
+ str r2, [r1, #36]  /* IFSR */
+ mrc p15, 0, r2, c6, c0, 2
+ str r2, [r1, #40]  /* IFAR */
+ ldr r3, [r1, #64]
+ cmp r0, #3
+ orreq r3, r3, #4
+ str r3, [r1, #64]
+ mrc p15, 0, r2, c1, c0, 0
+ str r2, [r1, #52]  /* SCTLR */
+ ldr r3, [r1, #64]
+ orr r3, r3, #8
+ str r3, [r1, #64]
+ mrc p15, 0, r2, c12, c0, 0
+ str r2, [r1, #56]  /* VBAR */
+ orr r3, r3, #16
+ str r3, [r1, #64]
+ mov r2, #2
+ str r2, [r1, #8]
+ dsb sy             /* Preserve evidence even when UART is unavailable. */
+ mov r4, r1
+ adr r5, diag_labels
+ add r6, r4, #12
+ mov r7, #8
+5:
+ ldrb r0, [r5], #1
+ bl diag_tx
+ cmp r0, #0
+ bne diag_uart_failed
+ mov r0, #'='
+ bl diag_tx
+ cmp r0, #0
+ bne diag_uart_failed
+ ldr r8, [r6], #4
+ mov r9, #28
+6:
+ lsr r0, r8, r9
+ and r0, r0, #15
+ cmp r0, #9
+ addls r0, r0, #'0'
+ addhi r0, r0, #('a'-10)
+ bl diag_tx
+ cmp r0, #0
+ bne diag_uart_failed
+ subs r9, r9, #4
+ bpl 6b
+ mov r0, #13
+ bl diag_tx
+ cmp r0, #0
+ bne diag_uart_failed
+ mov r0, #10
+ bl diag_tx
+ cmp r0, #0
+ bne diag_uart_failed
+ subs r7, r7, #1
+ bne 5b
+ /* Bound and drain the final byte before WFI. */
+ ldr r1, =0x02500000
+ ldr r2, =1000000
+7:
+ ldr r3, [r1, #0x14]
+ dsb sy
+ tst r3, #0x40
+ bne 8f
+ subs r2, r2, #1
+ bne 7b
+ mov r0, #3
+ b diag_uart_failed
+8:
+ mov r0, #1
+ str r0, [r4, #48]  /* uart_completed */
+ b diag_stop
+diag_uart_failed:
+ str r0, [r4, #44]  /* 1=DLAB, 2=THRE timeout, 3=TEMT timeout */
+ b diag_stop
+diag_nested:
+ /* Do not overwrite the first fault or recurse through more CP15/UART. */
+ ldr r2, [r1, #60]
+ add r2, r2, #1
+ str r2, [r1, #60]
+ str lr, [r1, #68]
+ str r12, [r1, #72]
+ str r0, [r1, #76]
+diag_stop:
+ dsb sy
+9:
+ wfi
+ b 9b
+.size diag_fault, .-diag_fault
+
+/* Stackless leaf. Clobbers r0-r3 only, preserving the formatting loop. */
+.type diag_tx,%function
+diag_tx:
+ ldr r1, =0x02500000
+ ldr r3, [r1, #0x0c]
+ dsb sy
+ tst r3, #0x80
+ movne r0, #1
+ bxne lr
+ ldr r2, =1000000
+10:
+ ldr r3, [r1, #0x14]
+ dsb sy
+ tst r3, #0x20
+ bne 11f
+ subs r2, r2, #1
+ bne 10b
+ mov r0, #2
+ bx lr
+11:
+ str r0, [r1]
+ dsb sy
+ mov r0, #0
+ bx lr
+.size diag_tx, .-diag_tx
+diag_labels:
+ .ascii "FCSLDAIP"
+.balign 4
+.ltorg
+.section .data.context,"aw",%progbits
+.balign 8
+saved_context:
+ .space 48
+.section .fault_report,"aw",%nobits
+.balign 4
+.global diag_fault_record
+diag_fault_record:
+ .space 128
+.section .note.GNU-stack,"",%progbits
diff --git a/userpatches/atlasa1-release/spl/vendor_ddr/handoff32.S b/userpatches/atlasa1-release/spl/vendor_ddr/handoff32.S
