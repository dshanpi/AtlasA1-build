+ mov w1,#'A'
+ str w1,[x0]
+ adr x0,vectors
+ msr vbar_el3,x0
+ isb
+ ldr x0,=0x47020000
+ mov sp,x0
+ bl stage_main
+ dsb sy
+ ic iallu
+ dsb sy
+ isb
+ mov x0,xzr
+ mov x1,xzr
+ mov x2,xzr
+ mov x3,xzr
+ ldr x4,=0x48000000
+ br x4
+.balign 2048
