++static int t736_hs400_send_status(struct mmc_card *card, u32 *status)
++{
++	struct mmc_command cmd = {
++		.opcode = MMC_SEND_STATUS,
++		.arg = card->rca << 16,
++		.flags = MMC_RSP_R1 | MMC_CMD_AC,
