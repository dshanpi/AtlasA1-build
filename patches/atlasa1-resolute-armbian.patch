+#!/usr/bin/env bash
+# Build userspace packages for an Armbian-selected kernel and desktop.
+set -euo pipefail
+[[ $# == 5 ]] || { echo 'Usage: INPUTS NEW_WORK PVR_MODULE KERNEL_RELEASE DESKTOP' >&2; exit 2; }
+inputs=$(realpath -e "$1")
+out=$(realpath -m "$2")
+pvr=$(realpath -e "$3")
