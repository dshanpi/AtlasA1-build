+diff --git a/drivers/pmdomain/sunxi/t736-display-power.c b/drivers/pmdomain/sunxi/t736-display-power.c
+new file mode 100644
+index 0000000000000000000000000000000000000000..ad2966643830b5cfd4924380a031d4679bdee834
+--- /dev/null
++++ b/drivers/pmdomain/sunxi/t736-display-power.c
+@@ -0,0 +1,70 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* T736 DE_SYS and VO1 PCK600 only. Delay values: Tina pck600_domains.c.
++ * Power policy sequence: upstream sun55i-pck600.c / ARM PPU specification.
++ * Other PCK domains remain entirely outside this driver's register resources.
++ */
++#include <linux/clk.h>
++#include <linux/io.h>
++#include <linux/iopoll.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/pm_domain.h>
++
++struct display_pd { struct generic_pm_domain genpd; void __iomem *base; };
++struct display_power {
++	struct display_pd pd[2];
++	struct generic_pm_domain *domains[2];
++	struct genpd_onecell_data data;
++};
++static int display_power_on(struct generic_pm_domain *domain)
++{
++	struct display_pd *pd=container_of(domain,struct display_pd,genpd);
++	u32 v=readl(pd->base);
++	writel((v & ~0xf) | 8,pd->base);
++	readl(pd->base);
++	return readl_poll_timeout(pd->base+8,v,(v & 0xf)==8,10,10000);
++}
++static int display_power_probe(struct platform_device *pdev)
++{
++	static const char * const names[]={ "t736-de-sys", "t736-vo1" };
++	struct display_power *p;
++	struct clk *clk;
++	int i,ret;
++	p=devm_kzalloc(&pdev->dev,sizeof(*p),GFP_KERNEL);
++	if (!p) return -ENOMEM;
++	clk=devm_clk_get_enabled(&pdev->dev,NULL);
++	if (IS_ERR(clk)) return PTR_ERR(clk);
++	for (i=0;i<2;i++) {
++		struct display_pd *pd=&p->pd[i];
++		pd->base=devm_platform_ioremap_resource(pdev,i);
++		if (IS_ERR(pd->base)) { ret=PTR_ERR(pd->base); goto remove; }
++		writel(0x1f1f1f,pd->base+0x170);
++		writel(0x1f1f,pd->base+0x174);
++		writel(0x08080808,pd->base+0xc00);
++		writel(0x808,pd->base+0xc04);
++		writel(8,pd->base+0xc10);
++		pd->genpd.name=names[i]; pd->genpd.power_on=display_power_on;
++		pd->genpd.flags=GENPD_FLAG_ALWAYS_ON;
++		ret=display_power_on(&pd->genpd);
++		if (ret) { dev_err(&pdev->dev,"%s power-on timeout\n",names[i]); goto remove; }
++		ret=pm_genpd_init(&pd->genpd,NULL,false);
++		if (ret) goto remove;
++		p->domains[i]=&pd->genpd;
++	}
++	p->data.domains=p->domains; p->data.num_domains=2;
++	ret=of_genpd_add_provider_onecell(pdev->dev.of_node,&p->data);
++	if (!ret) return 0;
++remove:
++	while (i--) pm_genpd_remove(&p->pd[i].genpd);
++	return ret;
++}
++static const struct of_device_id display_power_match[]={
++	{ .compatible="allwinner,t736-display-power" }, { }
++};
++static struct platform_driver display_power_driver={
++	.probe=display_power_probe,
++	.driver={ .name="t736-display-power", .of_match_table=display_power_match,
++		.suppress_bind_attrs=true },
++};
++builtin_platform_driver(display_power_driver);
+diff --git a/drivers/pmdomain/sunxi/t736-gpu-power.c b/drivers/pmdomain/sunxi/t736-gpu-power.c
+new file mode 100644
+index 0000000000000000000000000000000000000000..018e834159f16545dea84e96e56e19246847ec53
+--- /dev/null
++++ b/drivers/pmdomain/sunxi/t736-gpu-power.c
+@@ -0,0 +1,222 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* Fixed-board GPU_TOP + GPU_CORE always-on domain. PLL_GPU0 must lock and
++ * drive its output before CORE is requested, even while GPU uses PERI400.
++ * Publish only after both PPU ACKs, actual voltage, reset and rate readback.
++ */
++#include <linux/clk.h>
++#include <linux/io.h>
++#include <linux/iopoll.h>
++#include <linux/module.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/pm_domain.h>
++#include <linux/regulator/consumer.h>
++#include <linux/reset.h>
++
++struct t736_gpu_power {
++	struct device *dev;
++	struct generic_pm_domain genpd;
++	struct generic_pm_domain *domains[1];
++	struct genpd_onecell_data data;
++	void __iomem *top, *core;
++	struct regulator *supply;
++	struct clk_bulk_data clocks[4];
++	struct clk_bulk_data bootstrap_clocks[2];
++};
++
++static void gpu_ppu_delays(void __iomem *base)
++{
++	writel(0x1f1f1f, base + 0x170);
++	writel(0x1f1f, base + 0x174);
++	writel(0x08080808, base + 0xc00);
++	writel(0x808, base + 0xc04);
++	writel(8, base + 0xc10);
++}
++
++static int gpu_ppu_wait_on(struct t736_gpu_power *p, void __iomem *base,
++			   const char *name)
++{
++	u32 v;
++	int ret;
++
++	ret = readl_poll_timeout(base + 8, v, (v & 0xf) == 8, 10, 10000);
++	if (ret)
++		dev_err(p->dev, "%s power-on timeout: status=%08x\n", name, v);
++	return ret;
++}
++
++static int gpu_power_request_on(struct t736_gpu_power *p)
++{
++	int ret;
++
++	ret = regulator_get_voltage(p->supply);
++	if (ret < 0)
++		return ret;
++	if (ret != 900000)
++		return dev_err_probe(p->dev, -ERANGE,
++				     "DCDC5 must read back 900 mV: %d uV\n", ret);
++	/* PLL recalc returns zero unless enable/LDO/lock/output are all set. */
++	if (!clk_get_rate(p->clocks[0].clk))
++		return dev_err_probe(p->dev, -EIO, "PLL_GPU0 is not ready\n");
++	writel((readl(p->top) & ~0xf) | 8, p->top);
++	readl(p->top);
++	ret = gpu_ppu_wait_on(p, p->top, "GPU_TOP");
++	if (ret)
++		return ret;
++	/* Match Tina's CORE policy/request without generic CORE delay writes.
++	 * With PLL_GPU0 ready, real-board status reaches 8. Early DDK MMIO
++	 * hangs the CPU if this precondition has not been satisfied.
++	 */
++	writel(0, p->core + 0x20);
++	if (readl(p->core + 0x20))
++		return -EIO;
++	writel(8, p->core);
++	if (readl(p->core) != 8)
++		return -EIO;
++	return 0;
++}
++
++static int gpu_power_on(struct generic_pm_domain *domain)
++{
++	struct t736_gpu_power *p = container_of(domain, struct t736_gpu_power, genpd);
++	int ret = gpu_power_request_on(p);
++
++	return ret ? ret : gpu_ppu_wait_on(p, p->core, "GPU_CORE");
++}
++
++static void gpu_bootstrap_abort(struct t736_gpu_power *p,
++				struct reset_control *reset)
++{
++	int ret;
++
++	if (reset) {
++		ret = reset_control_assert(reset);
++		if (ret)
++			dev_err(p->dev, "GPU reset rollback failed: %d\n", ret);
++	}
++	/* No consumer exists before publication. Cancel CORE only; retain TOP
++	 * and leave the other PCK domains unchanged.
++	 */
++	writel(0, p->core);
++	readl(p->core);
++}
++
++static int t736_gpu_power_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct t736_gpu_power *p;
++	struct reset_control *reset;
++	bool bootstrap_enabled = false;
++	int ret, reset_status;
++	unsigned long rate;
++
++	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
++	if (!p)
++		return -ENOMEM;
++	p->dev = dev;
++	p->top = devm_platform_ioremap_resource_byname(pdev, "top");
++	p->core = devm_platform_ioremap_resource_byname(pdev, "core");
++	if (IS_ERR(p->top)) return PTR_ERR(p->top);
++	if (IS_ERR(p->core)) return PTR_ERR(p->core);
++	p->supply = devm_regulator_get(dev, "gpu");
++	if (IS_ERR(p->supply))
++		return dev_err_probe(dev, PTR_ERR(p->supply), "missing real DCDC5\n");
++	/* All six clocks stay enabled for this built-in provider's lifetime.
++	 * PLL_GPU0 is an independent prerequisite, not the core mux parent.
++	 */
++	p->clocks[0].id = "pll-gpu0";
++	p->clocks[1].id = "ppu";
++	p->clocks[2].id = "ahb";
++	p->clocks[3].id = "mbus";
++	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(p->clocks), p->clocks);
++	if (ret)
++		return dev_err_probe(dev, ret, "missing GPU power clocks\n");
++	p->bootstrap_clocks[0].id = "gpu-bus";
++	p->bootstrap_clocks[1].id = "gpu";
++	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(p->bootstrap_clocks), p->bootstrap_clocks);
++	if (ret)
++		return dev_err_probe(dev, ret, "missing GPU bus/core clocks\n");
++	reset = reset_control_get_exclusive(dev, "reset_bus");
++	if (IS_ERR(reset))
++		return dev_err_probe(dev, PTR_ERR(reset), "missing GPU reset\n");
++	ret = regulator_enable(p->supply);
++	if (ret)
++		goto put_reset;
++	ret = clk_bulk_prepare_enable(ARRAY_SIZE(p->clocks), p->clocks);
++	if (ret)
++		goto disable_supply;
++	gpu_ppu_delays(p->top);
++	p->genpd.name = "t736-gpu-top-core";
++	p->genpd.power_on = gpu_power_on;
++	p->genpd.flags = GENPD_FLAG_ALWAYS_ON;
++	ret = gpu_power_request_on(p);
++	if (ret)
++		goto abort;
++	ret = reset_control_deassert(reset);
++	if (ret)
++		goto abort;
++	reset_status = reset_control_status(reset);
++	if (reset_status) {
++		ret = reset_status < 0 ? reset_status : -EIO;
++		dev_err(dev, "GPU reset deassert readback failed: %d\n", reset_status);
++		goto abort;
++	}
++	ret = clk_bulk_prepare_enable(ARRAY_SIZE(p->bootstrap_clocks), p->bootstrap_clocks);
++	if (ret)
++		goto abort;
++	bootstrap_enabled = true;
++	rate = clk_get_rate(p->bootstrap_clocks[1].clk);
++	if (rate != 400000000) {
++		ret = -ERANGE;
++		dev_err(dev, "GPU bootstrap clock is not 400 MHz: %lu\n", rate);
++		goto abort;
++	}
++	/* Cold-start ACK is verified after reset and the GPU clock UPD;
++	 * the observed hardware sequence does not require an earlier ACK.
++	 */
++	ret = gpu_ppu_wait_on(p, p->core, "GPU_CORE");
++	if (ret)
++		goto abort;
++	ret = pm_genpd_init(&p->genpd, NULL, false);
++	if (ret)
++		goto abort;
++	p->domains[0] = &p->genpd;
++	p->data.domains = p->domains;
++	p->data.num_domains = ARRAY_SIZE(p->domains);
++	/* DDK takes this reset exclusively after publication. */
++	reset_control_put(reset);
++	reset = NULL;
++	ret = of_genpd_add_provider_onecell(dev->of_node, &p->data);
++	if (ret) {
++		pm_genpd_remove(&p->genpd);
++		reset = reset_control_get_exclusive(dev, "reset_bus");
++		if (IS_ERR(reset)) {
++			dev_err(dev, "cannot reacquire reset for rollback: %ld\n", PTR_ERR(reset));
++			reset = NULL;
++		}
++		goto abort;
++	}
++	dev_info(dev, "GPU_TOP/CORE ACK=8; PLL_GPU0 ready, GPU=%lu Hz, DCDC5=900000 uV, reset verified\n",
++		 rate);
++	return 0;
++abort:
++	gpu_bootstrap_abort(p, reset);
++	if (bootstrap_enabled)
++		clk_bulk_disable_unprepare(ARRAY_SIZE(p->bootstrap_clocks), p->bootstrap_clocks);
++	clk_bulk_disable_unprepare(ARRAY_SIZE(p->clocks), p->clocks);
++disable_supply:
++	regulator_disable(p->supply);
++put_reset:
++	reset_control_put(reset);
++	return dev_err_probe(dev, ret, "GPU bootstrap failed; domain not published\n");
++}
++
++static const struct of_device_id gpu_power_match[] = {
++	{ .compatible = "allwinner,t736-gpu-power" }, { }
++};
++static struct platform_driver gpu_power_driver = {
++	.probe = t736_gpu_power_probe,
++	.driver = { .name = "t736-gpu-power", .of_match_table = gpu_power_match,
++		    .suppress_bind_attrs = true },
++};
++builtin_platform_driver(gpu_power_driver);
+diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
+index b3101376029d71b0e8e2133dd28aa6660815fee0..1f88510201f7cb126f9963984908271d59e3ec3d 100644
+--- a/drivers/regulator/Makefile
++++ b/drivers/regulator/Makefile
+@@ -212,3 +212,5 @@ obj-$(CONFIG_REGULATOR_WM8400) += wm8400-regulator.o
+ obj-$(CONFIG_REGULATOR_WM8994) += wm8994-regulator.o
+ 
+ ccflags-$(CONFIG_REGULATOR_DEBUG) += -DDEBUG
++
++obj-$(CONFIG_AW_DRM) += t736-gpu-supply.o
+diff --git a/drivers/regulator/t736-gpu-supply.c b/drivers/regulator/t736-gpu-supply.c
+new file mode 100644
+index 0000000000000000000000000000000000000000..a97169781d4945c1dae277c9f0074d3d882b067f
+--- /dev/null
++++ b/drivers/regulator/t736-gpu-supply.c
+@@ -0,0 +1,332 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* Board-scoped AXP8191 DCDC5 supply. The exclusive R-TWI0 byte engine
++ * reuses the source SPL's tested transactions; it does not expose arbitrary
++ * PMIC writes or change DDR rails. Source: AXP8191 datasheet and Tina GPL
++ * axp2101-regulator.c (DCDC5: 0x16[6:0], enable 0x10[4]).
++ */
++#include <linux/delay.h>
++#include <linux/io.h>
++#include <linux/ktime.h>
++#include <linux/module.h>
++#include <linux/mutex.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/regulator/driver.h>
++#include <linux/regulator/of_regulator.h>
++#include <linux/t736-pmic.h>
++#include <linux/sysfs.h>
++#include "t736-pmic-twi.inc"
++
++struct t736_gpu_supply {
++	struct device *dev;
++	void __iomem *base;
++	struct t736_twi bus;
++	struct mutex lock;
++};
++
++/* One physical PMIC bus. Keep the owner alive throughout snapshots, and
++ * withdraw it before devres releases its mappings on device removal.
++ * Lock order is cpu_supply_owner_lock then the existing transaction mutex.
++ */
++static DEFINE_MUTEX(cpu_supply_owner_lock);
++static struct t736_gpu_supply *cpu_supply_owner;
++
++static void cpu_supply_unpublish(void *data)
++{
++	mutex_lock(&cpu_supply_owner_lock);
++	if (cpu_supply_owner == data)
++		cpu_supply_owner = NULL;
++	mutex_unlock(&cpu_supply_owner_lock);
++}
++
++static u32 pmic_read_reg(void *ctx, u32 off)
++{
++	struct t736_gpu_supply *p = ctx;
++	u32 v = readl(p->base + off);
++	udelay(1);
++	return v;
++}
++static void pmic_write_reg(void *ctx, u32 off, u32 value)
++{
++	struct t736_gpu_supply *p = ctx;
++	writel(value, p->base + off);
++}
++static u32 pmic_ticks(void *ctx)
++{
++	return (u32)ktime_to_us(ktime_get());
++}
++static int pmic_read(struct t736_gpu_supply *p, u8 reg, u8 *value)
++{
++	return t736_twi_read8(&p->bus, 0x36, reg, value) ? -EIO : 0;
++}
++
++int t736_pmic_read_cpu_supplies(struct t736_cpu_supply_snapshot *snapshot)
++{
++	struct t736_cpu_supply_snapshot values;
++	struct t736_gpu_supply *p;
++	int ret = -ENODEV;
++
++	if (!snapshot)
++		return -EINVAL;
++	mutex_lock(&cpu_supply_owner_lock);
++	p = cpu_supply_owner;
++	if (!p)
++		goto out_owner;
++	mutex_lock(&p->lock);
++	ret = pmic_read(p, 0x0e, &values.id);
++	if (!ret && values.id != 3)
++		ret = -ENODEV;
++	if (!ret)
++		ret = pmic_read(p, 0x10, &values.enable);
++	if (!ret)
++		ret = pmic_read(p, 0x14, &values.dcdc3);
++	if (!ret)
++		ret = pmic_read(p, 0x15, &values.dcdc4);
++	if (!ret)
++		ret = pmic_read(p, 0x1b, &values.phase);
++	if (!ret)
++		ret = pmic_read(p, 0x1d, &values.feedback);
++	mutex_unlock(&p->lock);
++	if (!ret)
++		*snapshot = values;
++out_owner:
++	mutex_unlock(&cpu_supply_owner_lock);
++	return ret;
++}
++EXPORT_SYMBOL_GPL(t736_pmic_read_cpu_supplies);
++
++/* Reading this attribute uses the existing R-TWI owner. It reports the PMIC
++ * programmed setpoint, not an ADC measurement. There is no probe-time read.
++ */
++static ssize_t dcdc2_snapshot_show(struct device *dev,
++		struct device_attribute *attr, char *buf)
++{
++	struct t736_gpu_supply *p;
++	u8 id = 0, enable = 0, dcdc2 = 0, phase = 0, feedback = 0;
++	unsigned int selector, uv;
++	int ret = -ENODEV;
++
++	(void)attr;
++	mutex_lock(&cpu_supply_owner_lock);
++	p = cpu_supply_owner;
++	if (!p || p->dev != dev)
++		goto out_owner;
++	mutex_lock(&p->lock);
++	ret = pmic_read(p, 0x0e, &id);
++	if (!ret && id != 3)
++		ret = -ENODEV;
++	if (!ret)
++		ret = pmic_read(p, 0x10, &enable);
++	if (!ret)
++		ret = pmic_read(p, 0x13, &dcdc2);
++	if (!ret)
++		ret = pmic_read(p, 0x1b, &phase);
++	if (!ret)
++		ret = pmic_read(p, 0x1d, &feedback);
++	mutex_unlock(&p->lock);
++out_owner:
++	mutex_unlock(&cpu_supply_owner_lock);
++	if (ret)
++		return ret;
++	selector = dcdc2 & 0x7f;
++	/* A joined DCDC2/3 rail cannot be interpreted as independent DCDC2. */
++	if (!(enable & BIT(1)) || selector > 0x57 || (phase & BIT(6))) {
++		dev_warn_ratelimited(dev,
++			"DCDC2 snapshot invalid: enable=%02x dcdc2=%02x phase=%02x feedback=%02x\n",
++			enable, dcdc2, phase, feedback);
++		return -ERANGE;
++	}
++	uv = selector <= 0x46 ? 500000 + selector * 10000 :
++		1220000 + (selector - 0x47) * 20000;
++	return sysfs_emit(buf,
++		"id=%02x enable=%02x dcdc2=%02x phase=%02x feedback=%02x dvm=%u remote_feedback=%u setpoint_uv=%u kind=programmed-setpoint\n",
++		id, enable, dcdc2, phase, feedback, !!(dcdc2 & BIT(7)),
++		!(feedback & BIT(0)), uv);
++}
++static DEVICE_ATTR_RO(dcdc2_snapshot);
++
++static struct attribute *t736_pmic_attrs[] = {
++	&dev_attr_dcdc2_snapshot.attr,
++	NULL,
++};
++ATTRIBUTE_GROUPS(t736_pmic);
++
++static int pmic_write_checked(struct t736_gpu_supply *p, u8 reg, u8 value)
++{
++	u8 check;
++	if (reg != 0x16 && reg != 0x10)
++		return -EPERM;
++	if (t736_twi_write8(&p->bus, 0x36, reg, value) ||
++	    pmic_read(p, reg, &check))
++		return -EIO;
++	return value == check ? 0 : -EIO;
++}
++
++static int gpu_supply_get_sel(struct regulator_dev *rdev)
++{
++	struct t736_gpu_supply *p = rdev_get_drvdata(rdev);
++	u8 value;
++	int ret;
++	mutex_lock(&p->lock);
++	ret = pmic_read(p, 0x16, &value);
++	mutex_unlock(&p->lock);
++	if (ret)
++		return ret;
++	return (value & 0x7f) <= 0x57 ? value & 0x7f : -ERANGE;
++}
++static int gpu_supply_enabled(struct regulator_dev *rdev)
++{
++	struct t736_gpu_supply *p = rdev_get_drvdata(rdev);
++	u8 value;
++	int ret;
++	mutex_lock(&p->lock);
++	ret = pmic_read(p, 0x10, &value);
++	mutex_unlock(&p->lock);
++	return ret ? ret : !!(value & BIT(4));
++}
++static int gpu_supply_prepare(struct t736_gpu_supply *p)
++{
++	u8 voltage, enabled, id;
++	int ret;
++	mutex_lock(&p->lock);
++	ret = pmic_read(p, 0x0e, &id);
++	if (!ret && id != 3)
++		ret = -ENODEV;
++	if (!ret)
++		ret = pmic_read(p, 0x16, &voltage);
++	if (!ret)
++		ret = pmic_read(p, 0x10, &enabled);
++	if (ret)
++		goto out;
++	/* Never lower a live rail, nor silently accept an unexpected voltage.
++	 * 400 MHz donor OPP needs 800mV; keep a live 800..960mV supply intact.
++	 */
++	if ((enabled & BIT(4)) && (voltage & 0x7f) > 46) {
++		ret = -ERANGE;
++		goto out;
++	}
++	if (!(enabled & BIT(4)) || (voltage & 0x7f) < 30) {
++		ret = pmic_write_checked(p, 0x16, (voltage & 0x80) | 30);
++		if (ret)
++			goto out;
++		usleep_range(1000, 1500);
++	}
++	if (!(enabled & BIT(4)))
++		ret = pmic_write_checked(p, 0x10, enabled | BIT(4));
++	if (!ret)
++		usleep_range(1000, 1500);
++out:
++	mutex_unlock(&p->lock);
++	return ret;
++}
++static int gpu_supply_enable(struct regulator_dev *rdev)
++{
++	return gpu_supply_prepare(rdev_get_drvdata(rdev));
++}
++static const struct linear_range gpu_voltage_ranges[] = {
++	REGULATOR_LINEAR_RANGE(500000, 0, 0x46, 10000),
++	REGULATOR_LINEAR_RANGE(1220000, 0x47, 0x57, 20000),
++};
++static const struct regulator_ops gpu_supply_ops = {
++	.list_voltage = regulator_list_voltage_linear_range,
++	.get_voltage_sel = gpu_supply_get_sel,
++	.is_enabled = gpu_supply_enabled,
++	.enable = gpu_supply_enable,
++};
++static const struct regulator_desc gpu_supply_desc = {
++	.name = "t736-axp8191-dcdc5",
++	.type = REGULATOR_VOLTAGE,
++	.owner = THIS_MODULE,
++	.ops = &gpu_supply_ops,
++	.n_voltages = 0x58,
++	.linear_ranges = gpu_voltage_ranges,
++	.n_linear_ranges = ARRAY_SIZE(gpu_voltage_ranges),
++	.enable_time = 1000,
++};
++static int gpu_supply_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct t736_gpu_supply *p;
++	struct regulator_config config = { .dev = dev, .of_node = dev->of_node };
++	struct regulator_dev *rdev;
++	const char * const checks[] = { "apbs1", "twi-gate", "pins" };
++	const u32 masks[] = { 0x0700001f, 0x10001, 0xff };
++	const u32 expected[] = { 0x04000000, 0x10001, 0x22 };
++	int i, ret;
++	u8 id;
++	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
++	if (!p)
++		return -ENOMEM;
++	p->dev = dev;
++	mutex_init(&p->lock);
++	p->base = devm_platform_ioremap_resource_byname(pdev, "twi");
++	if (IS_ERR(p->base))
++		return PTR_ERR(p->base);
++	/* These shared CCU/pinctrl resources are inspected, never modified.
++	 * The source SPL established the 24MHz bus and PL0/1 function 2.
++	 */
++	for (i = 0; i < ARRAY_SIZE(checks); i++) {
++		struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, checks[i]);
++		void __iomem *map;
++		u32 value;
++		if (!r || resource_size(r) != 4)
++			return -EINVAL;
++		map = devm_ioremap(dev, r->start, 4);
++		if (!map)
++			return -ENOMEM;
++		value = readl(map);
++		if ((value & masks[i]) != expected[i])
++			return dev_err_probe(dev, -EINVAL, "unexpected %s: %08x\n", checks[i], value);
++	}
++	p->bus = (struct t736_twi){ .ctx = p, .read = pmic_read_reg,
++		.write = pmic_write_reg, .ticks = pmic_ticks,
++		.timeout_ticks = 2000, .poll_limit = 10000 };
++	ret = t736_twi_init(&p->bus);
++	if (ret)
++		return dev_err_probe(dev, -EIO, "R-TWI0 init failed: %d\n", ret);
++	ret = pmic_read(p, 0x0e, &id);
++	if (ret || id != 3)
++		return dev_err_probe(dev, ret ? ret : -ENODEV, "AXP8191 ID mismatch\n");
++	ret = gpu_supply_prepare(p);
++	if (ret)
++		return dev_err_probe(dev, ret, "DCDC5 preparation failed\n");
++	config.driver_data = p;
++	config.init_data = of_get_regulator_init_data(dev, dev->of_node, &gpu_supply_desc);
++	if (!config.init_data)
++		return -EINVAL;
++	rdev = devm_regulator_register(dev, &gpu_supply_desc, &config);
++	if (IS_ERR(rdev))
++		return dev_err_probe(dev, PTR_ERR(rdev), "DCDC5 registration failed\n");
++	/* Registration may skip enable when already on. Validate and raise a
++	 * low live supply explicitly; all other PMIC registers remain untouched.
++	 */
++	ret = gpu_supply_enable(rdev);
++	if (ret)
++		return dev_err_probe(dev, ret, "DCDC5 voltage/enable validation failed\n");
++	ret = gpu_supply_get_sel(rdev);
++	if (ret < 0)
++		return ret;
++	dev_info(dev, "AXP8191 DCDC5 verified at %d uV, fixed GPU supply policy\n",
++		 500000 + ret * 10000);
++	ret = devm_add_action_or_reset(dev, cpu_supply_unpublish, p);
++	if (ret)
++		return ret;
++	mutex_lock(&cpu_supply_owner_lock);
++	if (cpu_supply_owner)
++		ret = -EBUSY;
++	else
++		cpu_supply_owner = p;
++	mutex_unlock(&cpu_supply_owner_lock);
++	if (ret)
++		return ret;
++	return 0;
++}
++static const struct of_device_id gpu_supply_match[] = {
++	{ .compatible = "allwinner,t736-gpu-supply" }, { }
++};
++static struct platform_driver gpu_supply_driver = {
++	.probe = gpu_supply_probe,
++	.driver = { .name = "t736-gpu-supply", .of_match_table = gpu_supply_match,
++		.suppress_bind_attrs = true, .dev_groups = t736_pmic_groups },
++};
++builtin_platform_driver(gpu_supply_driver);
+diff --git a/drivers/regulator/t736-pmic-twi.inc b/drivers/regulator/t736-pmic-twi.inc
+new file mode 100644
+index 0000000000000000000000000000000000000000..b67f4fa06b582cfbbc899ed46d4fff0f9ab51010
+--- /dev/null
++++ b/drivers/regulator/t736-pmic-twi.inc
+@@ -0,0 +1,180 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++#ifndef T736_EARLY_TWI_H
++#define T736_EARLY_TWI_H
++#include <linux/types.h>
++
++enum {
++	TWI_DATA = 0x08, TWI_CTRL = 0x0c, TWI_STATUS = 0x10,
++	TWI_CLOCK = 0x14, TWI_RESET = 0x18, TWI_EFR = 0x1c,
++	TWI_LINE = 0x20, TWI_DRV_CTRL = 0x200, TWI_PMU_CTRL = 0x314,
++	TWI_ACK = 4, TWI_IF = 8, TWI_STOP = 16, TWI_START = 32, TWI_EN = 64
++};
++enum t736_twi_error {
++	TWI_OK = 0, TWI_TIMEOUT = -1, TWI_NACK = -2,
++	TWI_ARBITRATION = -3, TWI_BUS_ERROR = -4, TWI_UNEXPECTED = -5,
++	TWI_BUSY = -6, TWI_INVALID = -7
++};
++struct t736_twi {
++	void *ctx;
++	u32 (*read)(void *ctx, u32 offset);
++	void (*write)(void *ctx, u32 offset, u32 value);
++	u32 (*ticks)(void *ctx);
++	u32 timeout_ticks, poll_limit;
++	u32 last_status;
++	int cleanup_error;
++};
++int t736_twi_init(struct t736_twi *bus);
++int t736_twi_read8(struct t736_twi *bus, u8 address, u8 reg, u8 *value);
++int t736_twi_write8(struct t736_twi *bus, u8 address, u8 reg, u8 value);
++#endif
++
++// SPDX-License-Identifier: GPL-2.0-only
++/* T736 User Manual v0.90, 18.11.10: S_TWI0 byte engine.
++ * INT_FLAG is W1C. No automatic retries: PMIC writes must be explicit.
++ */
++
++
++static int valid(const struct t736_twi *b)
++{
++	return b && b->read && b->write && b->ticks &&
++		b->timeout_ticks && b->timeout_ticks < 0x80000000u && b->poll_limit;
++}
++
++static int wait_mask(struct t736_twi *b, u32 reg, u32 mask, u32 value)
++{
++	u32 begin = b->ticks(b->ctx), count;
++	for (count = 0; count < b->poll_limit; count++) {
++		if ((b->read(b->ctx, reg) & mask) == value)
++			return TWI_OK;
++		if ((u32)(b->ticks(b->ctx) - begin) >= b->timeout_ticks)
++			break;
++	}
++	return TWI_TIMEOUT;
++}
++
++static int reset(struct t736_twi *b)
++{
++	b->write(b->ctx, TWI_RESET, 1);
++	return wait_mask(b, TWI_RESET, 1, 0);
++}
++
++static int state(struct t736_twi *b, unsigned expected)
++{
++	int rc = wait_mask(b, TWI_CTRL, TWI_IF, TWI_IF);
++	b->last_status = b->read(b->ctx, TWI_STATUS) & 0xff;
++	if (rc)
++		return rc;
++	if (b->last_status == expected)
++		return TWI_OK;
++	switch (b->last_status) {
++	case 0x20: case 0x30: case 0x48: return TWI_NACK;
++	case 0x38: return TWI_ARBITRATION;
++	case 0: return TWI_BUS_ERROR;
++	default: return TWI_UNEXPECTED;
++	}
++}
++
++static int stop(struct t736_twi *b)
++{
++	int rc;
++	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_STOP | TWI_IF);
++	rc = wait_mask(b, TWI_CTRL, TWI_STOP, 0);
++	if (rc)
++		return rc;
++	return wait_mask(b, TWI_STATUS, 0xff, 0xf8);
++}
++
++static int finish(struct t736_twi *b, int rc)
++{
++	/* After arbitration loss we no longer own the wires: never send STOP. */
++	b->cleanup_error = rc == TWI_ARBITRATION ? reset(b) : stop(b);
++	if (b->cleanup_error && rc != TWI_ARBITRATION)
++		(void)reset(b);
++	return rc ? rc : b->cleanup_error;
++}
++
++static int send(struct t736_twi *b, u8 value, unsigned expected)
++{
++	b->write(b->ctx, TWI_DATA, value);
++	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_IF);
++	return state(b, expected);
++}
++
++static int begin(struct t736_twi *b, u8 address, u8 reg)
++{
++	int rc;
++	b->cleanup_error = 0;
++	/* No attempt to clear a stuck bus by clocking the PMIC blindly. */
++	if ((b->read(b->ctx, TWI_LINE) & 0x30) != 0x30 ||
++	    (b->read(b->ctx, TWI_STATUS) & 0xff) != 0xf8)
++		return TWI_BUSY;
++	b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_START | TWI_IF);
++	rc = state(b, 0x08);
++	if (!rc)
++		rc = send(b, (u8)(address << 1), 0x18);
++	if (!rc)
++		rc = send(b, reg, 0x28);
++	return rc;
++}
++
++int t736_twi_init(struct t736_twi *b)
++{
++	int rc;
++	if (!valid(b))
++		return TWI_INVALID;
++	b->cleanup_error = 0;
++	b->last_status = 0xf8;
++	/* Refuse to take over an active hardware DVFS/packet master. */
++	if ((b->read(b->ctx, TWI_DRV_CTRL) & 0x80000001u) ||
++	    (b->read(b->ctx, TWI_PMU_CTRL) & 0xff))
++		return TWI_BUSY;
++	rc = reset(b);
++	if (rc)
++		return rc;
++	/* 24 MHz / (2^1 * (11 + 1) * 10) = 100 kHz, duty cycle 50%. */
++	b->write(b->ctx, TWI_CLOCK, (11u << 3) | 1u);
++	b->write(b->ctx, TWI_EFR, 0);
++	b->write(b->ctx, TWI_CTRL, TWI_EN);
++	return TWI_OK;
++}
++
++int t736_twi_read8(struct t736_twi *b, u8 address, u8 reg, u8 *value)
++{
++	int rc;
++	u8 received = 0;
++	if (!valid(b) || !value || address > 0x7f)
++		return TWI_INVALID;
++	rc = begin(b, address, reg);
++	if (rc == TWI_BUSY)
++		return rc;
++	if (!rc) {
++		b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_START | TWI_IF);
++		rc = state(b, 0x10);
++	}
++	if (!rc)
++		rc = send(b, (u8)((address << 1) | 1), 0x40);
++	if (!rc) {
++		/* One byte only: leave ACK clear and end with a NACK. */
++		b->write(b->ctx, TWI_CTRL, TWI_EN | TWI_IF);
++		rc = state(b, 0x58);
++	}
++	if (!rc)
++		received = (u8)b->read(b->ctx, TWI_DATA);
++	rc = finish(b, rc);
++	if (!rc)
++		*value = received;
++	return rc;
++}
++
++int t736_twi_write8(struct t736_twi *b, u8 address, u8 reg, u8 value)
++{
++	int rc;
++	if (!valid(b) || address > 0x7f)
++		return TWI_INVALID;
++	rc = begin(b, address, reg);
++	if (rc == TWI_BUSY)
++		return rc;
++	if (!rc)
++		rc = send(b, value, 0x28);
++	return finish(b, rc);
++}
