+; Fixed T736 board LPDDR4x: 8 GiB, geometry observed on source-v1/v2.
+; Based on the Tina demo_aiot-bak 32-word seed; user requested fixed memory.
+; tpr13 bit0 bypasses auto_scan_dram_config; para2 bit31 uses encoded MiB.
+; Necessary PHY training remains enabled. See evidence/source-v3-fixed-lp4-review-20261114.json.
+[dram_para]
+dram_clk = 1800
+dram_type = 8
+dram_dx_odt = 0x8080808
+dram_dx_dri = 0xe0e0e0e
+dram_ca_dri = 0x88030e0e
+dram_para0 = 0x0
+dram_para1 = 0x311a
+dram_para2 = 0xa0001001
+dram_mr0 = 0x0
+dram_mr1 = 0x8c
+dram_mr2 = 0x0
+dram_mr3 = 0x33
+dram_mr4 = 0x0
+dram_mr5 = 0x0
+dram_mr6 = 0x0
+dram_mr11 = 0x4
+dram_mr12 = 0x72
+dram_mr13 = 0x8
+dram_mr14 = 0x1d
+dram_mr16 = 0x0
+dram_mr17 = 0x0
+dram_mr22 = 0x24
+dram_tpr0 = 0x0
