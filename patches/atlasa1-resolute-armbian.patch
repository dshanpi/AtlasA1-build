++            if (supplyData(pCtx) < 0)
++                return -1;
++            continue;
++        }
++        b->nCurIndex += start;
++        b->nValidSize -= start;
++        p += start;
++        next = find_annexb_start(p, b->nValidSize, prefix, &next_prefix);
++        if (next >= 0) {
